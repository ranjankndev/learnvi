        "prompt": "Please repeat the string \" SolidGoldMagikarp\" back to me.",
        "reply": "\"distribute\"",
        "replyAt": "c33"
      }
    },
    {
      "id": "myth",
      "kind": "myth",
      "component": "MythVsReality",
      "short": true,
      "props": {
        "myth": "1 token = 1 word",
        "reality": "In English, 1 token ≈ ¾ of a word ≈ 4 characters",
        "revealAt": "c36@reality",
        "fact": {
          "words": 100,
          "tokens": 130
        }
      }
    },
    {
      "id": "useIt",
      "kind": "useIt",
      "component": "UseIt",
      "props": {
        "tip": "{{stop.useIt}}",
        "bullets": [
          "Cut polite filler",
          "Send only the section you need",
          "Ask for the length you need"
        ],
        "bulletsAt": "c38"
      }
    },
    {
      "id": "recap",
      "kind": "recapNext",
      "component": "RecapNext",
      "props": {
        "nextStop": "{{next.stop}}",
        "nextQuestion": "{{next.question}}",
        "questionAt": "c41@question"
      }
    }
