    {
      "id": "demo",
      "kind": "core",
      "component": "TokenBlocks",
      "short": true,
      "props": {
        "examples": [
          {
            "text": "{{series.runningPrompt}}",
            "tokens": [
              "Write",
              " a",
              " short",
              " poem",
              " about",
              " the",
              " rain"
            ]
          },
          {
            "text": "tokenization",
            "tokens": [
              "token",
              "ization"
            ]
          },
          {
            "text": "strawberry",
            "tokens": [
              "str",
              "aw",
              "berry"
            ]
          }
        ],
        "promptAt": "c21@prompt",
        "longWordAt": "c22@long",
        "strawberryAt": "c23@straw"
      }
    },
    {
      "id": "matters",
      "kind": "core",
      "component": "WhyItMatters",
      "props": {
        "cards": [
          {
            "title": "Price",
            "text": "You pay per token, for what you send and what you get back",
            "icon": "coin",
            "at": "c25"
          },
          {
            "title": "Memory",
            "text": "The context window is counted in tokens",
            "icon": "window",
            "at": "c26"
          },
          {
            "title": "Languages",
            "text": "Hindi can take several times more tokens than English",
            "icon": "globe",
            "at": "c27"
          },
          {
            "title": "Spelling",
            "text": "It sees “straw” + “berry”, not the letters",
            "icon": "letters",
            "at": "c28"
          }
        ]
      }
    },
    {
      "id": "tryIt",
      "kind": "tryIt",
      "component": "TryIt",
      "short": true,
      "props": {
        "task": "{{stop.tryIt}}",
        "steps": [
          {
            "text": "Ask a chatbot: how many r's are in “strawberry”?",
            "at": "c30"
          },
          {
            "text": "Paste one sentence into a tokenizer, in English, then in Hindi. Compare the counts.",
            "at": "c31"
          }
        ],
        "chat": "How many r's are in strawberry?"
      }
    },
    {
      "id": "blooper",
      "kind": "blooper",
      "component": "Blooper",
      "props": {
        "token": " SolidGoldMagikarp",
