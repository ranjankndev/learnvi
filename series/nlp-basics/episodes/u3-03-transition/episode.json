      "component": "Definition",
      "title": "What is a transition parser?",
      "props": {
        "kicker": "Definition",
        "term": "Transition parser",
        "definition": "Reads words from a buffer, keeps unfinished words on a stack, and picks one move at each step.",
        "example": "stack: [ROOT, ate]  ·  buffer: [pizza]",
        "analogy": "Sorting post: an in-tray of new letters, and a pile on your desk still being dealt with."
      }
    },
    {
      "id": "moves",
      "kind": "core",
      "component": "Table",
      "title": "The four moves",
      "props": {
        "kicker": "Arc-eager",
        "title": "The four moves of arc-eager parsing",
        "columns": [
          "Move",
          "What it does"
        ],
        "rows": [
          [
            "SHIFT",
            "push the next word onto the stack"
          ],
          [
            "LEFT-ARC",
            "next word heads the top word; pop it"
          ],
          [
            "RIGHT-ARC",
            "top word heads the next word; push it"
          ],
          [
            "REDUCE",
            "pop the top word: it's finished"
          ]
        ]
      }
    },
