        "steps": [
          {
            "label": "Vectors in",
            "detail": "from Vector Valley"
          },
          {
            "label": "Attention",
            "detail": "words look at each other"
          },
          {
            "label": "Feed-forward",
            "detail": "each word thinks on its own"
          },
          {
            "label": "Repeat",
            "detail": "dozens of layers deep"
          }
        ]
      }
    },
    {
      "id": "context",
      "kind": "core",
      "component": "Definition",
      "title": "The context window",
      "props": {
        "kicker": "How far it can see",
        "term": "Context window",
        "definition": "The most tokens the model can look at in one go: your prompt, the chat so far, and its own answer.",
        "example": "Early chatbots: a few thousand tokens. Today: often hundreds of thousands.",
        "analogy": "A desk: only what fits on the desk can be read at once."
      }
    },
    {
