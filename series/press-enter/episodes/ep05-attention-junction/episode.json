    {
      "id": "how",
      "kind": "core",
      "component": "Steps",
      "title": "How attention works",
      "props": {
        "kicker": "Under the hood, gently",
        "title": "Four small steps, for every word",
        "steps": [
          {
            "label": "Ask",
            "detail": "query: what am I looking for?",
            "at": "c22"
          },
          {
            "label": "Match",
            "detail": "key: compare with every word's label",
            "at": "c23"
          },
          {
            "label": "Weigh",
            "detail": "turn the matches into percentages",
            "at": "c24"
          },
          {
            "label": "Blend",
            "detail": "value: mix in their meanings",
            "at": "c25"
          }
        ]
      }
    },
    {
      "id": "heads",
      "kind": "core",
      "component": "Bullets",
      "title": "Many heads at once",
      "props": {
        "kicker": "Attention heads",
        "title": "Many heads look at the same sentence at once",
        "items": [
          {
            "text": "One head may follow grammar: who did what"
          },
          {
            "text": "Another may link “it” to the thing it refers to"
          },
          {
            "text": "Another may just watch the neighbouring words"
          }
        ]
      }
    },
    {
      "id": "transformer",
      "kind": "core",
      "component": "Steps",
      "title": "A transformer",
      "props": {
        "kicker": "The transformer",
