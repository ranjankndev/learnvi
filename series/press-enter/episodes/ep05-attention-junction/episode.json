    {
      "id": "attention",
      "kind": "core",
      "component": "Definition",
      "title": "What attention is",
      "props": {
        "kicker": "The big idea",
        "term": "Attention",
        "definition": "Each word looks at every other word in the prompt, decides how much each one matters to it, and blends in their meaning.",
        "example": "“bank” + a lot of “river” = riverbank",
        "analogy": "At a busy junction, every traveller listens only for the announcements that matter to them."
      }
    },
