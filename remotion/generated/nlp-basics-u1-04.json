{"key":"nlp-basics-u1-04","seriesId":"nlp-basics","episode":"u1-04","title":"Language Models: Guessing the Next Word","fps":30,"duration":230.456,"durationInFrames":6914,"video":{"width":1920,"height":1080,"burnCaptions":true,"brand":"learnvi.in"},"badge":["UNIT 1 · LESSON 4","LANGUAGE MODELS"],"series":{"title":"NLP, Simply Explained","subtitle":"University NLP, one idea at a time, no heavy maths","runningPrompt":"","stops":[{"id":"u1-01","number":1,"name":"The Stages of NLP: From Letters to Meaning","stamp":"THE STAGES OF NLP: FROM LETTERS TO MEANING","topic":""},{"id":"u1-02","number":2,"name":"Tokenization: How Text Becomes Pieces","stamp":"TOKENIZATION: HOW TEXT BECOMES PIECES","topic":""},{"id":"u1-03","number":3,"name":"Text Classification: Teaching Computers to Sort Text","stamp":"TEXT CLASSIFICATION: TEACHING COMPUTERS TO SORT TEXT","topic":""},{"id":"u1-04","number":4,"name":"Language Models: Guessing the Next Word","stamp":"LANGUAGE MODELS: GUESSING THE NEXT WORD","topic":""},{"id":"u2-01","number":5,"name":"Morphology: The Building Blocks Inside Words","stamp":"MORPHOLOGY: THE BUILDING BLOCKS INSIDE WORDS","topic":""},{"id":"u2-02","number":6,"name":"Part-of-Speech Tagging: Is It a Noun or a Verb?","stamp":"PART-OF-SPEECH TAGGING: IS IT A NOUN OR A VERB?","topic":""},{"id":"u2-03","number":7,"name":"Chunking: Grouping Words into Phrases","stamp":"CHUNKING: GROUPING WORDS INTO PHRASES","topic":""},{"id":"u2-04","number":8,"name":"Generative vs Discriminative Models","stamp":"GENERATIVE VS DISCRIMINATIVE MODELS","topic":""},{"id":"u2-05","number":9,"name":"Hidden Markov Models, Intuitively","stamp":"HIDDEN MARKOV MODELS, INTUITIVELY","topic":""},{"id":"u2-06","number":10,"name":"Conditional Random Fields, Intuitively","stamp":"CONDITIONAL RANDOM FIELDS, INTUITIVELY","topic":""},{"id":"u3-01","number":11,"name":"Constituency Parsing: Sentences as Trees","stamp":"CONSTITUENCY PARSING: SENTENCES AS TREES","topic":""},{"id":"u3-02","number":12,"name":"Dependency Parsing: Who Did What to Whom","stamp":"DEPENDENCY PARSING: WHO DID WHAT TO WHOM","topic":""},{"id":"u3-03","number":13,"name":"Transition-Based Parsing: Building Trees Step by Step","stamp":"TRANSITION-BASED PARSING: BUILDING TREES STEP BY STEP","topic":""},{"id":"u4-01","number":14,"name":"Word Vectors: Giving Words a Place on a Map","stamp":"WORD VECTORS: GIVING WORDS A PLACE ON A MAP","topic":""},{"id":"u4-02","number":15,"name":"Word2Vec: Learning Word Vectors from Context","stamp":"WORD2VEC: LEARNING WORD VECTORS FROM CONTEXT","topic":""},{"id":"u4-03","number":16,"name":"Recurrent Neural Networks: Reading with Memory","stamp":"RECURRENT NEURAL NETWORKS: READING WITH MEMORY","topic":""},{"id":"u4-04","number":17,"name":"LSTMs: Remembering What Matters","stamp":"LSTMS: REMEMBERING WHAT MATTERS","topic":""},{"id":"u5-01","number":18,"name":"Contextual Embeddings and ELMo","stamp":"CONTEXTUAL EMBEDDINGS AND ELMO","topic":""},{"id":"u5-02","number":19,"name":"BERT: Reading in Both Directions","stamp":"BERT: READING IN BOTH DIRECTIONS","topic":""}]},"stop":{"number":4,"name":"Language Models: Guessing the Next Word","stamp":"LANGUAGE MODELS: GUESSING THE NEXT WORD"},"shorts":{"width":1080,"height":1920,"maxSeconds":60,"cta":"Full lesson: NLP, Simply Explained · Unit 1"},"thumbnail":{"headline":"How AI guesses your next word","big":"a cup of …"},"segments":[{"id":"intro","kind":"intro","component":"TitleCard","short":false,"cues":[{"id":"c01","start":0.6,"end":6.645,"marks":{},"text":"Welcome back to NLP, Simply Explained. This is unit 1, lesson 4: language models.","words":[{"w":"Welcome","start":0.6},{"w":"back","start":1.08},{"w":"to","start":1.427},{"w":"NLP,","start":1.773},{"w":"Simply","start":2.12},{"w":"Explained.","start":2.72},{"w":"This","start":3.48},{"w":"is","start":3.8},{"w":"unit","start":3.96},{"w":"1,","start":4.333},{"w":"lesson","start":4.707},{"w":"4:","start":5.08},{"w":"language","start":5.48},{"w":"models.","start":6.04}]},{"id":"c02","start":7.045,"end":14.27,"marks":{},"text":"Every time your phone suggests the next word, a language model is at work. Today we'll see how the simplest ones do it.","words":[{"w":"Every","start":7.045},{"w":"time","start":7.365},{"w":"your","start":7.605},{"w":"phone","start":7.805},{"w":"suggests","start":8.165},{"w":"the","start":8.725},{"w":"next","start":8.885},{"w":"word,","start":9.285},{"w":"a","start":9.605},{"w":"language","start":9.805},{"w":"model","start":10.365},{"w":"is","start":10.805},{"w":"at","start":10.965},{"w":"work.","start":11.205},{"w":"Today","start":11.705},{"w":"we'll","start":12.205},{"w":"see","start":12.485},{"w":"how","start":12.725},{"w":"the","start":12.845},{"w":"simplest","start":13.045},{"w":"ones","start":13.605},{"w":"do","start":13.885},{"w":"it.","start":14.085}]}],"title":"Welcome","shortTitle":"Welcome","props":{"kicker":"Unit 1 · Lesson 4","title":"Language Models","subtitle":"Guessing the next word"},"start":0.6,"end":14.27,"startFrame":0,"durationInFrames":456},{"id":"idea","kind":"core","component":"BigIdea","short":false,"cues":[{"id":"c03","start":15.2,"end":21.016,"marks":{},"text":"Here's the idea in one line. A language model is a very well-read guesser of the next word.","words":[{"w":"Here's","start":15.2},{"w":"the","start":15.56},{"w":"idea","start":15.72},{"w":"in","start":16.2},{"w":"one","start":16.4},{"w":"line.","start":16.68},{"w":"A","start":17.2},{"w":"language","start":17.44},{"w":"model","start":18},{"w":"is","start":18.48},{"w":"a","start":18.64},{"w":"very","start":18.76},{"w":"well-read","start":19.2},{"w":"guesser","start":19.64},{"w":"of","start":20.12},{"w":"the","start":20.24},{"w":"next","start":20.36},{"w":"word.","start":20.72}]}],"title":"The big idea","shortTitle":"The big idea","props":{"kicker":"Key idea","text":"A language model is a well-read guesser of the next word.","highlight":["next word."]},"start":15.2,"end":21.016,"startFrame":456,"durationInFrames":202},{"id":"lm","kind":"core","component":"Definition","short":false,"cues":[{"id":"c04","start":21.933,"end":30.273,"marks":{},"text":"A language model gives a chance, a probability, to every word that could come next. That lets it tell likely sentences from unlikely ones.","words":[{"w":"A","start":21.933},{"w":"language","start":22.093},{"w":"model","start":22.573},{"w":"gives","start":23.013},{"w":"a","start":23.253},{"w":"chance,","start":23.413},{"w":"a","start":23.933},{"w":"probability,","start":24.133},{"w":"to","start":25.013},{"w":"every","start":25.253},{"w":"word","start":25.533},{"w":"that","start":25.813},{"w":"could","start":26.013},{"w":"come","start":26.253},{"w":"next.","start":26.493},{"w":"That","start":27.053},{"w":"lets","start":27.333},{"w":"it","start":27.653},{"w":"tell","start":27.813},{"w":"likely","start":28.053},{"w":"sentences","start":28.413},{"w":"from","start":29.093},{"w":"unlikely","start":29.293},{"w":"ones.","start":29.853}]},{"id":"c05","start":30.673,"end":36.261,"marks":{},"text":"After \"I'd like a cup of\", the word tea is very likely. The word carpet is very unlikely.","words":[{"w":"After","start":30.673},{"w":"\"I'd","start":31.013},{"w":"like","start":31.353},{"w":"a","start":31.513},{"w":"cup","start":31.633},{"w":"of\",","start":31.873},{"w":"the","start":32.113},{"w":"word","start":32.313},{"w":"tea","start":32.673},{"w":"is","start":32.913},{"w":"very","start":33.153},{"w":"likely.","start":33.473},{"w":"The","start":33.993},{"w":"word","start":34.233},{"w":"carpet","start":34.593},{"w":"is","start":35.073},{"w":"very","start":35.273},{"w":"unlikely.","start":35.553}]},{"id":"c06","start":36.661,"end":41.483,"marks":{},"text":"You use one every day: your phone's keyboard, offering the next word as you type.","words":[{"w":"You","start":36.661},{"w":"use","start":36.861},{"w":"one","start":37.181},{"w":"every","start":37.461},{"w":"day:","start":37.781},{"w":"your","start":38.221},{"w":"phone's","start":38.421},{"w":"keyboard,","start":38.941},{"w":"offering","start":39.581},{"w":"the","start":40.021},{"w":"next","start":40.141},{"w":"word","start":40.501},{"w":"as","start":40.701},{"w":"you","start":40.901},{"w":"type.","start":41.061}]}],"title":"What is a language model?","shortTitle":"What is a language model?","props":{"kicker":"Definition","term":"Language model","definition":"A model that gives a chance to every possible next word, so it can tell likely sentences from unlikely ones.","example":"a cup of … → tea ✓  carpet ✗","analogy":"Your phone's keyboard, suggesting what you'll type next."},"start":21.933,"end":41.483,"startFrame":658,"durationInFrames":614},{"id":"count","kind":"core","component":"Steps","short":false,"cues":[{"id":"c07","start":42.4,"end":47.079,"marks":{},"text":"The classic way to build one is called an n-gram model, and it learns by counting.","words":[{"w":"The","start":42.4},{"w":"classic","start":42.48},{"w":"way","start":43},{"w":"to","start":43.16},{"w":"build","start":43.32},{"w":"one","start":43.6},{"w":"is","start":43.8},{"w":"called","start":44},{"w":"an","start":44.24},{"w":"n-gram","start":44.4},{"w":"model,","start":44.96},{"w":"and","start":45.44},{"w":"it","start":45.64},{"w":"learns","start":45.8},{"w":"by","start":46.28},{"w":"counting.","start":46.52}]},{"id":"c08","start":47.479,"end":49.949,"marks":{},"text":"Read: start with a large amount of text.","words":[{"w":"Read:","start":47.479},{"w":"start","start":47.959},{"w":"with","start":48.399},{"w":"a","start":48.519},{"w":"large","start":48.679},{"w":"amount","start":48.919},{"w":"of","start":49.319},{"w":"text.","start":49.479}]},{"id":"c09","start":50.349,"end":54.012,"marks":{},"text":"Count: for every short run of words, count which word comes next.","words":[{"w":"Count:","start":50.349},{"w":"for","start":50.749},{"w":"every","start":50.909},{"w":"short","start":51.229},{"w":"run","start":51.549},{"w":"of","start":51.749},{"w":"words,","start":51.949},{"w":"count","start":52.389},{"w":"which","start":52.669},{"w":"word","start":52.909},{"w":"comes","start":53.229},{"w":"next.","start":53.589}]},{"id":"c10","start":54.412,"end":61.615,"marks":{},"text":"Divide: turn those counts into chances. If a word followed sixty times out of a hundred, its chance is sixty percent.","words":[{"w":"Divide:","start":54.412},{"w":"turn","start":55.092},{"w":"those","start":55.412},{"w":"counts","start":55.692},{"w":"into","start":56.052},{"w":"chances.","start":56.332},{"w":"If","start":57.052},{"w":"a","start":57.252},{"w":"word","start":57.452},{"w":"followed","start":57.772},{"w":"sixty","start":58.172},{"w":"times","start":58.612},{"w":"out","start":58.932},{"w":"of","start":59.012},{"w":"a","start":59.132},{"w":"hundred,","start":59.292},{"w":"its","start":59.692},{"w":"chance","start":60.012},{"w":"is","start":60.412},{"w":"sixty","start":60.612},{"w":"percent.","start":61.114}]},{"id":"c11","start":62.015,"end":65.903,"marks":{},"text":"Predict: to continue a sentence, pick one of the likely next words.","words":[{"w":"Predict:","start":62.015},{"w":"to","start":62.535},{"w":"continue","start":62.735},{"w":"a","start":63.215},{"w":"sentence,","start":63.335},{"w":"pick","start":63.935},{"w":"one","start":64.255},{"w":"of","start":64.415},{"w":"the","start":64.535},{"w":"likely","start":64.655},{"w":"next","start":65.055},{"w":"words.","start":65.495}]}],"title":"Learning by counting","shortTitle":"Learning by counting","props":{"kicker":"N-gram models","title":"The simplest language model: count","steps":[{"label":"Read","detail":"lots of text"},{"label":"Count","detail":"which words follow which"},{"label":"Divide","detail":"turn counts into chances"},{"label":"Predict","detail":"pick a likely next word"}]},"start":42.4,"end":65.903,"startFrame":1272,"durationInFrames":733},{"id":"cupof","kind":"core","component":"Table","short":true,"cues":[{"id":"c12","start":66.833,"end":73.445,"marks":{},"text":"Here's a made-up example. In our text, the phrase \"a cup of\" appears one hundred times. Here's what came next.","words":[{"w":"Here's","start":66.833},{"w":"a","start":67.153},{"w":"made-up","start":67.473},{"w":"example.","start":67.793},{"w":"In","start":68.433},{"w":"our","start":68.633},{"w":"text,","start":68.793},{"w":"the","start":69.273},{"w":"phrase","start":69.473},{"w":"\"a","start":69.913},{"w":"cup","start":70.073},{"w":"of\"","start":70.313},{"w":"appears","start":70.473},{"w":"one","start":70.913},{"w":"hundred","start":71.113},{"w":"times.","start":71.513},{"w":"Here's","start":72.033},{"w":"what","start":72.553},{"w":"came","start":72.753},{"w":"next.","start":72.993}]},{"id":"c13","start":73.845,"end":77.331,"marks":{},"text":"Tea followed sixty times, so its chance is sixty percent.","words":[{"w":"Tea","start":73.845},{"w":"followed","start":74.085},{"w":"sixty","start":74.565},{"w":"times,","start":75.045},{"w":"so","start":75.445},{"w":"its","start":75.605},{"w":"chance","start":75.885},{"w":"is","start":76.205},{"w":"sixty","start":76.405},{"w":"percent.","start":76.868}]},{"id":"c14","start":77.731,"end":80.11,"marks":{},"text":"Coffee, thirty times: thirty percent.","words":[{"w":"Coffee,","start":77.731},{"w":"thirty","start":78.211},{"w":"times:","start":78.611},{"w":"thirty","start":79.091},{"w":"percent.","start":79.6}]},{"id":"c15","start":80.51,"end":81.902,"marks":{},"text":"Water, nine times.","words":[{"w":"Water,","start":80.51},{"w":"nine","start":80.95},{"w":"times.","start":81.39}]},{"id":"c16","start":82.302,"end":86.226,"marks":{},"text":"And carpet just once, perhaps in a strange story. One percent.","words":[{"w":"And","start":82.302},{"w":"carpet","start":82.462},{"w":"just","start":82.942},{"w":"once,","start":83.142},{"w":"perhaps","start":83.542},{"w":"in","start":83.902},{"w":"a","start":84.062},{"w":"strange","start":84.182},{"w":"story.","start":84.622},{"w":"One","start":85.262},{"w":"percent.","start":85.744}]}],"title":"After “a cup of”","shortTitle":"How your phone guesses the next word","props":{"kicker":"Example counts","title":"What came after “a cup of” (100 times)","columns":["Next word","Seen","Chance"],"rows":[["tea","60","60%"],["coffee","30","30%"],["water","9","9%"],["carpet","1","1%"]],"highlight":[{"row":0}]},"start":66.833,"end":86.226,"startFrame":2005,"durationInFrames":609},{"id":"memory","kind":"core","component":"Compare","short":false,"cues":[{"id":"c17","start":87.133,"end":90.06,"marks":{},"text":"How far back should the model look? That's the key choice.","words":[{"w":"How","start":87.133},{"w":"far","start":87.333},{"w":"back","start":87.613},{"w":"should","start":87.853},{"w":"the","start":88.013},{"w":"model","start":88.133},{"w":"look?","start":88.533},{"w":"That's","start":88.773},{"w":"the","start":89.093},{"w":"key","start":89.253},{"w":"choice.","start":89.533}]},{"id":"c18","start":90.46,"end":98.617,"marks":{},"text":"With a short memory, say the last one or two words, the model is fast and simple. But after just \"of\", almost anything could come next.","words":[{"w":"With","start":90.46},{"w":"a","start":90.62},{"w":"short","start":90.74},{"w":"memory,","start":91.06},{"w":"say","start":91.58},{"w":"the","start":91.82},{"w":"last","start":91.98},{"w":"one","start":92.18},{"w":"or","start":92.38},{"w":"two","start":92.54},{"w":"words,","start":92.78},{"w":"the","start":93.14},{"w":"model","start":93.3},{"w":"is","start":93.7},{"w":"fast","start":93.98},{"w":"and","start":94.38},{"w":"simple.","start":94.62},{"w":"But","start":95.26},{"w":"after","start":95.58},{"w":"just","start":95.98},{"w":"\"of\",","start":96.34},{"w":"almost","start":96.78},{"w":"anything","start":97.26},{"w":"could","start":97.7},{"w":"come","start":97.94},{"w":"next.","start":98.18}]},{"id":"c19","start":99.017,"end":112.212,"marks":{},"text":"With a longer memory, say three or four words, the guesses get much better. But most long word sequences are rare, so you need enormous amounts of text to count them. More context helps, until the data runs out.","words":[{"w":"With","start":99.017},{"w":"a","start":99.177},{"w":"longer","start":99.297},{"w":"memory,","start":99.737},{"w":"say","start":100.257},{"w":"three","start":100.537},{"w":"or","start":100.817},{"w":"four","start":101.017},{"w":"words,","start":101.337},{"w":"the","start":101.697},{"w":"guesses","start":101.897},{"w":"get","start":102.377},{"w":"much","start":102.657},{"w":"better.","start":102.937},{"w":"But","start":103.417},{"w":"most","start":103.697},{"w":"long","start":104.057},{"w":"word","start":104.377},{"w":"sequences","start":104.617},{"w":"are","start":105.337},{"w":"rare,","start":105.537},{"w":"so","start":105.937},{"w":"you","start":106.137},{"w":"need","start":106.337},{"w":"enormous","start":106.617},{"w":"amounts","start":107.217},{"w":"of","start":107.657},{"w":"text","start":107.777},{"w":"to","start":108.177},{"w":"count","start":108.337},{"w":"them.","start":108.697},{"w":"More","start":109.217},{"w":"context","start":109.537},{"w":"helps,","start":110.137},{"w":"until","start":110.697},{"w":"the","start":110.977},{"w":"data","start":111.177},{"w":"runs","start":111.577},{"w":"out.","start":111.977}]}],"title":"How much context?","shortTitle":"How much context?","props":{"kicker":"The trade-off","title":"How many words should it look back?","columns":[{"title":"Short memory","items":["looks at 1 or 2 words","fast and simple","“of …” could be anything"],"tone":"neutral"},{"title":"Longer memory","items":["looks at 3 or 4 words","much better guesses","needs far more text"],"tone":"neutral"}],"verdict":{"text":"More context helps, until the data runs out"}},"start":87.133,"end":112.212,"startFrame":2614,"durationInFrames":780},{"id":"zero","kind":"core","component":"Bullets","short":false,"cues":[{"id":"c20","start":113.133,"end":119.783,"marks":{},"text":"There's a catch. Language is so varied that many perfectly good sentences never appear in the training text.","words":[{"w":"There's","start":113.133},{"w":"a","start":113.413},{"w":"catch.","start":113.573},{"w":"Language","start":114.173},{"w":"is","start":114.853},{"w":"so","start":115.053},{"w":"varied","start":115.293},{"w":"that","start":115.773},{"w":"many","start":116.013},{"w":"perfectly","start":116.293},{"w":"good","start":116.893},{"w":"sentences","start":117.133},{"w":"never","start":117.933},{"w":"appear","start":118.293},{"w":"in","start":118.573},{"w":"the","start":118.733},{"w":"training","start":118.893},{"w":"text.","start":119.293}]},{"id":"c21","start":120.183,"end":125.239,"marks":{},"text":"If a phrase was never seen, its count is zero, so the model gives it zero chance.","words":[{"w":"If","start":120.183},{"w":"a","start":120.303},{"w":"phrase","start":120.423},{"w":"was","start":120.823},{"w":"never","start":121.023},{"w":"seen,","start":121.303},{"w":"its","start":121.703},{"w":"count","start":122.063},{"w":"is","start":122.41},{"w":"zero,","start":122.756},{"w":"so","start":123.103},{"w":"the","start":123.303},{"w":"model","start":123.463},{"w":"gives","start":123.823},{"w":"it","start":124.13},{"w":"zero","start":124.436},{"w":"chance.","start":124.743}]},{"id":"c22","start":125.639,"end":130.206,"marks":{},"text":"But never seen doesn't mean impossible. New sentences are written every day.","words":[{"w":"But","start":125.639},{"w":"never","start":125.799},{"w":"seen","start":126.079},{"w":"doesn't","start":126.399},{"w":"mean","start":126.799},{"w":"impossible.","start":127.039},{"w":"New","start":127.959},{"w":"sentences","start":128.279},{"w":"are","start":128.959},{"w":"written","start":129.159},{"w":"every","start":129.599},{"w":"day.","start":129.959}]},{"id":"c23","start":130.606,"end":141.617,"marks":{},"text":"The fix is called smoothing: take a little probability from common phrases and share it out, so unseen ones get a small chance too. Think of it as saving a little room for surprises.","words":[{"w":"The","start":130.606},{"w":"fix","start":130.766},{"w":"is","start":131.166},{"w":"called","start":131.326},{"w":"smoothing:","start":131.646},{"w":"take","start":132.406},{"w":"a","start":132.686},{"w":"little","start":132.806},{"w":"probability","start":133.006},{"w":"from","start":133.726},{"w":"common","start":133.966},{"w":"phrases","start":134.326},{"w":"and","start":134.926},{"w":"share","start":135.086},{"w":"it","start":135.406},{"w":"out,","start":135.606},{"w":"so","start":135.886},{"w":"unseen","start":136.166},{"w":"ones","start":136.806},{"w":"get","start":137.126},{"w":"a","start":137.326},{"w":"small","start":137.446},{"w":"chance","start":137.726},{"w":"too.","start":138.206},{"w":"Think","start":138.686},{"w":"of","start":139.086},{"w":"it","start":139.246},{"w":"as","start":139.366},{"w":"saving","start":139.566},{"w":"a","start":139.966},{"w":"little","start":140.086},{"w":"room","start":140.326},{"w":"for","start":140.606},{"w":"surprises.","start":140.846}]}],"title":"Never seen it before","shortTitle":"Never seen it before","props":{"kicker":"A catch","title":"What if a phrase was never seen?","items":[{"text":"Its count is zero, so its chance is zero"},{"text":"But never seen doesn't mean impossible"},{"text":"Smoothing gives unseen phrases a small share"}],"numbered":false},"start":113.133,"end":141.617,"startFrame":3394,"durationInFrames":882},{"id":"perplexity","kind":"core","component":"Definition","short":false,"cues":[{"id":"c24","start":142.533,"end":152.887,"marks":{},"text":"How do we measure a language model? The standard score is called perplexity. It tells us how surprised the model is by real text it hasn't seen before. Lower is better.","words":[{"w":"How","start":142.533},{"w":"do","start":142.693},{"w":"we","start":142.813},{"w":"measure","start":142.973},{"w":"a","start":143.293},{"w":"language","start":143.413},{"w":"model?","start":143.813},{"w":"The","start":144.293},{"w":"standard","start":144.533},{"w":"score","start":145.013},{"w":"is","start":145.493},{"w":"called","start":145.653},{"w":"perplexity.","start":146.013},{"w":"It","start":146.853},{"w":"tells","start":147.093},{"w":"us","start":147.413},{"w":"how","start":147.613},{"w":"surprised","start":147.813},{"w":"the","start":148.373},{"w":"model","start":148.533},{"w":"is","start":148.933},{"w":"by","start":149.133},{"w":"real","start":149.333},{"w":"text","start":149.653},{"w":"it","start":150.093},{"w":"hasn't","start":150.253},{"w":"seen","start":150.613},{"w":"before.","start":150.933},{"w":"Lower","start":151.653},{"w":"is","start":152.253},{"w":"better.","start":152.453}]},{"id":"c25","start":153.287,"end":161.793,"marks":{},"text":"A perplexity of fifty means that, on average, the model is as unsure as if it were choosing between fifty equally likely words each time.","words":[{"w":"A","start":153.287},{"w":"perplexity","start":153.367},{"w":"of","start":154.007},{"w":"fifty","start":154.127},{"w":"means","start":154.527},{"w":"that,","start":154.967},{"w":"on","start":155.327},{"w":"average,","start":155.527},{"w":"the","start":156.207},{"w":"model","start":156.487},{"w":"is","start":156.887},{"w":"as","start":157.047},{"w":"unsure","start":157.287},{"w":"as","start":157.767},{"w":"if","start":157.967},{"w":"it","start":158.087},{"w":"were","start":158.247},{"w":"choosing","start":158.367},{"w":"between","start":158.807},{"w":"fifty","start":159.167},{"w":"equally","start":159.687},{"w":"likely","start":160.247},{"w":"words","start":160.687},{"w":"each","start":161.127},{"w":"time.","start":161.487}]},{"id":"c26","start":162.193,"end":170.197,"marks":{},"text":"Think of a quiz contestant. One who can narrow every answer down to two options will do far better than one torn between fifty.","words":[{"w":"Think","start":162.193},{"w":"of","start":162.473},{"w":"a","start":162.713},{"w":"quiz","start":162.953},{"w":"contestant.","start":163.193},{"w":"One","start":164.113},{"w":"who","start":164.433},{"w":"can","start":164.633},{"w":"narrow","start":164.913},{"w":"every","start":165.353},{"w":"answer","start":165.633},{"w":"down","start":166.113},{"w":"to","start":166.313},{"w":"two","start":166.513},{"w":"options","start":166.713},{"w":"will","start":167.473},{"w":"do","start":167.673},{"w":"far","start":167.873},{"w":"better","start":168.193},{"w":"than","start":168.513},{"w":"one","start":168.713},{"w":"torn","start":168.953},{"w":"between","start":169.313},{"w":"fifty.","start":169.713}]}],"title":"Measuring a language model","shortTitle":"Measuring a language model","props":{"kicker":"How good is it?","term":"Perplexity","definition":"How surprised a language model is by real text. Lower is better.","example":"perplexity 50 ≈ torn between 50 words each time","analogy":"A quiz contestant who narrows the answer down to two options beats one stuck choosing among fifty."},"start":142.533,"end":170.197,"startFrame":4276,"durationInFrames":857},{"id":"today","kind":"core","component":"BigIdea","short":false,"cues":[{"id":"c27","start":171.1,"end":186.107,"marks":{},"text":"And here's the link to today. The chatbots you use are language models too. They still guess the next word, again and again. They are just vastly bigger, and they learn with neural networks instead of simple counts. We'll meet those networks in unit four.","words":[{"w":"And","start":171.1},{"w":"here's","start":171.22},{"w":"the","start":171.58},{"w":"link","start":171.74},{"w":"to","start":172.02},{"w":"today.","start":172.44},{"w":"The","start":172.86},{"w":"chatbots","start":173.3},{"w":"you","start":173.74},{"w":"use","start":173.94},{"w":"are","start":174.22},{"w":"language","start":174.38},{"w":"models","start":174.86},{"w":"too.","start":175.38},{"w":"They","start":175.74},{"w":"still","start":176.02},{"w":"guess","start":176.26},{"w":"the","start":176.62},{"w":"next","start":176.74},{"w":"word,","start":177.18},{"w":"again","start":177.58},{"w":"and","start":177.98},{"w":"again.","start":178.26},{"w":"They","start":178.78},{"w":"are","start":179.06},{"w":"just","start":179.26},{"w":"vastly","start":179.54},{"w":"bigger,","start":180.06},{"w":"and","start":180.46},{"w":"they","start":180.66},{"w":"learn","start":180.86},{"w":"with","start":181.18},{"w":"neural","start":181.38},{"w":"networks","start":181.86},{"w":"instead","start":182.34},{"w":"of","start":182.7},{"w":"simple","start":182.82},{"w":"counts.","start":183.3},{"w":"We'll","start":183.94},{"w":"meet","start":184.18},{"w":"those","start":184.46},{"w":"networks","start":184.86},{"w":"in","start":185.26},{"w":"unit","start":185.42},{"w":"four.","start":185.74}]}],"title":"From counts to chatbots","shortTitle":"From counts to chatbots","props":{"kicker":"Then and now","text":"Today's chatbots are language models too: far bigger, and built with neural networks.","highlight":["language","models"]},"start":171.1,"end":186.107,"startFrame":5133,"durationInFrames":478},{"id":"quiz","kind":"quiz","component":"Quiz","short":true,"cues":[{"id":"c28","start":187.033,"end":192.465,"marks":{},"text":"Quick quiz. Which word would a language model rate most likely to come next: \"Peanut butter and\"?","words":[{"w":"Quick","start":187.273},{"w":"quiz.","start":187.513},{"w":"Which","start":187.753},{"w":"word","start":188.033},{"w":"would","start":188.313},{"w":"a","start":188.433},{"w":"language","start":188.593},{"w":"model","start":189.033},{"w":"rate","start":189.353},{"w":"most","start":189.673},{"w":"likely","start":189.913},{"w":"to","start":190.233},{"w":"come","start":190.393},{"w":"next:","start":190.633},{"w":"\"Peanut","start":191.193},{"w":"butter","start":191.753},{"w":"and\"?","start":192.153}]},{"id":"c29","start":192.865,"end":194.385,"marks":{},"text":"Pause the video and choose.","words":[{"w":"Pause","start":192.865},{"w":"the","start":193.145},{"w":"video","start":193.405},{"w":"and","start":193.665},{"w":"choose.","start":193.865}]},{"id":"c30","start":197.785,"end":204.227,"marks":{},"text":"It's jelly. In English text, \"peanut butter and\" is followed by jelly far more often than b