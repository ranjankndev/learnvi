ttle","start":7.131},{"w":"prompt","start":7.411},{"w":"from","start":7.771},{"w":"your","start":7.891},{"w":"keyboard","start":8.051},{"w":"all","start":8.691},{"w":"the","start":8.851},{"w":"way","start":9.011},{"w":"to","start":9.251},{"w":"an","start":9.451},{"w":"answer.","start":9.611}]}],"props":{"stop":"Token City","stamp":"TOKEN CITY","number":"3","stampAt":"c01@stamp"},"start":0.6,"end":10.097,"startFrame":0,"durationInFrames":330},{"id":"hook","kind":"hook","component":"TitleHook","short":false,"cues":[{"id":"c03","start":10.997,"end":20.879,"marks":{"number":19.037},"text":"Here's something strange. The model you chat with has never seen the word \"rain\". Not once. It only ever sees a number, something like 4,812.","words":[{"w":"Here's","start":11.197},{"w":"something","start":11.397},{"w":"strange.","start":11.797},{"w":"The","start":12.477},{"w":"model","start":12.757},{"w":"you","start":13.157},{"w":"chat","start":13.357},{"w":"with","start":13.637},{"w":"has","start":13.797},{"w":"never","start":13.997},{"w":"seen","start":14.277},{"w":"the","start":14.557},{"w":"word","start":14.717},{"w":"\"rain\".","start":15.077},{"w":"Not","start":15.677},{"w":"once.","start":16.117},{"w":"It","start":16.677},{"w":"only","start":16.997},{"w":"ever","start":17.277},{"w":"sees","start":17.557},{"w":"a","start":17.697},{"w":"number,","start":17.837},{"w":"something","start":18.437},{"w":"like","start":18.837},{"w":"4,812.","start":19.037}]},{"id":"c04","start":21.279,"end":29.601,"marks":{},"text":"Today we find out how your words become numbers, why the model sometimes can't spell, and why this decides how much every message costs.","words":[{"w":"Today","start":21.479},{"w":"we","start":21.679},{"w":"find","start":21.839},{"w":"out","start":22.119},{"w":"how","start":22.319},{"w":"your","start":22.479},{"w":"words","start":22.719},{"w":"become","start":23.172},{"w":"numbers,","start":23.626},{"w":"why","start":24.079},{"w":"the","start":24.319},{"w":"model","start":24.479},{"w":"sometimes","start":24.959},{"w":"can't","start":25.519},{"w":"spell,","start":25.879},{"w":"and","start":26.359},{"w":"why","start":26.639},{"w":"this","start":26.879},{"w":"decides","start":27.159},{"w":"how","start":27.759},{"w":"much","start":27.999},{"w":"every","start":28.279},{"w":"message","start":28.559},{"w":"costs.","start":29.039}]}],"props":{"title":"Tokenization: How Text Becomes Numbers","word":"rain","id":"4,812","revealAt":"c03@number"},"start":10.997,"end":29.601,"startFrame":330,"durationInFrames":585},{"id":"route","kind":"routeMap","component":"RouteMap","short":false,"cues":[{"id":"c05","start":30.501,"end":40.602,"marks":{"here":36.701},"text":"On the route map, we left the Departure Gate, passed through Library Town where the model was trained, and now we're here: Token City, the first stop inside the model itself.","words":[{"w":"On","start":30.501},{"w":"the","start":30.621},{"w":"route","start":30.741},{"w":"map,","start":31.061},{"w":"we","start":31.381},{"w":"left","start":31.621},{"w":"the","start":31.781},{"w":"Departure","start":31.941},{"w":"Gate,","start":32.541},{"w":"passed","start":33.061},{"w":"through","start":33.421},{"w":"Library","start":33.661},{"w":"Town","start":34.301},{"w":"where","start":34.661},{"w":"the","start":34.781},{"w":"model","start":34.901},{"w":"was","start":35.261},{"w":"trained,","start":35.461},{"w":"and","start":35.861},{"w":"now","start":36.101},{"w":"we're","start":36.381},{"w":"here:","start":36.701},{"w":"Token","start":37.301},{"w":"City,","start":37.861},{"w":"the","start":38.261},{"w":"first","start":38.461},{"w":"stop","start":38.781},{"w":"inside","start":39.141},{"w":"the","start":39.541},{"w":"model","start":39.701},{"w":"itself.","start":40.101}]}],"props":{"current":"ep03","highlightAt":"c05@here"},"start":30.501,"end":40.602,"startFrame":915,"durationInFrames":330},{"id":"numbers","kind":"core","component":"TextToNumbers","short":false,"cues":[{"id":"c06","start":41.502,"end":48.705,"marks":{},"text":"Let's start with our traveller, the prompt: \"Write a short poem about the rain\". On the left of the screen is the prompt as you typed it.","words":[{"w":"Let's","start":41.502},{"w":"start","start":41.822},{"w":"with","start":42.062},{"w":"our","start":42.222},{"w":"traveller,","start":42.422},{"w":"the","start":42.982},{"w":"prompt:","start":43.182},{"w":"\"Write","start":43.742},{"w":"a","start":44.062},{"w":"short","start":44.222},{"w":"poem","start":44.582},{"w":"about","start":45.022},{"w":"the","start":45.182},{"w":"rain\".","start":45.342},{"w":"On","start":45.862},{"w":"the","start":46.062},{"w":"left","start":46.222},{"w":"of","start":46.502},{"w":"the","start":46.622},{"w":"screen","start":46.782},{"w":"is","start":47.182},{"w":"the","start":47.342},{"w":"prompt","start":47.462},{"w":"as","start":47.822},{"w":"you","start":47.982},{"w":"typed","start":48.142},{"w":"it.","start":48.502}]},{"id":"c07","start":49.105,"end":62.34,"marks":{"bytes":54.889},"text":"A computer can't do maths on letters. Underneath, your text is already stored as numbers, one number per character. But a model that works one character at a time would be slow, and a single letter means very little.","words":[{"w":"A","start":49.105},{"w":"computer","start":49.265},{"w":"can't","start":49.785},{"w":"do","start":50.065},{"w":"maths","start":50.305},{"w":"on","start":50.745},{"w":"letters.","start":50.945},{"w":"Underneath,","start":51.705},{"w":"your","start":52.505},{"w":"text","start":52.785},{"w":"is","start":53.185},{"w":"already","start":53.345},{"w":"stored","start":53.785},{"w":"as","start":54.153},{"w":"numbers,","start":54.521},{"w":"one","start":54.889},{"w":"number","start":55.257},{"w":"per","start":55.625},{"w":"character.","start":55.865},{"w":"But","start":56.545},{"w":"a","start":56.825},{"w":"model","start":56.945},{"w":"that","start":57.425},{"w":"works","start":57.625},{"w":"one","start":57.945},{"w":"character","start":58.185},{"w":"at","start":58.665},{"w":"a","start":58.825},{"w":"time","start":58.985},{"w":"would","start":59.265},{"w":"be","start":59.425},{"w":"slow,","start":59.625},{"w":"and","start":60.145},{"w":"a","start":60.345},{"w":"single","start":60.505},{"w":"letter","start":60.985},{"w":"means","start":61.305},{"w":"very","start":61.705},{"w":"little.","start":62.025}]},{"id":"c08","start":62.74,"end":75.634,"marks":{"lookup":66.46},"text":"So the model cuts your text into bigger pieces called tokens, and looks each one up in a fixed list, its vocabulary. Every token in that list has an ID number. Those IDs are all the model ever sees.","words":[{"w":"So","start":62.74},{"w":"the","start":62.86},{"w":"model","start":63.02},{"w":"cuts","start":63.38},{"w":"your","start":63.7},{"w":"text","start":63.86},{"w":"into","start":64.22},{"w":"bigger","start":64.38},{"w":"pieces","start":64.7},{"w":"called","start":65.14},{"w":"tokens,","start":65.5},{"w":"and","start":66.22},{"w":"looks","start":66.46},{"w":"each","start":66.82},{"w":"one","start":67.06},{"w":"up","start":67.26},{"w":"in","start":67.42},{"w":"a","start":67.54},{"w":"fixed","start":67.66},{"w":"list,","start":68.02},{"w":"its","start":68.687},{"w":"vocabulary.","start":69.353},{"w":"Every","start":70.02},{"w":"token","start":70.46},{"w":"in","start":70.98},{"w":"that","start":71.1},{"w":"list","start":71.3},{"w":"has","start":71.58},{"w":"an","start":71.74},{"w":"ID","start":72.127},{"w":"number.","start":72.513},{"w":"Those","start":72.9},{"w":"IDs","start":73.38},{"w":"are","start":73.86},{"w":"all","start":74.06},{"w":"the","start":74.26},{"w":"model","start":74.38},{"w":"ever","start":74.82},{"w":"sees.","start":75.14}]}],"props":{"text":"Write a short poem about the rain","bytesAt":"c07@bytes","lookupAt":"c08@lookup","tokens":["Write"," a"," short"," poem"," about"," the"," rain"],"ids":[8144,264,2875,33894,922,279,4812]},"start":41.502,"end":75.634,"startFrame":1245,"durationInFrames":1051},{"id":"options","kind":"core","component":"ThreeOptions","short":false,"cues":[{"id":"c09","start":76.534,"end":82.115,"marks":{},"text":"So how big should the pieces be? There are three choices, and the word \"raindrops\" will help us compare them.","words":[{"w":"So","start":76.534},{"w":"how","start":76.694},{"w":"big","start":76.894},{"w":"should","start":77.174},{"w":"the","start":77.334},{"w":"pieces","start":77.494},{"w":"be?","start":77.974},{"w":"There","start":78.294},{"w":"are","start":78.534},{"w":"three","start":78.694},{"w":"choices,","start":78.974},{"w":"and","start":79.574},{"w":"the","start":79.734},{"w":"word","start":79.894},{"w":"\"raindrops\"","start":80.214},{"w":"will","start":80.894},{"w":"help","start":81.054},{"w":"us","start":81.334},{"w":"compare","start":81.494},{"w":"them.","start":81.894}]},{"id":"c10","start":82.515,"end":95.549,"marks":{"chars":83.755},"text":"Choice one: single characters. R, A, I, N, and so on. The vocabulary is tiny, and nothing is ever unknown. But every sentence becomes a very long sequence, which is slow and expensive.","words":[{"w":"Choice","start":82.515},{"w":"one:","start":82.955},{"w":"single","start":83.235},{"w":"characters.","start":83.755},{"w":"R,","start":84.435},{"w":"A,","start":85.115},{"w":"I,","start":85.462},{"w":"N,","start":85.808},{"w":"and","start":86.155},{"w":"so","start":86.395},{"w":"on.","start":86.675},{"w":"The","start":87.208},{"w":"vocabulary","start":87.742},{"w":"is","start":88.275},{"w":"tiny,","start":88.515},{"w":"and","start":88.955},{"w":"nothing","start":89.155},{"w":"is","start":89.515},{"w":"ever","start":89.715},{"w":"unknown.","start":89.995},{"w":"But","start":90.715},{"w":"every","start":90.995},{"w":"sentence","start":91.315},{"w":"becomes","start":91.835},{"w":"a","start":92.275},{"w":"very","start":92.435},{"w":"long","start":92.675},{"w":"sequence,","start":92.995},{"w":"which","start":93.635},{"w":"is","start":93.835},{"w":"slow","start":94.035},{"w":"and","start":94.515},{"w":"expensive.","start":94.715}]},{"id":"c11","start":95.949,"end":107.744,"marks":{"words":97.149},"text":"Choice two: whole words. Now \"raindrops\" is one piece. But there are millions of words, names and typos. Any word missing from the list becomes \"unknown\", and the model is blind to it.","words":[{"w":"Choice","start":95.949},{"w":"two:","start":96.429},{"w":"whole","start":96.789},{"w":"words.","start":97.149},{"w":"Now","start":97.709},{"w":"\"raindrops\"","start":98.069},{"w":"is","start":98.869},{"w":"one","start":99.069},{"w":"piece.","start":99.309},{"w":"But","start":99.749},{"w":"there","start":99.989},{"w":"are","start":100.229},{"w":"millions","start":100.429},{"w":"of","start":100.949},{"w":"words,","start":101.109},{"w":"names","start":101.629},{"w":"and","start":102.069},{"w":"typos.","start":102.269},{"w":"Any","start":103.149},{"w":"word","start":103.509},{"w":"missing","start":103.829},{"w":"from","start":104.189},{"w":"the","start":104.349},{"w":"list","start":104.469},{"w":"becomes","start":104.829},{"w":"\"unknown\",","start":105.309},{"w":"and","start":105.949},{"w":"the","start":106.149},{"w":"model","start":106.309},{"w":"is","start":106.749},{"w":"blind","start":106.949},{"w":"to","start":107.309},{"w":"it.","start":107.509}]},{"id":"c12","start":108.144,"end":113.575,"marks":{},"text":"Pause and predict. If characters are too small and words are too big, what would you choose?","words":[{"w":"Pause","start":108.144},{"w":"and","start":108.624},{"w":"predict.","start":109.064},{"w":"If","start":109.504},{"w":"characters","start":109.824},{"w":"are","start":110.464},{"w":"too","start":110.624},{"w":"small","start":110.944},{"w":"and","start":111.264},{"w":"words","start":111.464},{"w":"are","start":111.784},{"w":"too","start":111.944},{"w":"big,","start":112.184},{"w":"what","start":112.544},{"w":"would","start":112.704},{"w":"you","start":112.904},{"w":"choose?","start":113.064}]},{"id":"c13","start":116.975,"end":127.955,"marks":{"subwords":118.735},"text":"The answer is the middle path: subwords. Common words stay whole. Rare words are built from smaller pieces, like \"rain\" plus \"drops\". Every modern chatbot works this way.","words":[{"w":"The","start":116.975},{"w":"answer","start":117.135},{"w":"is","start":117.535},{"w":"the","start":117.695},{"w":"middle","start":117.855},{"w":"path:","start":118.255},{"w":"subwords.","start":118.735},{"w":"Common","start":119.695},{"w":"words","start":120.175},{"w":"stay","start":120.535},{"w":"whole.","start":120.855},{"w":"Rare","start":121.455},{"w":"words","start":121.895},{"w":"are","start":122.215},{"w":"built","start":122.375},{"w":"from","start":122.655},{"w":"smaller","start":122.895},{"w":"pieces,","start":123.295},{"w":"like","start":123.855},{"w":"\"rain\"","start":124.135},{"w":"plus","start":124.575},{"w":"\"drops\".","start":124.975},{"w":"Every","start":125.775},{"w":"modern","start":126.095},{"w":"chatbot","start":126.615},{"w":"works","start":127.135},{"w":"this","start":127.495},{"w":"way.","start":127.735}]}],"props":{"word":"raindrops","charsAt":"c10@chars","wordsAt":"c11@words","subwordsAt":"c13@subwords","subwords":["rain","drops"]},"start":76.534,"end":127.955,"startFrame":2296,"durationInFrames":1570},{"id":"bpe","kind":"core","component":"BpeMerge","short":false,"cues":[{"id":"c14","start":128.855,"end":140.988,"marks":{},"text":"The most popular way to build that list of subwords is called Byte Pair Encoding, or BPE. The idea fits in one sentence: keep gluing together the pair of pieces that appears most often.","words":[{"w":"The","start":128.855},{"w":"most","start":129.015},{"w":"popular","start":129.255},{"w":"way","start":129.735},{"w":"to","start":129.935},{"w":"build","start":130.095},{"w":"that","start":130.375},{"w":"list","start":130.535},{"w":"of","start":130.775},{"w":"subwords","start":130.895},{"w":"is","start":131.495},{"w":"called","start":131.735},{"w":"Byte","start":132.175},{"w":"Pair","start":132.615},{"w":"Encoding,","start":133.055},{"w":"or","start":133.495},{"w":"BPE.","start":134.135},{"w":"The","start":134.775},{"w":"idea","start":135.255},{"w":"fits","start":135.895},{"w":"in","start":136.335},{"w":"one","start":136.535},{"w":"sentence:","start":136.775},{"w":"keep","start":137.575},{"w":"gluing","start":137.855},{"w":"together","start":138.295},{"w":"the","start":138.655},{"w":"pair","start":138.815},{"w":"of","start":139.015},{"w":"pieces","start":139.175},{"w":"that","start":139.615},{"w":"appears","start":139.815},{"w":"most","start":140.255},{"w":"often.","start":140.535}]},{"id":"c15","start":141.388,"end":152.641,"marks":{},"text":"Let's run it on a tiny example. Our training text has \"rain\" 9 times, \"rainy\" 4 times, \"raining\" 5 times and \"train\" 3 times. We start with single letters.","words":[{"w":"Let's","start":141.388},{"w":"run","start":141.708},{"w":"it","start":141.908},{"w":"on","start":142.068},{"w":"a","start":142.148},{"w":"tiny","start":142.268},{"w":"example.","start":142.668},{"w":"Our","start":143.388},{"w":"training","start":143.628},{"w":"text","start":144.068},{"w":"has","start":144.468},{"w":"\"rain\"","start":144.768},{"w":"9","start":145.068},{"w":"times,","start":145.468},{"w":"\"rainy\"","start":146.108},{"w":"4","start":146.708},{"w":"times,","start":147.068},{"w":"\"raining\"","start":147.708},{"w":"5","start":148.348},{"w":"times","start":148.788},{"w":"and","start":149.228},{"w":"\"train\"","start":149.608},{"w":"3","start":149.988},{"w":"times.","start":150.268},{"w":"We","start":150.908},{"w":"start","start":151.148},{"w":"with","start":151.508},{"w":"single","start":151.668},{"w":"letters.","start":152.148}]},{"id":"c16","start":153.041,"end":159.459,"marks":{},"text":"Now we count every pair of neighbouring letters across all those words. On screen, the bars show the counts.","words":[{"w":"Now","start":153.041},{"w":"we","start":153.361},{"w":"count","start":153.561},{"w":"every","start":153.881},{"w":"pair","start":154.161},{"w":"of","start":154.401},{"w":"neighbouring","start":154.521},{"w":"letters","start":155.001},{"w":"across","start":155.401},{"w":"all","start":155.841},{"w":"those","start":156.041},{"w":"words.","start":156.361},{"w":"On","start":156.961},{"w":"screen,","start":157.241},{"w":"the","start":157.841},{"w":"bars","start":158.081},{"w":"show","start":158.521},{"w":"the","start":158.801},{"w":"counts.","start":159.001}]},{"id":"c17","start":159.859,"end":163.809,"marks":{"pause":159.859},"text":"Pause and predict: which pair wins? Hint: \"raining\" has it twice.","words":[{"w":"Pause","start":159.859},{"w":"and","start":160.219},{"w":"predict:","start":160.379},{"w":"which","start":160.859},{"w":"pair","start":161.179},{"w":"wins?","start":161.499},{"w":"Hint:","start":161.819},{"w":"\"raining\"","start":162.359},{"w":"has","start":162.899},{"w":"it","start":163.099},{"w":"twice.","start":163.299}]},{"id":"c18","start":167.209,"end":174.643,"marks":{"merge":170.769},"text":"It's \"i\" followed by \"n\", 26 times. So we glue them into one new piece, \"in\", and add it to the vocabulary.","words":[{"w":"It's","start":167.209},{"w":"\"i\"","start":167.529},{"w":"followed","start":167.849},{"w":"by","start":168.182},{"w":"\"n\",","start":168.516},{"w":"26","start":168.849},{"w":"times.","start":169.769},{"w":"So","start":170.329},{"w":"we","start":170.569},{"w":"glue","start":170.769},{"w":"them","start":171.049},{"w":"into","start":171.249},{"w":"one","start":171.449},{"w":"new","start":171.729},{"w":"piece,","start":171.929},{"w":"\"in\",","start":172.409},{"w":"and","start":172.689},{"w":"add","start":172.969},{"w":"it","start":173.289},{"w":"to","start":173.449},{"w":"the","start":173.847},{"w":"vocabulary.","start":174.245}]},{"id":"c19","start":175.043,"end":184.224,"marks":{"repeat":175.363,"ra":176.603,"rain":180.123},"text":"Then we count again and repeat. \"r\" plus \"a\" wins next, 21 times. Then \"ra\" plus \"in\" becomes \"rain\", a whole word as a single to