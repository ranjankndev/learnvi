{"key":"nlp-basics-u4-02","seriesId":"nlp-basics","episode":"u4-02","title":"Word2Vec: Learning Word Vectors from Context","fps":30,"duration":218.294,"durationInFrames":6549,"video":{"width":1920,"height":1080,"burnCaptions":true,"brand":"learnvi.in"},"badge":["UNIT 4 · LESSON 2","WORD2VEC"],"series":{"title":"NLP, Simply Explained","subtitle":"University NLP, one idea at a time, no heavy maths","runningPrompt":"","stops":[{"id":"u1-01","number":1,"name":"The Stages of NLP: From Letters to Meaning","stamp":"THE STAGES OF NLP: FROM LETTERS TO MEANING","topic":""},{"id":"u1-02","number":2,"name":"Tokenization: How Text Becomes Pieces","stamp":"TOKENIZATION: HOW TEXT BECOMES PIECES","topic":""},{"id":"u1-03","number":3,"name":"Text Classification: Teaching Computers to Sort Text","stamp":"TEXT CLASSIFICATION: TEACHING COMPUTERS TO SORT TEXT","topic":""},{"id":"u1-04","number":4,"name":"Language Models: Guessing the Next Word","stamp":"LANGUAGE MODELS: GUESSING THE NEXT WORD","topic":""},{"id":"u2-01","number":5,"name":"Morphology: The Building Blocks Inside Words","stamp":"MORPHOLOGY: THE BUILDING BLOCKS INSIDE WORDS","topic":""},{"id":"u2-02","number":6,"name":"Part-of-Speech Tagging: Is It a Noun or a Verb?","stamp":"PART-OF-SPEECH TAGGING: IS IT A NOUN OR A VERB?","topic":""},{"id":"u2-03","number":7,"name":"Chunking: Grouping Words into Phrases","stamp":"CHUNKING: GROUPING WORDS INTO PHRASES","topic":""},{"id":"u2-04","number":8,"name":"Generative vs Discriminative Models","stamp":"GENERATIVE VS DISCRIMINATIVE MODELS","topic":""},{"id":"u2-05","number":9,"name":"Hidden Markov Models, Intuitively","stamp":"HIDDEN MARKOV MODELS, INTUITIVELY","topic":""},{"id":"u2-06","number":10,"name":"Conditional Random Fields, Intuitively","stamp":"CONDITIONAL RANDOM FIELDS, INTUITIVELY","topic":""},{"id":"u3-01","number":11,"name":"Constituency Parsing: Sentences as Trees","stamp":"CONSTITUENCY PARSING: SENTENCES AS TREES","topic":""},{"id":"u3-02","number":12,"name":"Dependency Parsing: Who Did What to Whom","stamp":"DEPENDENCY PARSING: WHO DID WHAT TO WHOM","topic":""},{"id":"u3-03","number":13,"name":"Transition-Based Parsing: Building Trees Step by Step","stamp":"TRANSITION-BASED PARSING: BUILDING TREES STEP BY STEP","topic":""},{"id":"u4-01","number":14,"name":"Word Vectors: Giving Words a Place on a Map","stamp":"WORD VECTORS: GIVING WORDS A PLACE ON A MAP","topic":""},{"id":"u4-02","number":15,"name":"Word2Vec: Learning Word Vectors from Context","stamp":"WORD2VEC: LEARNING WORD VECTORS FROM CONTEXT","topic":""},{"id":"u4-03","number":16,"name":"Recurrent Neural Networks: Reading with Memory","stamp":"RECURRENT NEURAL NETWORKS: READING WITH MEMORY","topic":""},{"id":"u4-04","number":17,"name":"LSTMs: Remembering What Matters","stamp":"LSTMS: REMEMBERING WHAT MATTERS","topic":""},{"id":"u5-01","number":18,"name":"Contextual Embeddings and ELMo","stamp":"CONTEXTUAL EMBEDDINGS AND ELMO","topic":""},{"id":"u5-02","number":19,"name":"BERT: Reading in Both Directions","stamp":"BERT: READING IN BOTH DIRECTIONS","topic":""}]},"stop":{"number":15,"name":"Word2Vec: Learning Word Vectors from Context","stamp":"WORD2VEC: LEARNING WORD VECTORS FROM CONTEXT"},"shorts":{"width":1080,"height":1920,"maxSeconds":60,"cta":"Full lesson: NLP, Simply Explained · Unit 4"},"thumbnail":{"headline":"How AI learns word meaning by reading","big":"skip-gram"},"segments":[{"id":"intro","kind":"intro","component":"TitleCard","short":false,"cues":[{"id":"c01","start":0.6,"end":6.527,"marks":{},"text":"Welcome back to NLP, Simply Explained. This is unit 4, lesson 2: Word2Vec.","words":[{"w":"Welcome","start":0.6},{"w":"back","start":1.08},{"w":"to","start":1.427},{"w":"NLP,","start":1.773},{"w":"Simply","start":2.12},{"w":"Explained.","start":2.72},{"w":"This","start":3.48},{"w":"is","start":3.8},{"w":"unit","start":3.96},{"w":"4,","start":4.25},{"w":"lesson","start":4.54},{"w":"2:","start":4.83},{"w":"Word2Vec.","start":5.12}]},{"id":"c02","start":6.927,"end":14.409,"marks":{},"text":"Last time we built word vectors by counting. Today we meet the famous method that learns them instead, just by reading.","words":[{"w":"Last","start":6.927},{"w":"time","start":7.247},{"w":"we","start":7.487},{"w":"built","start":7.687},{"w":"word","start":8.074},{"w":"vectors","start":8.46},{"w":"by","start":8.847},{"w":"counting.","start":9.087},{"w":"Today","start":9.767},{"w":"we","start":10.447},{"w":"meet","start":10.687},{"w":"the","start":10.927},{"w":"famous","start":11.087},{"w":"method","start":11.487},{"w":"that","start":11.887},{"w":"learns","start":12.047},{"w":"them","start":12.407},{"w":"instead,","start":12.607},{"w":"just","start":13.327},{"w":"by","start":13.647},{"w":"reading.","start":13.847}]}],"title":"Welcome","shortTitle":"Welcome","props":{"kicker":"Unit 4 · Lesson 2","title":"Word2Vec","subtitle":"Learning word vectors by guessing neighbours"},"start":0.6,"end":14.409,"startFrame":0,"durationInFrames":460},{"id":"idea","kind":"core","component":"BigIdea","short":false,"cues":[{"id":"c03","start":15.333,"end":23.273,"marks":{},"text":"Here's the idea. Learn word vectors by playing a simple guessing game, millions of times: predict which words appear near each other.","words":[{"w":"Here's","start":15.333},{"w":"the","start":15.733},{"w":"idea.","start":15.893},{"w":"Learn","start":16.693},{"w":"word","start":17.106},{"w":"vectors","start":17.52},{"w":"by","start":17.933},{"w":"playing","start":18.093},{"w":"a","start":18.453},{"w":"simple","start":18.573},{"w":"guessing","start":18.973},{"w":"game,","start":19.413},{"w":"millions","start":19.813},{"w":"of","start":20.333},{"w":"times:","start":20.533},{"w":"predict","start":21.133},{"w":"which","start":21.613},{"w":"words","start":21.853},{"w":"appear","start":22.173},{"w":"near","start":22.493},{"w":"each","start":22.733},{"w":"other.","start":22.973}]}],"title":"The big idea","shortTitle":"The big idea","props":{"kicker":"Key idea","text":"Learn word vectors by playing a guessing game: predict a word's neighbours.","highlight":["guessing game:"]},"start":15.333,"end":23.273,"startFrame":460,"durationInFrames":266},{"id":"w2v","kind":"core","component":"Definition","short":false,"cues":[{"id":"c04","start":24.2,"end":33.596,"marks":{},"text":"Word2Vec is a method published in 2013. It learns word vectors by training a small network to predict which words appear near each other.","words":[{"w":"Word2Vec","start":24.74},{"w":"is","start":25.28},{"w":"a","start":25.44},{"w":"method","start":25.6},{"w":"published","start":26},{"w":"in","start":26.52},{"w":"2013.","start":26.68},{"w":"It","start":28.08},{"w":"learns","start":28.36},{"w":"word","start":28.773},{"w":"vectors","start":29.187},{"w":"by","start":29.6},{"w":"training","start":29.8},{"w":"a","start":30.2},{"w":"small","start":30.32},{"w":"network","start":30.74},{"w":"to","start":31.16},{"w":"predict","start":31.36},{"w":"which","start":31.84},{"w":"words","start":32.08},{"w":"appear","start":32.44},{"w":"near","start":32.76},{"w":"each","start":33.08},{"w":"other.","start":33.32}]},{"id":"c05","start":33.996,"end":39.758,"marks":{},"text":"In \"the cat sat\", the word cat appears next to the and sat. The network learns from pairs like these.","words":[{"w":"In","start":33.996},{"w":"\"the","start":34.156},{"w":"cat","start":34.316},{"w":"sat\",","start":34.676},{"w":"the","start":35.036},{"w":"word","start":35.236},{"w":"cat","start":35.516},{"w":"appears","start":35.796},{"w":"next","start":36.236},{"w":"to","start":36.516},{"w":"the","start":36.596},{"w":"and","start":36.849},{"w":"sat.","start":37.103},{"w":"The","start":37.356},{"w":"network","start":37.596},{"w":"learns","start":38.156},{"w":"from","start":38.516},{"w":"pairs","start":38.676},{"w":"like","start":39.076},{"w":"these.","start":39.356}]},{"id":"c06","start":40.158,"end":47.677,"marks":{},"text":"Think of learning a language through millions of fill-in-the-blank exercises. You end up with a feel for which words belong together.","words":[{"w":"Think","start":40.158},{"w":"of","start":40.318},{"w":"learning","start":40.478},{"w":"a","start":40.838},{"w":"language","start":40.998},{"w":"through","start":41.598},{"w":"millions","start":41.878},{"w":"of","start":42.438},{"w":"fill-in-the-blank","start":43.038},{"w":"exercises.","start":43.638},{"w":"You","start":44.758},{"w":"end","start":45.038},{"w":"up","start":45.318},{"w":"with","start":45.518},{"w":"a","start":45.638},{"w":"feel","start":45.758},{"w":"for","start":46.038},{"w":"which","start":46.238},{"w":"words","start":46.438},{"w":"belong","start":46.798},{"w":"together.","start":47.198}]}],"title":"What is Word2Vec?","shortTitle":"What is Word2Vec?","props":{"kicker":"Definition","term":"Word2Vec","definition":"A method from 2013 that learns word vectors by training a small network to predict which words appear near each other.","example":"“the cat sat”: cat ↔ the, sat","analogy":"Learning a language through millions of fill-in-the-blank exercises."},"start":24.2,"end":47.677,"startFrame":726,"durationInFrames":732},{"id":"window","kind":"core","component":"Table","short":true,"cues":[{"id":"c07","start":48.6,"end":55.597,"marks":{},"text":"Where do the training pairs come from? A sliding window. Here, the window covers two words on each side of a centre word.","words":[{"w":"Where","start":48.6},{"w":"do","start":48.72},{"w":"the","start":48.84},{"w":"training","start":49},{"w":"pairs","start":49.32},{"w":"come","start":49.76},{"w":"from?","start":50},{"w":"A","start":50.28},{"w":"sliding","start":50.48},{"w":"window.","start":51.08},{"w":"Here,","start":51.84},{"w":"the","start":52.32},{"w":"window","start":52.6},{"w":"covers","start":53.04},{"w":"two","start":53.44},{"w":"words","start":53.68},{"w":"on","start":54},{"w":"each","start":54.213},{"w":"side","start":54.427},{"w":"of","start":54.64},{"w":"a","start":54.76},{"w":"centre","start":54.88},{"w":"word.","start":55.32}]},{"id":"c08","start":55.997,"end":59.321,"marks":{},"text":"With quick in the centre, the neighbours are the, brown and fox.","words":[{"w":"With","start":56.13},{"w":"quick","start":56.264},{"w":"in","start":56.397},{"w":"the","start":56.557},{"w":"centre,","start":56.677},{"w":"the","start":57.117},{"w":"neighbours","start":57.277},{"w":"are","start":57.837},{"w":"the,","start":57.997},{"w":"brown","start":58.157},{"w":"and","start":58.557},{"w":"fox.","start":58.757}]},{"id":"c09","start":59.721,"end":63.789,"marks":{},"text":"Slide along to brown, and its neighbours are the, quick, fox and jumps.","words":[{"w":"Slide","start":59.721},{"w":"along","start":60.121},{"w":"to","start":60.401},{"w":"brown,","start":60.561},{"w":"and","start":61.041},{"w":"its","start":61.241},{"w":"neighbours","start":61.481},{"w":"are","start":61.961},{"w":"the,","start":62.188},{"w":"quick,","start":62.414},{"w":"fox","start":62.641},{"w":"and","start":63.081},{"w":"jumps.","start":63.241}]},{"id":"c10","start":64.189,"end":70.436,"marks":{},"text":"And for fox, they're quick, brown and jumps. Every one of these pairs becomes a small training example.","words":[{"w":"And","start":64.189},{"w":"for","start":64.309},{"w":"fox,","start":64.549},{"w":"they're","start":64.976},{"w":"quick,","start":65.402},{"w":"brown","start":65.829},{"w":"and","start":66.309},{"w":"jumps.","start":66.509},{"w":"Every","start":67.229},{"w":"one","start":67.629},{"w":"of","start":67.789},{"w":"these","start":67.909},{"w":"pairs","start":68.229},{"w":"becomes","start":68.549},{"w":"a","start":68.989},{"w":"small","start":69.109},{"w":"training","start":69.389},{"w":"example.","start":69.869}]}],"title":"Neighbours in a window","shortTitle":"How Word2Vec learns from a sliding window","props":{"kicker":"Context window","title":"“the quick brown fox jumps” · window of 2","columns":["Centre word","Its neighbours"],"rows":[["quick","the · brown · fox"],["brown","the · quick · fox · jumps"],["fox","quick · brown · jumps"]],"highlight":[{"row":1}]},"start":48.6,"end":70.436,"startFrame":1458,"durationInFrames":683},{"id":"two","kind":"core","component":"Compare","short":false,"cues":[{"id":"c11","start":71.367,"end":73.535,"marks":{},"text":"Word2Vec comes in two versions.","words":[{"w":"Word2Vec","start":71.847},{"w":"comes","start":72.327},{"w":"in","start":72.607},{"w":"two","start":72.916},{"w":"versions.","start":73.226}]},{"id":"c12","start":73.935,"end":79.7,"marks":{},"text":"Skip-gram looks at the centre word and tries to guess its neighbours. It tends to do better for rare words.","words":[{"w":"Skip-gram","start":74.295},{"w":"looks","start":74.655},{"w":"at","start":74.855},{"w":"the","start":74.975},{"w":"centre","start":75.095},{"w":"word","start":75.495},{"w":"and","start":75.695},{"w":"tries","start":75.855},{"w":"to","start":76.175},{"w":"guess","start":76.335},{"w":"its","start":76.615},{"w":"neighbours.","start":76.855},{"w":"It","start":77.535},{"w":"tends","start":77.775},{"w":"to","start":78.095},{"w":"do","start":78.255},{"w":"better","start":78.455},{"w":"for","start":78.735},{"w":"rare","start":78.895},{"w":"words.","start":79.295}]},{"id":"c13","start":80.1,"end":94.552,"marks":{},"text":"CBOW, short for continuous bag of words, does the opposite: it looks at the neighbours and guesses the centre word. It's faster to train. Either way, we don't really care about the guesses. The vectors learned along the way are the real prize.","words":[{"w":"CBOW,","start":80.44},{"w":"short","start":80.78},{"w":"for","start":81.22},{"w":"continuous","start":81.42},{"w":"bag","start":82.02},{"w":"of","start":82.26},{"w":"words,","start":82.42},{"w":"does","start":82.82},{"w":"the","start":83.1},{"w":"opposite:","start":83.22},{"w":"it","start":83.98},{"w":"looks","start":84.18},{"w":"at","start":84.5},{"w":"the","start":84.62},{"w":"neighbours","start":84.7},{"w":"and","start":85.22},{"w":"guesses","start":85.38},{"w":"the","start":85.86},{"w":"centre","start":86.1},{"w":"word.","start":86.5},{"w":"It's","start":86.9},{"w":"faster","start":87.3},{"w":"to","start":87.82},{"w":"train.","start":88.02},{"w":"Either","start":88.62},{"w":"way,","start":89.06},{"w":"we","start":89.34},{"w":"don't","start":89.58},{"w":"really","start":89.78},{"w":"care","start":90.1},{"w":"about","start":90.38},{"w":"the","start":90.58},{"w":"guesses.","start":90.7},{"w":"The","start":91.18},{"w":"vectors","start":91.66},{"w":"learned","start":92.14},{"w":"along","start":92.54},{"w":"the","start":92.9},{"w":"way","start":93.06},{"w":"are","start":93.3},{"w":"the","start":93.46},{"w":"real","start":93.62},{"w":"prize.","start":93.98}]}],"title":"Two versions","shortTitle":"Two versions","props":{"kicker":"Two versions","title":"Skip-gram versus CBOW","columns":[{"title":"Skip-gram","items":["centre word → guess the neighbours","better for rare words"],"tone":"neutral"},{"title":"CBOW","items":["neighbours → guess the centre word","faster to train"],"tone":"neutral"}],"verdict":{"text":"Either way, the vectors are the real prize"}},"start":71.367,"end":94.552,"startFrame":2141,"durationInFrames":723},{"id":"loop","kind":"core","component":"Steps","short":false,"cues":[{"id":"c14","start":95.467,"end":98.372,"marks":{},"text":"Here's the training loop, repeated millions of times.","words":[{"w":"Here's","start":95.467},{"w":"the","start":95.827},{"w":"training","start":95.947},{"w":"loop,","start":96.347},{"w":"repeated","start":96.707},{"w":"millions","start":97.227},{"w":"of","start":97.747},{"w":"times.","start":97.867}]},{"id":"c15","start":98.772,"end":102.864,"marks":{},"text":"Pick: take a word and one of its real neighbours, like fox and brown.","words":[{"w":"Pick:","start":98.772},{"w":"take","start":99.172},{"w":"a","start":99.412},{"w":"word","start":99.532},{"w":"and","start":99.812},{"w":"one","start":99.972},{"w":"of","start":100.132},{"w":"its","start":100.252},{"w":"real","start":100.452},{"w":"neighbours,","start":100.732},{"w":"like","start":101.412},{"w":"fox","start":101.732},{"w":"and","start":102.172},{"w":"brown.","start":102.372}]},{"id":"c16","start":103.264,"end":108.384,"marks":{},"text":"Guess: the network scores how likely the two are to be neighbours, by comparing their vectors.","words":[{"w":"Guess:","start":103.264},{"w":"the","start":103.624},{"w":"network","start":103.784},{"w":"scores","start":104.304},{"w":"how","start":104.784},{"w":"likely","start":104.984},{"w":"the","start":105.304},{"w":"two","start":105.424},{"w":"are","start":105.664},{"w":"to","start":105.824},{"w":"be","start":105.904},{"w":"neighbours,","start":106.064},{"w":"by","start":106.744},{"w":"comparing","start":107.024},{"w":"their","start":107.477},{"w":"vectors.","start":107.931}]},{"id":"c17","start":108.784,"end":113.212,"marks":{},"text":"Nudge: since they really are neighbours, move their vectors a little closer together.","words":[{"w":"Nudge:","start":108.824},{"w":"since","start":109.344},{"w":"they","start":109.624},{"w":"really","start":109.824},{"w":"are","start":110.224},{"w":"neighbours,","start":110.384},{"w":"move","start":111.024},{"w":"their","start":111.357},{"w":"vectors","start":111.691},{"w":"a","start":112.024},{"w":"little","start":112.144},{"w":"closer","start":112.344},{"w":"together.","start":112.704}]},{"id":"c18","start":113.612,"end":119.239,"marks":{},"text":"Push away: and pick a few random words that are not neighbours, and move them a little further apart.","words":[{"w":"Push","start":113.612},{"w":"away:","start":114.012},{"w":"and","start":114.412},{"w":"pick","start":114.652},{"w":"a","start":114.892},{"w":"few","start":115.012},{"w":"random","start":115.292},{"w":"words","start":115.772},{"w":"that","start":116.092},{"w":"are","start":116.252},{"w":"not","start":116.372},{"w":"neighbours,","start":116.572},{"w":"and","start":117.212},{"w":"move","start":117.452},{"w":"them","start":117.772},{"w":"a","start":117.972},{"w":"little","start":118.092},{"w":"further","start":118.332},{"w":"apart.","start":118.772}]}],"title":"The training loop","shortTitle":"The training loop","props":{"kicker":"Training","title":"How the vectors are learned","steps":[{"label":"Pick","detail":"a word and a real neighbour"},{"label":"Guess","detail":"how likely they're neighbours"},{"label":"Nudge","detail":"move their vectors closer"},{"label":"Push away","detail":"a few random non-neighbours"}]},"start":95.467,"end":119.239,"startFrame":2864,"durationInFrames":741},{"id":"negative","kind":"core","component":"Definition","short":false,"cues":[{"id":"c19","start":120.167,"end":133.109,"marks":{},"text":"That last step has a name: negative sampling. Instead of comparing against every word in the vocabulary, which would be painfully slow, the model compares against just a handful of random words that aren't neighbours.","words":[{"w":"That","start":120.167},{"w":"last","start":120.407},{"w":"step","start":120.727},{"w":"has","start":121.127},{"w":"a","start":121.287},{"w":"name:","start":121.447},{"w":"negative","start":121.887},{"w":"sampling.","start":122.567},{"w":"Instead","start":123.327},{"w":"of","start":123.847},{"w":"comparing","start":124.007},{"w":"against","start":124.567},{"w":"every","start":124.967},{"w":"word","start":125.247},{"w":"in","start":125.487},{"w":"the","start":125.914},{"w":"vocabulary,","start":126.34},{"w":"which","start":126.767},{"w":"would","start":127.007},{"w":"be","start":127.127},{"w":"painfully","start":127.287},{"w":"slow,","start":127.927},{"w":"the","start":128.487},{"w":"model","start":128.727},{"w":"compares","start":129.167},{"w":"against","start":129.687},{"w":"just","start":130.127},{"w":"a","start":130.367},{"w":"handful","start":130.567},{"w":"of","start":131.007},{"w":"random","start":131.207},{"w":"words","start":131.687},{"w":"that","start":132.047},{"w":"aren't","start":132.247},{"w":"neighbours.","start":132.487}]},{"id":"c20","start":133.509,"end":142.646,"marks":{},"text":"So alongside the real pair, fox and brown, it sees a few fake pairs, like fox and carpet, or fox and Tuesday, and learns to tell them apart.","words":[{"w":"So","start":133.509},{"w":"alongside","start":133.709},{"w":"the","start":134.309},{"w":"real","start":134.469},{"w":"pair,","start":134.789},{"w":"fox","start":135.189},{"w":"and","start":135.629},{"w":"brown,","start":135.829},{"w":"it","start":136.389},{"w":"sees","start":136.629},{"w":"a","start":136.949},{"w":"few","start":137.069},{"w":"fake","start":137.309},{"w":"pairs,","start":137.689},{"w":"like","start":138.069},{"w":"fox","start":138.309},{"w":"and","start":138.709},{"w":"carpet,","start":138.869},{"w":"or","start":139.469},{"w":"fox","start":139.749},{"w":"and","start":140.049},{"w":"Tuesday,","start":140.349},{"w":"and","start":140.989},{"w":"learns","start":141.189},{"w":"to","start":141.589},{"w":"tell","start":141.749},{"w":"them","start":141.989},{"w":"apart.","start":142.149}]},{"id":"c21","start":143.046,"end":147.464,"marks":{},"text":"It's like learning what a cat is by also being shown a few things that aren't cats.","words":[{"w":"It's","start":143.046},{"w":"like","start":143.206},{"w":"learning","start":143.406},{"w":"what","start":143.766},{"w":"a","start":143.926},{"w":"cat","start":144.086},{"w":"is","start":144.366},{"w":"by","start":144.686},{"w":"also","start":144.966},{"w":"being","start":145.286},{"w":"shown","start":145.566},{"w":"a","start":145.886},{"w":"few","start":146.006},{"w":"things","start":146.246},{"w":"that","start":146.566},{"w":"aren't","start":146.726},{"w":"cats.","start":146.966}]}],"title":"Negative sampling","shortTitle":"Negative sampling","props":{"kicker":"A clever shortcut","term":"Negative sampling","definition":"Instead of comparing against every word in the vocabulary, compare against just a few random words that aren't neighbours.","example":"real: (fox, brown)  ·  fake: (fox, carpet), (fox, Tuesday)","analogy":"Learning what a cat is by also seeing a few things that aren't cats."},"start":120.167,"end":147.464,"startFrame":3605,"durationInFrames":846},{"id":"results","kind":"core","component":"Bullets","short":false,"cues":[{"id":"c22","start":148.367,"end":149.815,"marks":{},"text":"So what does all this give us?","words":[{"w":"So","start":148.367},{"w":"what","start":148.567},{"w":"does","start":148.767},{"w":"all","start":148.967},{"w":"this","start":149.127},{"w":"give","start":149.327},{"w":"us?","start":149.567}]},{"id":"c23","start":150.215,"end":157.076,"marks":{},"text":"Word2Vec learns from huge amounts of text, quickly, without any labels. The text itself is the teacher.","words":[{"w":"Word2Vec","start":150.695},{"w":"learns","start":151.175},{"w":"from","start":151.575},{"w":"huge","start":151.775},{"w":"amounts","start":152.095},{"w":"of","start":152.495},{"w":"text,","start":152.908},{"w":"quickly,","start":153.322},{"w":"without","start":153.735},{"w":"any","start":154.055},{"w":"labels.","start":154.335},{"w":"The","start":155.015},{"w":"text","start":155.295},{"w":"itself","start":155.735},{"w":"is","start":156.215},{"w":"the","start":156.375},{"w":"teacher.","start":156.535}]},{"id":"c24","start":157.476,"end":164.785,"marks":{},"text":"Words with similar meanings end up close together, and you get the word maths from earlier, like king minus man plus woman.","words":[{"w":"Words","start":157.476},{"w":"with","start":157.876},{"w":"similar","start":158.076},{"w":"meanings","start":158.556},{"w":"end","start":159.036},{"w":"up","start":159.276},{"w":"close","start":159.476},{"w":"together,","start":159.796},{"w":"and","start":160.316},{"w":"you","start":160.516},{"w":"get","start":160.716},{"w":"the","start":160.916},{"w":"word","start":161.076},{"w":"maths","start":161.356},{"w":"from","start":161.796},{"w":"earlier,","start":161.996},{"w":"like","start":162.636},{"w":"king","start":162.916},{"w":"minus","start":163.236},{"w":"man","start":163.756},{"w":"plus","start":163.996},{"w":"woman.","start":164.396}]},{"id":"c25","start":165.185,"end":174.494,"marks":{},"text":"But there's a catch. Each word gets exactly one vector, so \"bank\", the river kind and the money kind, has to share one. We'll fix that in unit five.","words":[{"w":"But","start":165.185},{"w":"there's","start":165.305},{"w":"a","start":165.585},{"w":"catch.","start":165.745},{"w":"Each","start":166.385},{"w":"word","start":166.705},{"w":"gets","start":167.025},{"w":"exactly","start":167.385},{"w":"one","start":167.838},{"w":"vector,","start":168.292},{"w":"so","start":168.745},{"w":"\"bank\",","start":169.025},{"w":"the","start":169.465},{"w":"river","start":169.665},{"w":"kind","start":169.985},{"w":"and","start":170.265},{"w":"the","start":170.425},{"w":"money","start":170.585},{"w":"kind,","start":170.985},{"w":"has","start":171.345},{"w":"to","start":171.585},{"w":"share","start":171.745},{"w":"one.","start":172.145},{"w":"We'll","start":172.545},{"w":"fix","start":172.865},{"w":"that","start":173.225},{"w":"in","start":173.465},{"w":"unit","start":173.665},{"w":"five.","start":174.065}]}],"title":"What you get","shortTitle":"What you get","props":{"kicker":"Results","title":"What Word2Vec gives you","items":[{"text":"Learns from huge amounts of text, quickly"},{"text":"Similar words end up close together"},{"text":"But one vector per word: “bank” gets just one"}],"numbered":false},"start":148.367,"end":174.494,"startFrame":4451,"durationInFrames":811},{"id":"quiz","kind":"quiz","component":"Quiz","short":true,"cues":[{"id":"c26","start":175.4,"end":178.904,"marks":{},"text":"Quick quiz. In skip-gram, what does the model try to predict?","words":[{"w":"Quick","start":175.64},{"w":"quiz.","start":175.88},{"w":"In","start":176.12},{"w":"skip-gram,","start":176.32},{"w":"what","start":177.12},{"w":"does","start":177.32},{"w":"the","start":177.56},{"w":"model","start":177.64},{"w":"try","start":178},{"w":"to","start":178.2},{"w":"predict?","start":178.552}]},{"id":"c27","start":179.304,"end":180.824,"marks":{},"text":"Pause the video and choose.","words":[{"w":"Pause","start":179.304},{"w":"the","start":179.584},{"w":"video","start":179.844},{"w":"and","start":180.104},{"w":"choose.","start":180.304}]},{"id":"c28","start":184.224,"end":189.882,"marks":{},"text":"It predicts the neighbours of a word. It takes the centre word, and guesses the words that appear around it.","words":[{"w":"It","start":184.224},{"w":"predicts","start":184.384},{"w":"the","start":184.824},{"w":"neighbours","start":184.944},{"w":"of","start":185.424},{"w":"a","start":185.584},{"w":"word.","start":185.744},{"w":"It","start":186.184},{"w":"takes","start":186.464},{"w":"the","start":186.784},{"w":"centre","start":186.984},{"w":"word,","start":187.424},{"w":"and","start":187.664},{"w":"guesses","start":187.864},{"w":"the","start":188.344},{"w":"words","start":188.504},{"w":"that","start":188.784},{"w":"appear","start":188.984},{"w":"around","start":189.264},{"w":"it.","start":189.704}]}],"title":"Quick quiz","shortTitle":"Quick quiz: what does skip-gram guess?","props":{"kicker":"Pause and predict","question":"In skip-gram, what does the model try to predict?","options":["The next sentence","The neighbours of a word","A word's part of speech"],"answer":1,"explain":"Skip-gram takes the centre word and guesses the words around it."},"start":175.4,"end":189.882,"startFrame":5262,"durationInFrames":462},{"id":"recap","kind":"recap","component":"Recap","short":false,"cues":[{"id":"c29","start":190.8,"end":195.877,"marks":{},"text":"Let's recap. Word2Vec learns word vectors by guessing which words are neighbours.","words":[{"w":"Let's","start":190.8},{"w":"recap.","start":191.16},{"w":"Word2Vec","start":191.4},{"w":"learns","start":191.64},{"w":"word","start":191.88},{"w":"vectors","start":192.96},{"w":"by","start":194.04},{"w":"guessing","start":194.2},{"w":"which","start":194.6},{"w":"words","start":194.8},{"w":"are","start":195.12},{"w":"neighbours.","start":195.28}]},{"id":"c30","start":196.277,"end":199.558,"marks":{},"text":"Th