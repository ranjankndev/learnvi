{"key":"nlp-basics-u2-03","seriesId":"nlp-basics","episode":"u2-03","title":"Chunking: Grouping Words into Phrases","fps":30,"duration":197.309,"durationInFrames":5919,"video":{"width":1920,"height":1080,"burnCaptions":true,"brand":"learnvi.in"},"badge":["UNIT 2 · LESSON 3","CHUNKING"],"series":{"title":"NLP, Simply Explained","subtitle":"University NLP, one idea at a time, no heavy maths","runningPrompt":"","stops":[{"id":"u1-01","number":1,"name":"The Stages of NLP: From Letters to Meaning","stamp":"THE STAGES OF NLP: FROM LETTERS TO MEANING","topic":""},{"id":"u1-02","number":2,"name":"Tokenization: How Text Becomes Pieces","stamp":"TOKENIZATION: HOW TEXT BECOMES PIECES","topic":""},{"id":"u1-03","number":3,"name":"Text Classification: Teaching Computers to Sort Text","stamp":"TEXT CLASSIFICATION: TEACHING COMPUTERS TO SORT TEXT","topic":""},{"id":"u1-04","number":4,"name":"Language Models: Guessing the Next Word","stamp":"LANGUAGE MODELS: GUESSING THE NEXT WORD","topic":""},{"id":"u2-01","number":5,"name":"Morphology: The Building Blocks Inside Words","stamp":"MORPHOLOGY: THE BUILDING BLOCKS INSIDE WORDS","topic":""},{"id":"u2-02","number":6,"name":"Part-of-Speech Tagging: Is It a Noun or a Verb?","stamp":"PART-OF-SPEECH TAGGING: IS IT A NOUN OR A VERB?","topic":""},{"id":"u2-03","number":7,"name":"Chunking: Grouping Words into Phrases","stamp":"CHUNKING: GROUPING WORDS INTO PHRASES","topic":""},{"id":"u2-04","number":8,"name":"Generative vs Discriminative Models","stamp":"GENERATIVE VS DISCRIMINATIVE MODELS","topic":""},{"id":"u2-05","number":9,"name":"Hidden Markov Models, Intuitively","stamp":"HIDDEN MARKOV MODELS, INTUITIVELY","topic":""},{"id":"u2-06","number":10,"name":"Conditional Random Fields, Intuitively","stamp":"CONDITIONAL RANDOM FIELDS, INTUITIVELY","topic":""},{"id":"u3-01","number":11,"name":"Constituency Parsing: Sentences as Trees","stamp":"CONSTITUENCY PARSING: SENTENCES AS TREES","topic":""},{"id":"u3-02","number":12,"name":"Dependency Parsing: Who Did What to Whom","stamp":"DEPENDENCY PARSING: WHO DID WHAT TO WHOM","topic":""},{"id":"u3-03","number":13,"name":"Transition-Based Parsing: Building Trees Step by Step","stamp":"TRANSITION-BASED PARSING: BUILDING TREES STEP BY STEP","topic":""},{"id":"u4-01","number":14,"name":"Word Vectors: Giving Words a Place on a Map","stamp":"WORD VECTORS: GIVING WORDS A PLACE ON A MAP","topic":""},{"id":"u4-02","number":15,"name":"Word2Vec: Learning Word Vectors from Context","stamp":"WORD2VEC: LEARNING WORD VECTORS FROM CONTEXT","topic":""},{"id":"u4-03","number":16,"name":"Recurrent Neural Networks: Reading with Memory","stamp":"RECURRENT NEURAL NETWORKS: READING WITH MEMORY","topic":""},{"id":"u4-04","number":17,"name":"LSTMs: Remembering What Matters","stamp":"LSTMS: REMEMBERING WHAT MATTERS","topic":""},{"id":"u5-01","number":18,"name":"Contextual Embeddings and ELMo","stamp":"CONTEXTUAL EMBEDDINGS AND ELMO","topic":""},{"id":"u5-02","number":19,"name":"BERT: Reading in Both Directions","stamp":"BERT: READING IN BOTH DIRECTIONS","topic":""}]},"stop":{"number":7,"name":"Chunking: Grouping Words into Phrases","stamp":"CHUNKING: GROUPING WORDS INTO PHRASES"},"shorts":{"width":1080,"height":1920,"maxSeconds":60,"cta":"Full lesson: NLP, Simply Explained · Unit 2"},"thumbnail":{"headline":"How AI finds phrases","big":"B · I · O"},"segments":[{"id":"intro","kind":"intro","component":"TitleCard","short":false,"cues":[{"id":"c01","start":0.6,"end":6.208,"marks":{},"text":"Welcome back to NLP, Simply Explained. This is unit 2, lesson 3: chunking.","words":[{"w":"Welcome","start":0.6},{"w":"back","start":1.08},{"w":"to","start":1.413},{"w":"NLP,","start":1.747},{"w":"Simply","start":2.08},{"w":"Explained.","start":2.68},{"w":"This","start":3.44},{"w":"is","start":3.72},{"w":"unit","start":3.92},{"w":"2,","start":4.378},{"w":"lesson","start":4.835},{"w":"3:","start":5.293},{"w":"chunking.","start":5.75}]},{"id":"c02","start":6.608,"end":13.448,"marks":{},"text":"Last time we tagged every word as a noun, a verb, and so on. Today we group those words into small phrases.","words":[{"w":"Last","start":6.608},{"w":"time","start":6.928},{"w":"we","start":7.128},{"w":"tagged","start":7.328},{"w":"every","start":7.728},{"w":"word","start":8.008},{"w":"as","start":8.288},{"w":"a","start":8.448},{"w":"noun,","start":8.568},{"w":"a","start":8.941},{"w":"verb,","start":9.315},{"w":"and","start":9.688},{"w":"so","start":9.928},{"w":"on.","start":10.208},{"w":"Today","start":10.688},{"w":"we","start":11.168},{"w":"group","start":11.368},{"w":"those","start":11.688},{"w":"words","start":11.888},{"w":"into","start":12.208},{"w":"small","start":12.448},{"w":"phrases.","start":12.728}]}],"title":"Welcome","shortTitle":"Welcome","props":{"kicker":"Unit 2 · Lesson 3","title":"Chunking","subtitle":"Grouping words into phrases"},"start":0.6,"end":13.448,"startFrame":0,"durationInFrames":431},{"id":"idea","kind":"core","component":"BigIdea","short":false,"cues":[{"id":"c03","start":14.367,"end":21.646,"marks":{},"text":"Here's the idea. Chunking groups words into small, useful phrases, without working out the full grammar of the sentence.","words":[{"w":"Here's","start":14.367},{"w":"the","start":14.727},{"w":"idea.","start":15.234},{"w":"Chunking","start":15.74},{"w":"groups","start":16.247},{"w":"words","start":16.687},{"w":"into","start":17.007},{"w":"small,","start":17.287},{"w":"useful","start":17.727},{"w":"phrases,","start":18.207},{"w":"without","start":18.967},{"w":"working","start":19.327},{"w":"out","start":19.727},{"w":"the","start":19.887},{"w":"full","start":20.047},{"w":"grammar","start":20.327},{"w":"of","start":20.767},{"w":"the","start":20.887},{"w":"sentence.","start":21.047}]}],"title":"The big idea","shortTitle":"The big idea","props":{"kicker":"Key idea","text":"Chunking groups words into small phrases, without building a full tree.","highlight":["small phrases,"]},"start":14.367,"end":21.646,"startFrame":431,"durationInFrames":246},{"id":"chunk","kind":"core","component":"Definition","short":false,"cues":[{"id":"c04","start":22.567,"end":30.345,"marks":{},"text":"A chunk is a short group of words that acts as one unit, such as a noun phrase. Chunks sit side by side and never overlap.","words":[{"w":"A","start":22.567},{"w":"chunk","start":22.567},{"w":"is","start":23.047},{"w":"a","start":23.207},{"w":"short","start":23.367},{"w":"group","start":23.647},{"w":"of","start":23.887},{"w":"words","start":24.047},{"w":"that","start":24.327},{"w":"acts","start":24.527},{"w":"as","start":24.807},{"w":"one","start":24.967},{"w":"unit,","start":25.207},{"w":"such","start":25.687},{"w":"as","start":25.887},{"w":"a","start":26.047},{"w":"noun","start":26.207},{"w":"phrase.","start":26.624},{"w":"Chunks","start":27.041},{"w":"sit","start":27.458},{"w":"side","start":27.876},{"w":"by","start":28.293},{"w":"side","start":28.71},{"w":"and","start":29.127},{"w":"never","start":29.367},{"w":"overlap.","start":29.727}]},{"id":"c05","start":30.745,"end":37.356,"marks":{},"text":"In \"the big red bus stopped near my old school\", the chunks are: the big red bus, stopped, near, and my old school.","words":[{"w":"In","start":30.745},{"w":"\"the","start":30.865},{"w":"big","start":31.025},{"w":"red","start":31.305},{"w":"bus","start":31.545},{"w":"stopped","start":31.825},{"w":"near","start":32.105},{"w":"my","start":32.345},{"w":"old","start":32.505},{"w":"school\",","start":32.745},{"w":"the","start":33.092},{"w":"chunks","start":33.438},{"w":"are:","start":33.785},{"w":"the","start":34.065},{"w":"big","start":34.265},{"w":"red","start":34.585},{"w":"bus,","start":34.905},{"w":"stopped,","start":35.345},{"w":"near,","start":35.865},{"w":"and","start":36.225},{"w":"my","start":36.425},{"w":"old","start":36.625},{"w":"school.","start":36.905}]},{"id":"c06","start":37.756,"end":46.095,"marks":{},"text":"Think of reading aloud. You naturally group words into bite-sized pieces, one breath at a time, without stopping to diagram the sentence.","words":[{"w":"Think","start":37.756},{"w":"of","start":37.916},{"w":"reading","start":38.076},{"w":"aloud.","start":38.476},{"w":"You","start":39.116},{"w":"naturally","start":39.356},{"w":"group","start":39.956},{"w":"words","start":40.356},{"w":"into","start":40.676},{"w":"bite-sized","start":41.176},{"w":"pieces,","start":41.676},{"w":"one","start":42.316},{"w":"breath","start":42.556},{"w":"at","start":42.956},{"w":"a","start":43.116},{"w":"time,","start":43.276},{"w":"without","start":43.676},{"w":"stopping","start":44.076},{"w":"to","start":44.476},{"w":"diagram","start":44.716},{"w":"the","start":45.316},{"w":"sentence.","start":45.516}]}],"title":"What is a chunk?","shortTitle":"What is a chunk?","props":{"kicker":"Definition","term":"Chunk","definition":"A short group of words that acts as one unit, such as a noun phrase. Chunks never overlap.","example":"[the big red bus] [stopped] [near] [my old school]","analogy":"Reading aloud in breaths: you group words into bite-sized pieces without diagramming the sentence."},"start":22.567,"end":46.095,"startFrame":677,"durationInFrames":733},{"id":"types","kind":"core","component":"Table","short":false,"cues":[{"id":"c07","start":47,"end":49.959,"marks":{},"text":"Each chunk gets a type. Let's label our sentence.","words":[{"w":"Each","start":47.213},{"w":"chunk","start":47.427},{"w":"gets","start":47.64},{"w":"a","start":47.88},{"w":"type.","start":48},{"w":"Let's","start":48.44},{"w":"label","start":48.8},{"w":"our","start":49.16},{"w":"sentence.","start":49.36}]},{"id":"c08","start":50.359,"end":56.06,"marks":{},"text":"The big red bus is a noun phrase, NP for short: a noun with the words that describe it.","words":[{"w":"The","start":50.359},{"w":"big","start":50.519},{"w":"red","start":50.759},{"w":"bus","start":50.999},{"w":"is","start":51.319},{"w":"a","start":51.479},{"w":"noun","start":51.599},{"w":"phrase,","start":51.919},{"w":"NP","start":52.459},{"w":"for","start":52.999},{"w":"short:","start":53.279},{"w":"a","start":53.879},{"w":"noun","start":54.079},{"w":"with","start":54.479},{"w":"the","start":54.639},{"w":"words","start":54.799},{"w":"that","start":55.119},{"w":"describe","start":55.319},{"w":"it.","start":55.879}]},{"id":"c09","start":56.46,"end":58.551,"marks":{},"text":"Stopped is a verb phrase, VP.","words":[{"w":"Stopped","start":56.46},{"w":"is","start":56.7},{"w":"a","start":56.94},{"w":"verb","start":57.18},{"w":"phrase,","start":57.42},{"w":"VP.","start":57.986}]},{"id":"c10","start":58.951,"end":62.406,"marks":{},"text":"Near is a preposition, which links the bus to where it stopped.","words":[{"w":"Near","start":58.951},{"w":"is","start":59.311},{"w":"a","start":59.471},{"w":"preposition,","start":59.591},{"w":"which","start":60.351},{"w":"links","start":60.631},{"w":"the","start":60.991},{"w":"bus","start":61.151},{"w":"to","start":61.391},{"w":"where","start":61.591},{"w":"it","start":61.751},{"w":"stopped.","start":61.951}]},{"id":"c11","start":62.806,"end":65.221,"marks":{},"text":"And my old school is another noun phrase.","words":[{"w":"And","start":62.806},{"w":"my","start":62.926},{"w":"old","start":63.086},{"w":"school","start":63.366},{"w":"is","start":63.766},{"w":"another","start":63.966},{"w":"noun","start":64.326},{"w":"phrase.","start":64.646}]}],"title":"Kinds of chunks","shortTitle":"Kinds of chunks","props":{"kicker":"Worked example","title":"“The big red bus stopped near my old school”","columns":["Chunk","Type"],"rows":[["The big red bus","NP · noun phrase"],["stopped","VP · verb phrase"],["near","PP · preposition"],["my old school","NP · noun phrase"]],"highlight":[{"row":0},{"row":3}]},"start":47,"end":65.221,"startFrame":1410,"durationInFrames":574},{"id":"bio","kind":"core","component":"Bullets","short":false,"cues":[{"id":"c12","start":66.133,"end":73.154,"marks":{},"text":"Here's a clever trick. We can turn chunking into a tagging job, just like part-of-speech tagging, using three letters.","words":[{"w":"Here's","start":66.133},{"w":"a","start":66.453},{"w":"clever","start":66.573},{"w":"trick.","start":66.933},{"w":"We","start":67.413},{"w":"can","start":67.653},{"w":"turn","start":67.973},{"w":"chunking","start":68.293},{"w":"into","start":68.613},{"w":"a","start":68.813},{"w":"tagging","start":68.933},{"w":"job,","start":69.413},{"w":"just","start":69.893},{"w":"like","start":70.213},{"w":"part-of-speech","start":70.793},{"w":"tagging,","start":71.373},{"w":"using","start":71.893},{"w":"three","start":72.293},{"w":"letters.","start":72.573}]},{"id":"c13","start":73.554,"end":75.424,"marks":{},"text":"B means this word begins a chunk.","words":[{"w":"B","start":73.654},{"w":"means","start":73.754},{"w":"this","start":74.034},{"w":"word","start":74.274},{"w":"begins","start":74.514},{"w":"a","start":74.694},{"w":"chunk.","start":74.874}]},{"id":"c14","start":75.824,"end":79.141,"marks":{},"text":"I means this word is inside the chunk that's already started.","words":[{"w":"I","start":75.824},{"w":"means","start":75.984},{"w":"this","start":76.304},{"w":"word","start":76.584},{"w":"is","start":76.824},{"w":"inside","start":77.024},{"w":"the","start":77.344},{"w":"chunk","start":77.664},{"w":"that's","start":77.984},{"w":"already","start":78.264},{"w":"started.","start":78.664}]},{"id":"c15","start":79.541,"end":83.099,"marks":{},"text":"And O means the word is outside any chunk, like a full stop.","words":[{"w":"And","start":79.541},{"w":"O","start":79.761},{"w":"means","start":79.981},{"w":"the","start":80.301},{"w":"word","start":80.421},{"w":"is","start":80.661},{"w":"outside","start":80.821},{"w":"any","start":81.208},{"w":"chunk,","start":81.594},{"w":"like","start":81.981},{"w":"a","start":82.181},{"w":"full","start":82.341},{"w":"stop.","start":82.621}]}],"title":"BIO tags","shortTitle":"BIO tags","props":{"kicker":"A clever trick","title":"Turn chunking into tagging with B, I and O","items":[{"text":"B: this word begins a chunk"},{"text":"I: this word is inside a chunk"},{"text":"O: this word is outside any chunk"}],"numbered":false},"start":66.133,"end":83.099,"startFrame":1984,"durationInFrames":536},{"id":"tagged","kind":"core","component":"Table","short":true,"cues":[{"id":"c16","start":84,"end":87.976,"marks":{},"text":"Let's tag a short sentence: \"The big bus stopped\", with a full stop.","words":[{"w":"Let's","start":84},{"w":"tag","start":84.32},{"w":"a","start":84.56},{"w":"short","start":84.68},{"w":"sentence:","start":84.96},{"w":"\"The","start":85.56},{"w":"big","start":85.84},{"w":"bus","start":86.16},{"w":"stopped\",","start":86.48},{"w":"with","start":86.92},{"w":"a","start":87.08},{"w":"full","start":87.2},{"w":"stop.","start":87.52}]},{"id":"c17","start":88.376,"end":91.338,"marks":{},"text":"The begins a noun phrase, so it's B-NP.","words":[{"w":"The","start":88.376},{"w":"begins","start":88.376},{"w":"a","start":88.856},{"w":"noun","start":88.976},{"w":"phrase,","start":89.256},{"w":"so","start":89.776},{"w":"it's","start":89.976},{"w":"B-NP.","start":90.657}]},{"id":"c18","start":91.738,"end":94.83,"marks":{},"text":"Big is inside that noun phrase: I-NP.","words":[{"w":"Big","start":91.738},{"w":"is","start":91.938},{"w":"inside","start":92.138},{"w":"that","start":92.538},{"w":"noun","start":92.698},{"w":"phrase:","start":92.978},{"w":"I-NP.","start":93.904}]},{"id":"c19","start":95.23,"end":97.78,"marks":{},"text":"Bus is still inside it: I-NP.","words":[{"w":"Bus","start":95.23},{"w":"is","start":95.51},{"w":"still","start":95.63},{"w":"inside","start":95.87},{"w":"it:","start":96.31},{"w":"I-NP.","start":97.045}]},{"id":"c20","start":98.18,"end":101.07,"marks":{},"text":"Stopped begins a verb phrase: B-VP.","words":[{"w":"Stopped","start":98.18},{"w":"begins","start":98.58},{"w":"a","start":98.847},{"w":"verb","start":99.113},{"w":"phrase:","start":99.38},{"w":"B-VP.","start":100.225}]},{"id":"c21","start":101.47,"end":104.745,"marks":{},"text":"And the full stop is outside every chunk, so it gets O.","words":[{"w":"And","start":101.47},{"w":"the","start":101.59},{"w":"full","start":101.71},{"w":"stop","start":101.95},{"w":"is","start":102.31},{"w":"outside","start":102.51},{"w":"every","start":102.923},{"w":"chunk,","start":103.337},{"w":"so","start":103.75},{"w":"it","start":103.99},{"w":"gets","start":104.15},{"w":"O.","start":104.47}]}],"title":"A BIO-tagged sentence","shortTitle":"BIO tags: how AI finds phrases","props":{"kicker":"BIO in action","title":"“The big bus stopped .”","columns":["Word","BIO tag"],"rows":[["The","B-NP"],["big","I-NP"],["bus","I-NP"],["stopped","B-VP"],[".","O"]],"highlight":[{"row":0,"col":1},{"row":3,"col":1}]},"start":84,"end":104.745,"startFrame":2520,"durationInFrames":650},{"id":"how","kind":"core","component":"Compare","short":false,"cues":[{"id":"c22","start":105.667,"end":107.449,"marks":{},"text":"There are two ways to build a chunker.","words":[{"w":"There","start":105.667},{"w":"are","start":105.827},{"w":"two","start":105.947},{"w":"ways","start":106.147},{"w":"to","start":106.387},{"w":"build","start":106.547},{"w":"a","start":106.667},{"w":"chunker.","start":106.787}]},{"id":"c23","start":107.849,"end":120.861,"marks":{},"text":"A rule-based chunker uses patterns over part-of-speech tags. For example: a determiner, then any adjectives, then a noun, makes a noun phrase. It's easy to read, but real text often breaks the rules.","words":[{"w":"A","start":107.849},{"w":"rule-based","start":108.276},{"w":"chunker","start":108.702},{"w":"uses","start":109.129},{"w":"patterns","start":109.489},{"w":"over","start":110.049},{"w":"part-of-speech","start":110.589},{"w":"tags.","start":111.129},{"w":"For","start":111.769},{"w":"example:","start":112.049},{"w":"a","start":112.769},{"w":"determiner,","start":112.969},{"w":"then","start":113.429},{"w":"any","start":113.889},{"w":"adjectives,","start":114.129},{"w":"then","start":114.569},{"w":"a","start":115.009},{"w":"noun,","start":115.169},{"w":"makes","start":115.609},{"w":"a","start":115.889},{"w":"noun","start":116.009},{"w":"phrase.","start":116.369},{"w":"It's","start":117.089},{"w":"easy","start":117.489},{"w":"to","start":117.889},{"w":"read,","start":118.089},{"w":"but","start":118.449},{"w":"real","start":118.729},{"w":"text","start":119.049},{"w":"often","start":119.569},{"w":"breaks","start":119.849},{"w":"the","start":120.249},{"w":"rules.","start":120.409}]},{"id":"c24","start":121.261,"end":132.27,"marks":{},"text":"A learned chunker is a tagger that predicts B, I and O for each word, using many clues at once. It needs labelled examples to learn from, and today it's the usual choice.","words":[{"w":"A","start":121.261},{"w":"learned","start":121.594},{"w":"chunker","start":121.928},{"w":"is","start":122.261},{"w":"a","start":122.381},{"w":"tagger","start":122.541},{"w":"that","start":122.901},{"w":"predicts","start":123.101},{"w":"B,","start":123.781},{"w":"I","start":124.061},{"w":"and","start":124.381},{"w":"O","start":124.621},{"w":"for","start":124.941},{"w":"each","start":125.141},{"w":"word,","start":125.501},{"w":"using","start":125.821},{"w":"many","start":126.261},{"w":"clues","start":126.541},{"w":"at","start":126.941},{"w":"once.","start":127.181},{"w":"It","start":127.661},{"w":"needs","start":127.981},{"w":"labelled","start":128.381},{"w":"examples","start":128.861},{"w":"to","start":129.461},{"w":"learn","start":129.621},{"w":"from,","start":129.941},{"w":"and","start":130.181},{"w":"today","start":130.521},{"w":"it's","start":130.861},{"w":"the","start":131.141},{"w":"usual","start":131.341},{"w":"choice.","start":131.781}]}],"title":"Two ways to chunk","shortTitle":"Two ways to chunk","props":{"kicker":"Two approaches","title":"Rules or learning?","columns":[{"title":"Rule-based","items":["patterns over POS tags","DET + ADJ + NOUN = NP","easy to read, easy to break"],"tone":"neutral"},{"title":"Learned","items":["a tagger predicts B, I, O","uses many clues at once","needs labelled examples"],"tone":"good"}],"verdict":{"text":"Either way, chunking becomes tagging"}},"start":105.667,"end":132.27,"startFrame":3170,"durationInFrames":826},{"id":"uses","kind":"core","component":"Bullets","short":false,"cues":[{"id":"c25","start":133.2,"end":134.7,"marks":{},"text":"So what are chunks good for?","words":[{"w":"So","start":133.2},{"w":"what","start":133.36},{"w":"are","start":133.627},{"w":"chunks","start":133.893},{"w":"good","start":134.16},{"w":"for?","start":134.44}]},{"id":"c26","start":135.1,"end":140.796,"marks":{},"text":"They find the things a text talks about: people, places and products are usually noun phrases.","words":[{"w":"They","start":135.1},{"w":"find","start":135.26},{"w":"the","start":135.5},{"w":"things","start":135.62},{"w":"a","start":135.86},{"w":"text","start":136.02},{"w":"talks","start":136.42},{"w":"about:","start":136.78},{"w":"people,","start":137.34},{"w":"places","start":137.98},{"w":"and","start":138.5},{"w":"products","start":138.7},{"w":"are","start":139.18},{"w":"usually","start":139.34},{"w":"noun","start":139.78},{"w":"phrases.","start":140.1}]},{"id":"c27","start":141.196,"end":145.787,"marks":{},"text":"They help pull out simple facts. Apple, bought, a startup: who did what to what.","words":[{"w":"They","start":141.196},{"w":"help","start":141.356},{"w":"pull","start":141.596},{"w":"out","start":141.836},{"w":"simple","start":142.036},{"w":"facts.","start":142.476},{"w":"Apple,","start":143.116},{"w":"bought,","start":143.676},{"w":"a","start":143.996},{"w":"startup:","start":144.356},{"w":"who","start":144.716},{"w":"did","start":144.916},{"w":"what","start":145.116},{"w":"to","start":145.276},{"w":"what.","start":145.516}]},{"id":"c28","start":146.187,"end":153.596,"marks":{},"text":"And they're a quick first step towards full parsing, which builds the complete structure of a sentence. That's coming up in unit three.","words":[{"w":"And","start":146.187},{"w":"they're","start":146.267},{"w":"a","start":146.387},{"w":"quick","start":146.507},{"w":"first","start":146.947},{"w":"step","start":147.147},{"w":"towards","start":147.467},{"w":"full","start":147.947},{"w":"parsing,","start":148.227},{"w":"which","start":148.827},{"w":"builds","start":149.067},{"w":"the","start":149.547},{"w":"complete","start":149.707},{"w":"structure","start":150.227},{"w":"of","start":150.707},{"w":"a","start":150.827},{"w":"sentence.","start":150.987},{"w":"That's","start":151.747},{"w":"coming","start":152.187},{"w":"up","start":152.507},{"w":"in","start":152.667},{"w":"unit","start":152.827},{"w":"three.","start":153.227}]}],"title":"Why chunk?","shortTitle":"Why chunk?","props":{"kicker":"Why it matters","title":"What chunks are good for","items":[{"text":"Find the things a text talks about"},{"text":"Pull out simple facts: [Apple] [bought] [a startup]"},{"text":"A quick first step towards full parsing"}],"numbered":false},"start":133.2,"end":153.596,"startFrame":3996,"durationInFrames":639},{"id":"quiz","kind":"quiz","component":"Quiz","short":true,"cues":[{"id":"c29","start":154.5,"end":159.666,"marks":{},"text":"Quick quiz. In BIO tagging, which tag does the word red get, in \"the big red bus\"?","words":[{"w":"Quick","start":154.74},{"w":"quiz.","start":154.98},{"w":"In","start":155.22},{"w":"BIO","start":155.46},{"w":"tagging,","start":155.9},{"w":"which","start":156.46},{"w":"tag","start":156.7},{"w":"does","start":156.98},{"w":"the","start":157.26},{"w":"word","start":157.38},{"w":"red","start":157.62},{"w":"get,","start":157.94},{"w":"in","start":158.26},{"w":"\"the","start":158.46},{"w":"big","start":158.62},{"w":"red","start":158.94},{"w":"bus\"?","start":159.22}]},{"id":"c30","start":160.066,"end":161.586,"marks":{},"text":"Pause the video and choose.","words":[{"w":"Pause","start":160.066},{"w":"the","start":160.346},{"w":"video","start":160.606},{"w":"and","start":160.866},{"w":"choose.","start":161.066}]},{"id":"c31","start":164.986,"end":171.236,"marks":{},"text":"It's I-NP. The word \"the\" begins the noun phrase, and big, red and bus are all inside it.","words":[{"w":"It's","start":164.986},{"w":"I-NP.","start":165.686},{"w":"The","start":166.386},{"w":"word","start":166.706},{"w":"\"the\"","start":166.926},{"w":"begins","start":167.146},{"w":"the","start":167.586},{"w":"noun","start":167.706},{"w":"phrase,","start":168.026},{"w":"and","start":168.626},{"w":"big,","start":168.866},{"w":"red","start":169.306},{"w":"and","start":169.626},{"w":"bus","start":169.786},{"w":"are","start":170.146},{"w":"all","start":170.346},{"w":"inside","start":170.546},{"w":"it.","start":171.026}]}],"title":"Quick quiz","shortTitle":"Quick quiz: B, I or O?","props":{"kicker":"Pause and predict","question":"In BIO tagging, which tag does “red” get in “the big red bus”?","options":["B-NP","I-NP","O"],"answer":1,"explain":"“The” begins the noun phrase; “big”, “red” and “bus” are inside it."},"start":154.5,"end":171.236,"startFrame":4635,"durationInFrames":530},{"id":"recap","kind":"recap","component":"Recap","short":false,"cues":[{"id":"c32","start":172.167,"end":176.43,"marks":{},"text":"Let's recap. A chunk is a short group of words that acts as one unit.","words":[{"w":"Let's","start":172.167},{"w":"recap.","start":172.567},{"w":"A","start":172.887},{"w":"chunk","start":173.207},{"w":"is","start":173.847},{"w":"a","start":174.007},{"w":"short","start":174.167},{"w":"group","start":174.407},{"w":"of","start":174.647},{"w":"words","start":174.767},{"w":"that","start":175.087},{"w":"acts","start":175.287},{"w":"as","start":175.567},{"w":"one","start":175.767},{"w":"unit.","start":176.007}]},{"id":"c33","start":176.83,"end":179.748,"marks":{},"text":"The most common are noun phrases and verb phrases.","words":[{"w":"The","start":176.83},{"w":"most","start":176.95},{"w":"common","start":177.15},{"w":"are","start":177.55},{"w":"noun","start":177.71},{"w":"phrases","start":178.03},{"w":"and","start":178.39},{"w":"verb","start":178.75},{"w":"phrases.","start":179.11}]},{"id":"c34","start":180.148,"end":183.348,"marks":{},"text":"B, I and O tags turn chunking into a tagging job.","words":[{"w":"B,","start":180.148},{"w":"I","start":180.468},{"w":"and","start":180.708},{"w":"O","start":180.948},{"w":"tags","start":181.108},{"w":"turn","start":181.481},{"w":"chunking","start":181.855},{"w":"into","start":182.228},{"w":"a","start":182.388},{"w":"tagging","start":182.548},{"w":"job.","start":182.948}]},{"id":"c35","start":183.748,"end":188.033,"marks":{},"text":"And chunks help find the things a text talks about, and simple facts about them.","words":[{"w":"And","start":183.935},{"w":"chunks","start":184.121},{"w":"help","start":184.308},{"w":"find","start":184.588},{"w":"the","start":184.828},{"w":"things","start":184.948},{"w":"a","start":185.188},{"w":"text","start":185.308},{"w":"talks","start":185.708},{"w":"about,","start":186.068},{"w":"and","start":186.388},{"w":"simple","start":186.628},{"w":"facts","start":187.108},{"w":"about","start":187.508},{"w":"them.","start":187.788}]},{"id":"c36","start":188.433,"end":195.809,"marks":{},"text":"Next lesson: Generative vs Discriminative. Should a model learn how data is made, or just where the boundary is?","words":[{"w":"Next","start":188.753},{"w":"lesson:","start":189.073},{"w":"Generative","start":189.393},{"w":"vs","start":189.993},{"w":"Discriminative.","start":190.593},{"w":"Should","start":191.713},{"w":"a","start":191.953},{"w":"model","start":192.113},{"w":"learn","start":192.513},{"w":"how","start":192.793},{"w":"data","start":192.993},{"w":"is","start":193.473},{"w":"made,","start":193.673},{"w":"or","start":194.033},{"w":"just","start":194.273},{"w":"where","start":194.593},{"w":"the","start":194.753},{"w":"boundary","start":194.913},{"w":"is?","start":195.473}]}],"title":"Recap and next lesson","shortTitle":"Recap and next lesson","props":{"title":"Recap","points":["A chunk is a short phrase that acts as one unit","Noun phrases, verb phrases and more","BIO tags turn chunking i