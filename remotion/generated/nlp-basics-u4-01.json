{"key":"nlp-basics-u4-01","seriesId":"nlp-basics","episode":"u4-01","title":"Word Vectors: Giving Words a Place on a Map","fps":30,"duration":222.063,"durationInFrames":6662,"video":{"width":1920,"height":1080,"burnCaptions":true,"brand":"learnvi.in"},"badge":["UNIT 4 · LESSON 1","WORD VECTORS"],"series":{"title":"NLP, Simply Explained","subtitle":"University NLP, one idea at a time, no heavy maths","runningPrompt":"","stops":[{"id":"u1-01","number":1,"name":"The Stages of NLP: From Letters to Meaning","stamp":"THE STAGES OF NLP: FROM LETTERS TO MEANING","topic":""},{"id":"u1-02","number":2,"name":"Tokenization: How Text Becomes Pieces","stamp":"TOKENIZATION: HOW TEXT BECOMES PIECES","topic":""},{"id":"u1-03","number":3,"name":"Text Classification: Teaching Computers to Sort Text","stamp":"TEXT CLASSIFICATION: TEACHING COMPUTERS TO SORT TEXT","topic":""},{"id":"u1-04","number":4,"name":"Language Models: Guessing the Next Word","stamp":"LANGUAGE MODELS: GUESSING THE NEXT WORD","topic":""},{"id":"u2-01","number":5,"name":"Morphology: The Building Blocks Inside Words","stamp":"MORPHOLOGY: THE BUILDING BLOCKS INSIDE WORDS","topic":""},{"id":"u2-02","number":6,"name":"Part-of-Speech Tagging: Is It a Noun or a Verb?","stamp":"PART-OF-SPEECH TAGGING: IS IT A NOUN OR A VERB?","topic":""},{"id":"u2-03","number":7,"name":"Chunking: Grouping Words into Phrases","stamp":"CHUNKING: GROUPING WORDS INTO PHRASES","topic":""},{"id":"u2-04","number":8,"name":"Generative vs Discriminative Models","stamp":"GENERATIVE VS DISCRIMINATIVE MODELS","topic":""},{"id":"u2-05","number":9,"name":"Hidden Markov Models, Intuitively","stamp":"HIDDEN MARKOV MODELS, INTUITIVELY","topic":""},{"id":"u2-06","number":10,"name":"Conditional Random Fields, Intuitively","stamp":"CONDITIONAL RANDOM FIELDS, INTUITIVELY","topic":""},{"id":"u3-01","number":11,"name":"Constituency Parsing: Sentences as Trees","stamp":"CONSTITUENCY PARSING: SENTENCES AS TREES","topic":""},{"id":"u3-02","number":12,"name":"Dependency Parsing: Who Did What to Whom","stamp":"DEPENDENCY PARSING: WHO DID WHAT TO WHOM","topic":""},{"id":"u3-03","number":13,"name":"Transition-Based Parsing: Building Trees Step by Step","stamp":"TRANSITION-BASED PARSING: BUILDING TREES STEP BY STEP","topic":""},{"id":"u4-01","number":14,"name":"Word Vectors: Giving Words a Place on a Map","stamp":"WORD VECTORS: GIVING WORDS A PLACE ON A MAP","topic":""},{"id":"u4-02","number":15,"name":"Word2Vec: Learning Word Vectors from Context","stamp":"WORD2VEC: LEARNING WORD VECTORS FROM CONTEXT","topic":""},{"id":"u4-03","number":16,"name":"Recurrent Neural Networks: Reading with Memory","stamp":"RECURRENT NEURAL NETWORKS: READING WITH MEMORY","topic":""},{"id":"u4-04","number":17,"name":"LSTMs: Remembering What Matters","stamp":"LSTMS: REMEMBERING WHAT MATTERS","topic":""},{"id":"u5-01","number":18,"name":"Contextual Embeddings and ELMo","stamp":"CONTEXTUAL EMBEDDINGS AND ELMO","topic":""},{"id":"u5-02","number":19,"name":"BERT: Reading in Both Directions","stamp":"BERT: READING IN BOTH DIRECTIONS","topic":""}]},"stop":{"number":14,"name":"Word Vectors: Giving Words a Place on a Map","stamp":"WORD VECTORS: GIVING WORDS A PLACE ON A MAP"},"shorts":{"width":1080,"height":1920,"maxSeconds":60,"cta":"Full lesson: NLP, Simply Explained · Unit 4"},"thumbnail":{"headline":"Words have addresses too","big":"king − man + woman"},"segments":[{"id":"intro","kind":"intro","component":"TitleCard","short":false,"cues":[{"id":"c01","start":0.6,"end":6.548,"marks":{},"text":"Welcome back to NLP, Simply Explained. This is unit 4, lesson 1: word vectors.","words":[{"w":"Welcome","start":0.6},{"w":"back","start":1.08},{"w":"to","start":1.427},{"w":"NLP,","start":1.773},{"w":"Simply","start":2.12},{"w":"Explained.","start":2.68},{"w":"This","start":3.48},{"w":"is","start":3.72},{"w":"unit","start":3.96},{"w":"4,","start":4.347},{"w":"lesson","start":4.733},{"w":"1:","start":5.12},{"w":"word","start":5.596},{"w":"vectors.","start":6.072}]},{"id":"c02","start":6.948,"end":14.85,"marks":{},"text":"So far, a word has just been a token with an ID number. Today we give each word something richer: a place on a map of meaning.","words":[{"w":"So","start":6.948},{"w":"far,","start":7.228},{"w":"a","start":7.588},{"w":"word","start":7.828},{"w":"has","start":8.108},{"w":"just","start":8.308},{"w":"been","start":8.508},{"w":"a","start":8.668},{"w":"token","start":8.788},{"w":"with","start":9.228},{"w":"an","start":9.388},{"w":"ID","start":9.808},{"w":"number.","start":10.228},{"w":"Today","start":10.648},{"w":"we","start":11.068},{"w":"give","start":11.348},{"w":"each","start":11.548},{"w":"word","start":11.868},{"w":"something","start":12.148},{"w":"richer:","start":12.548},{"w":"a","start":13.148},{"w":"place","start":13.388},{"w":"on","start":13.708},{"w":"a","start":13.868},{"w":"map","start":13.988},{"w":"of","start":14.228},{"w":"meaning.","start":14.428}]}],"title":"Welcome","shortTitle":"Welcome","props":{"kicker":"Unit 4 · Lesson 1","title":"Word Vectors","subtitle":"Giving words a place on a map"},"start":0.6,"end":14.85,"startFrame":0,"durationInFrames":473},{"id":"idea","kind":"core","component":"BigIdea","short":false,"cues":[{"id":"c03","start":15.767,"end":25.108,"marks":{},"text":"This lesson rests on one old idea, from the linguist J. R. Firth in 1957. You shall know a word by the company it keeps.","words":[{"w":"This","start":15.967},{"w":"lesson","start":16.167},{"w":"rests","start":16.367},{"w":"on","start":16.807},{"w":"one","start":17.007},{"w":"old","start":17.247},{"w":"idea,","start":17.527},{"w":"from","start":18.087},{"w":"the","start":18.247},{"w":"linguist","start":18.759},{"w":"J.","start":19.271},{"w":"R.","start":19.783},{"w":"Firth","start":20.295},{"w":"in","start":20.807},{"w":"1957.","start":20.977},{"w":"You","start":22.647},{"w":"shall","start":22.807},{"w":"know","start":23.047},{"w":"a","start":23.287},{"w":"word","start":23.447},{"w":"by","start":23.687},{"w":"the","start":23.847},{"w":"company","start":24.007},{"w":"it","start":24.487},{"w":"keeps.","start":24.687}]}],"title":"The big idea","shortTitle":"The big idea","props":{"kicker":"Key idea · J. R. Firth, 1957","text":"You shall know a word by the company it keeps.","highlight":["company"]},"start":15.767,"end":25.108,"startFrame":473,"durationInFrames":308},{"id":"vector","kind":"core","component":"Definition","short":false,"cues":[{"id":"c04","start":26.033,"end":34.227,"marks":{},"text":"A word vector is a list of numbers that places a word somewhere in a space of meaning. Words with similar meanings end up close together.","words":[{"w":"A","start":26.033},{"w":"word","start":26.326},{"w":"vector","start":26.62},{"w":"is","start":26.913},{"w":"a","start":27.073},{"w":"list","start":27.193},{"w":"of","start":27.486},{"w":"numbers","start":27.78},{"w":"that","start":28.073},{"w":"places","start":28.313},{"w":"a","start":28.713},{"w":"word","start":28.873},{"w":"somewhere","start":29.193},{"w":"in","start":29.753},{"w":"a","start":29.913},{"w":"space","start":30.033},{"w":"of","start":30.353},{"w":"meaning.","start":30.513},{"w":"Words","start":31.273},{"w":"with","start":31.793},{"w":"similar","start":31.953},{"w":"meanings","start":32.473},{"w":"end","start":32.953},{"w":"up","start":33.233},{"w":"close","start":33.433},{"w":"together.","start":33.753}]},{"id":"c05","start":34.627,"end":43.146,"marks":{},"text":"For example, the word rain might become a list of a few hundred numbers. On their own, the numbers mean little. What matters is where they put the word.","words":[{"w":"For","start":34.627},{"w":"example,","start":34.787},{"w":"the","start":35.347},{"w":"word","start":35.587},{"w":"rain","start":35.887},{"w":"might","start":36.187},{"w":"become","start":36.387},{"w":"a","start":36.707},{"w":"list","start":36.867},{"w":"of","start":37.107},{"w":"a","start":37.267},{"w":"few","start":37.347},{"w":"hundred","start":37.8},{"w":"numbers.","start":38.254},{"w":"On","start":38.707},{"w":"their","start":38.907},{"w":"own,","start":39.187},{"w":"the","start":39.547},{"w":"numbers","start":39.907},{"w":"mean","start":40.267},{"w":"little.","start":40.587},{"w":"What","start":41.107},{"w":"matters","start":41.427},{"w":"is","start":41.907},{"w":"where","start":42.147},{"w":"they","start":42.307},{"w":"put","start":42.467},{"w":"the","start":42.667},{"w":"word.","start":42.867}]},{"id":"c06","start":43.546,"end":51.671,"marks":{},"text":"Think of a map. Two towns that are close together usually share a lot: weather, food, accent. Word vectors do the same for words.","words":[{"w":"Think","start":43.546},{"w":"of","start":43.786},{"w":"a","start":43.906},{"w":"map.","start":44.066},{"w":"Two","start":44.546},{"w":"towns","start":44.826},{"w":"that","start":45.266},{"w":"are","start":45.426},{"w":"close","start":45.586},{"w":"together","start":45.866},{"w":"usually","start":46.346},{"w":"share","start":46.746},{"w":"a","start":47.026},{"w":"lot:","start":47.186},{"w":"weather,","start":47.626},{"w":"food,","start":48.066},{"w":"accent.","start":48.666},{"w":"Word","start":49.239},{"w":"vectors","start":49.813},{"w":"do","start":50.386},{"w":"the","start":50.586},{"w":"same","start":50.746},{"w":"for","start":50.986},{"w":"words.","start":51.226}]}],"title":"What is a word vector?","shortTitle":"What is a word vector?","props":{"kicker":"Definition","term":"Word vector","definition":"A list of numbers that places a word in a space of meaning, so similar words sit close together.","example":"rain → [0.8, 0.1, 0.6, …]","analogy":"A map: towns that are close together have a lot in common."},"start":26.033,"end":51.671,"startFrame":781,"durationInFrames":797},{"id":"counts","kind":"core","component":"Table","short":false,"cues":[{"id":"c07","start":52.6,"end":62.293,"marks":{},"text":"The simplest way to build these vectors is to count. For each word, we count which other words appear near it in lots of text. Here's a tiny made-up example.","words":[{"w":"The","start":52.6},{"w":"simplest","start":52.76},{"w":"way","start":53.36},{"w":"to","start":53.52},{"w":"build","start":53.68},{"w":"these","start":54.067},{"w":"vectors","start":54.453},{"w":"is","start":54.84},{"w":"to","start":55.04},{"w":"count.","start":55.24},{"w":"For","start":55.76},{"w":"each","start":56.04},{"w":"word,","start":56.44},{"w":"we","start":56.84},{"w":"count","start":57.12},{"w":"which","start":57.44},{"w":"other","start":57.64},{"w":"words","start":57.92},{"w":"appear","start":58.24},{"w":"near","start":58.52},{"w":"it","start":58.8},{"w":"in","start":58.96},{"w":"lots","start":59.12},{"w":"of","start":59.44},{"w":"text.","start":59.6},{"w":"Here's","start":60.12},{"w":"a","start":60.64},{"w":"tiny","start":60.8},{"w":"made-up","start":61.26},{"w":"example.","start":61.72}]},{"id":"c08","start":62.693,"end":66.267,"marks":{},"text":"Rain often appears near wet and cloud, and never near bark.","words":[{"w":"Rain","start":62.693},{"w":"often","start":63.053},{"w":"appears","start":63.413},{"w":"near","start":63.813},{"w":"wet","start":64.013},{"w":"and","start":64.233},{"w":"cloud,","start":64.453},{"w":"and","start":64.933},{"w":"never","start":65.173},{"w":"near","start":65.493},{"w":"bark.","start":65.773}]},{"id":"c09","start":66.667,"end":75.543,"marks":{},"text":"Storm looks almost the same: wet, cloud, no bark. So the rows for rain and storm are similar, and that similarity is the meaning we're after.","words":[{"w":"Storm","start":66.667},{"w":"looks","start":67.107},{"w":"almost","start":67.467},{"w":"the","start":67.827},{"w":"same:","start":67.987},{"w":"wet,","start":68.547},{"w":"cloud,","start":69.067},{"w":"no","start":69.547},{"w":"bark.","start":69.787},{"w":"So","start":70.347},{"w":"the","start":70.587},{"w":"rows","start":70.787},{"w":"for","start":71.147},{"w":"rain","start":71.347},{"w":"and","start":71.707},{"w":"storm","start":71.867},{"w":"are","start":72.307},{"w":"similar,","start":72.427},{"w":"and","start":72.987},{"w":"that","start":73.187},{"w":"similarity","start":73.387},{"w":"is","start":74.187},{"w":"the","start":74.347},{"w":"meaning","start":74.507},{"w":"we're","start":74.852},{"w":"after.","start":75.198}]},{"id":"c10","start":75.943,"end":80.047,"marks":{},"text":"Dog is different. It appears near bark, and hardly ever near cloud.","words":[{"w":"Dog","start":75.943},{"w":"is","start":76.383},{"w":"different.","start":76.583},{"w":"It","start":77.143},{"w":"appears","start":77.343},{"w":"near","start":77.743},{"w":"bark,","start":78.023},{"w":"and","start":78.423},{"w":"hardly","start":78.583},{"w":"ever","start":78.983},{"w":"near","start":79.263},{"w":"cloud.","start":79.543}]}],"title":"Counting the company","shortTitle":"Counting the company","props":{"kicker":"Example counts","title":"How often each word appears near…","columns":["Word","wet","cloud","bark"],"rows":[["rain","8","6","0"],["storm","6","7","0"],["dog","1","0","9"]],"highlight":[{"row":0},{"row":1}]},"start":52.6,"end":80.047,"startFrame":1578,"durationInFrames":851},{"id":"build","kind":"core","component":"Steps","short":false,"cues":[{"id":"c11","start":80.967,"end":86.909,"marks":{},"text":"Real tables are huge, with tens of thousands of columns. So we build vectors in three steps.","words":[{"w":"Real","start":80.967},{"w":"tables","start":81.367},{"w":"are","start":81.887},{"w":"huge,","start":82.127},{"w":"with","start":82.567},{"w":"tens","start":82.807},{"w":"of","start":83.167},{"w":"thousands","start":83.367},{"w":"of","start":83.807},{"w":"columns.","start":84.007},{"w":"So","start":84.687},{"w":"we","start":84.927},{"w":"build","start":85.274},{"w":"vectors","start":85.62},{"w":"in","start":85.967},{"w":"three","start":86.127},{"w":"steps.","start":86.407}]},{"id":"c12","start":87.309,"end":91.743,"marks":{},"text":"Count: go through millions of sentences, and count the neighbours of every word.","words":[{"w":"Count:","start":87.309},{"w":"go","start":87.789},{"w":"through","start":88.029},{"w":"millions","start":88.309},{"w":"of","start":88.749},{"w":"sentences,","start":88.909},{"w":"and","start":89.629},{"w":"count","start":89.909},{"w":"the","start":90.189},{"w":"neighbours","start":90.349},{"w":"of","start":90.869},{"w":"every","start":91.029},{"w":"word.","start":91.389}]},{"id":"c13","start":92.143,"end":104.327,"marks":{},"text":"Compress: squeeze the giant table down to a few hundred numbers per word, keeping only the main patterns. A classic way to do this is called singular value decomposition, or SVD.","words":[{"w":"Compress:","start":92.143},{"w":"squeeze","start":92.783},{"w":"the","start":93.383},{"w":"giant","start":93.583},{"w":"table","start":93.983},{"w":"down","start":94.383},{"w":"to","start":94.663},{"w":"a","start":94.783},{"w":"few","start":94.943},{"w":"hundred","start":95.263},{"w":"numbers","start":95.583},{"w":"per","start":95.903},{"w":"word,","start":96.143},{"w":"keeping","start":96.583},{"w":"only","start":97.023},{"w":"the","start":97.263},{"w":"main","start":97.423},{"w":"patterns.","start":97.783},{"w":"A","start":98.703},{"w":"classic","start":98.863},{"w":"way","start":99.503},{"w":"to","start":99.663},{"w":"do","start":99.863},{"w":"this","start":100.063},{"w":"is","start":100.303},{"w":"called","start":100.503},{"w":"singular","start":100.863},{"w":"value","start":101.423},{"w":"decomposition,","start":101.823},{"w":"or","start":102.943},{"w":"SVD.","start":103.635}]},{"id":"c14","start":104.727,"end":109.725,"marks":{},"text":"Compare: now, to see how similar two words are, we check how close their vectors are.","words":[{"w":"Compare:","start":104.727},{"w":"now,","start":105.487},{"w":"to","start":105.887},{"w":"see","start":106.167},{"w":"how","start":106.327},{"w":"similar","start":106.527},{"w":"two","start":107.087},{"w":"words","start":107.287},{"w":"are,","start":107.607},{"w":"we","start":107.847},{"w":"check","start":108.047},{"w":"how","start":108.327},{"w":"close","start":108.527},{"w":"their","start":108.86},{"w":"vectors","start":109.194},{"w":"are.","start":109.527}]}],"title":"From counts to vectors","shortTitle":"From counts to vectors","props":{"kicker":"Building vectors","title":"From counts to word vectors","steps":[{"label":"Count","detail":"neighbours in lots of text"},{"label":"Compress","detail":"keep the main patterns"},{"label":"Compare","detail":"close vectors = similar words"}]},"start":80.967,"end":109.725,"startFrame":2429,"durationInFrames":890},{"id":"similar","kind":"core","component":"BarChart","short":false,"cues":[{"id":"c15","start":110.633,"end":116.63,"marks":{},"text":"Here are some illustrative similarity scores, from zero for unrelated up to one for very similar.","words":[{"w":"Here","start":110.633},{"w":"are","start":110.873},{"w":"some","start":111.033},{"w":"illustrative","start":111.233},{"w":"similarity","start":111.913},{"w":"scores,","start":112.593},{"w":"from","start":113.06},{"w":"zero","start":113.526},{"w":"for","start":113.993},{"w":"unrelated","start":114.193},{"w":"up","start":114.873},{"w":"to","start":115.113},{"w":"one","start":115.273},{"w":"for","start":115.553},{"w":"very","start":115.753},{"w":"similar.","start":116.073}]},{"id":"c16","start":117.03,"end":118.836,"marks":{},"text":"Storm is very close to rain.","words":[{"w":"Storm","start":117.03},{"w":"is","start":117.47},{"w":"very","start":117.71},{"w":"close","start":117.95},{"w":"to","start":118.27},{"w":"rain.","start":118.43}]},{"id":"c17","start":119.236,"end":123.527,"marks":{},"text":"Umbrella is fairly close: it shows up in many of the same sentences.","words":[{"w":"Umbrella","start":119.276},{"w":"is","start":119.876},{"w":"fairly","start":120.036},{"w":"close:","start":120.516},{"w":"it","start":120.996},{"w":"shows","start":121.236},{"w":"up","start":121.596},{"w":"in","start":121.756},{"w":"many","start":121.916},{"w":"of","start":122.196},{"w":"the","start":122.356},{"w":"same","start":122.476},{"w":"sentences.","start":122.756}]},{"id":"c18","start":123.927,"end":127.659,"marks":{},"text":"And banana is far away. They simply don't keep the same company.","words":[{"w":"And","start":123.927},{"w":"banana","start":124.047},{"w":"is","start":124.607},{"w":"far","start":124.847},{"w":"away.","start":125.127},{"w":"They","start":125.567},{"w":"simply","start":125.807},{"w":"don't","start":126.247},{"w":"keep","start":126.487},{"w":"the","start":126.687},{"w":"same","start":126.847},{"w":"company.","start":127.127}]}],"title":"Closest to rain","shortTitle":"Closest to rain","props":{"kicker":"Illustrative scores","title":"How similar is each word to “rain”?","bars":[{"label":"storm","value":0.9},{"label":"umbrella","value":0.7},{"label":"banana","value":0.1}],"note":"0 = unrelated, 1 = very similar"},"start":110.633,"end":127.659,"startFrame":3319,"durationInFrames":538},{"id":"maths","kind":"core","component":"Bullets","short":true,"cues":[{"id":"c19","start":128.567,"end":135.027,"marks":{},"text":"Something surprising happens in a good vector space: directions carry meaning, so you can do maths with words.","words":[{"w":"Something","start":128.567},{"w":"surprising","start":128.967},{"w":"happens","start":129.647},{"w":"in","start":130.087},{"w":"a","start":130.207},{"w":"good","start":130.46},{"w":"vector","start":130.714},{"w":"space:","start":130.967},{"w":"directions","start":131.607},{"w":"carry","start":132.327},{"w":"meaning,","start":132.687},{"w":"so","start":133.127},{"w":"you","start":133.367},{"w":"can","start":133.527},{"w":"do","start":133.727},{"w":"maths","start":133.927},{"w":"with","start":134.367},{"w":"words.","start":134.567}]},{"id":"c20","start":135.427,"end":139.488,"marks":{},"text":"Start at king, take away man, add woman, and the nearest word is queen.","words":[{"w":"Start","start":135.427},{"w":"at","start":135.667},{"w":"king,","start":135.907},{"w":"take","start":136.307},{"w":"away","start":136.547},{"w":"man,","start":136.867},{"w":"add","start":137.227},{"w":"woman,","start":137.587},{"w":"and","start":137.907},{"w":"the","start":138.067},{"w":"nearest","start":138.187},{"w":"word","start":138.667},{"w":"is","start":138.941},{"w":"queen.","start":139.214}]},{"id":"c21","start":139.888,"end":148.565,"marks":{},"text":"Start at Paris, take away France, add Italy, and you land near Rome. The direction from a country to its capital is roughly the same everywhere.","words":[{"w":"Start","start":139.888},{"w":"at","start":140.208},{"w":"Paris,","start":140.368},{"w":"take","start":140.848},{"w":"away","start":141.088},{"w":"France,","start":141.328},{"w":"add","start":141.888},{"w":"Italy,","start":142.248},{"w":"and","start":142.768},{"w":"you","start":142.968},{"w":"land","start":143.208},{"w":"near","start":143.528},{"w":"Rome.","start":143.808},{"w":"The","start":144.368},{"w":"direction","start":144.688},{"w":"from","start":145.248},{"w":"a","start":145.408},{"w":"country","start":145.568},{"w":"to","start":145.888},{"w":"its","start":146.048},{"w":"capital","start":146.288},{"w":"is","start":146.768},{"w":"roughly","start":147.008},{"w":"the","start":147.448},{"w":"same","start":147.608},{"w":"everywhere.","start":147.968}]},{"id":"c22","start":148.965,"end":153.36,"marks":{},"text":"It even works for grammar: walked minus walk plus swim lands near swam.","words":[{"w":"It","start":148.965},{"w":"even","start":149.125},{"w":"works","start":149.445},{"w":"for","start":149.765},{"w":"grammar:","start":149.965},{"w":"walked","start":150.565},{"w":"minus","start":150.965},{"w":"walk","start":151.405},{"w":"plus","start":151.645},{"w":"swim","start":151.965},{"w":"lands","start":152.285},{"w":"near","start":152.605},{"w":"swam.","start":152.885}]}],"title":"Word maths","shortTitle":"Word maths: king − man + woman = ?","props":{"kicker":"Word maths","title":"Directions in the map carry meaning","items":[{"text":"king − man + woman ≈ queen"},{"text":"Paris − France + Italy ≈ Rome"},{"text":"walked − walk + swim ≈ swam"}],"numbered":false},"start":128.567,"end":153.36,"startFrame":3857,"durationInFrames":771},{"id":"onehot","kind":"core","component":"Compare","short":false,"cues":[{"id":"c23","start":154.267,"end":157.774,"marks":{},"text":"Why is this such a big deal? Compare it with what we had before.","words":[{"w":"Why","start":154.267},{"w":"is","start":154.507},{"w":"this","start":154.747},{"w":"such","start":154.987},{"w":"a","start":155.187},{"w":"big","start":155.347},{"w":"deal?","start":155.587},{"w":"Compare","start":156.027},{"w":"it","start":156.507},{"w":"with","start":156.627},{"w":"what","start":156.827},{"w":"we","start":156.947},{"w":"had","start":157.107},{"w":"before.","start":157.307}]},{"id":"c24","start":158.174,"end":166.598,"marks":{},"text":"With one ID per word, every word is equally far from every other. To the model, rain is as close to storm as it is to banana.","words":[{"w":"With","start":158.174},{"w":"one","start":158.334},{"w":"ID","start":158.714},{"w":"per","start":159.094},{"w":"word,","start":159.374},{"w":"every","start":159.814},{"w":"word","start":160.174},{"w":"is","start":160.454},{"w":"equally","start":160.654},{"w":"far","start":161.214},{"w":"from","start":161.534},{"w":"every","start":161.774},{"w":"other.","start":162.134},{"w":"To","start":162.614},{"w":"the","start":162.814},{"w":"model,","start":163.014},{"w":"rain","start":163.614},{"w":"is","start":164.094},{"w":"as","start":164.254},{"w":"close","start":164.454},{"w":"to","start":164.814},{"w":"storm","start":164.974},{"w":"as","start":165.374},{"w":"it","start":165.574},{"w":"is","start":165.734},{"w":"to","start":165.894},{"w":"banana.","start":166.054}]},{"id":"c25","start":166.998,"end":175.628,"marks":{},"text":"With word vectors, similar words sit close together, and the model can use that. Anything it learns about storm partly carries over to rain.","words":[{"w":"With","start":166.998},{"w":"word","start":167.385},{"w":"vectors,","start":167.771},{"w":"similar","start":168.158},{"w":"words","start":168.758},{"w":"sit","start":169.078},{"w":"close","start":169.398},{"w":"together,","start":169.678},{"w":"and","start":170.238},{"w":"the","start":170.398},{"w":"model","start":170.558},{"w":"can","start":170.998},{"w":"use","start":171.198},{"w":"that.","start":171.558},{"w":"Anything","start":171.958},{"w":"it","start":172.438},{"w":"learns","start":172.678},{"w":"about","start":173.118},{"w":"storm","start":173.358},{"w":"partly","start":173.798},{"w":"carries","start":174.318},{"w":"over","start":174.758},{"w":"to","start":174.998},{"w":"rain.","start":175.198}]}],"title":"Why not just IDs?","shortTitle":"Why not just IDs?","props":{"kicker":"Before and after","title":"IDs versus word vectors","columns":[{"title":"One ID per word","items":["one slot per word","every word equally far apart","rain is as close to storm as to banana"],"tone":"bad"},{"title":"Word vectors","items":["a few hundred numbers","similar words sit close","learned from text"],"tone":"good"}],"verdict":{"text":"Vectors let a model see that words are related"}},"start":154.267,"end":175.628,"startFrame":4628,"durationInFrames":668},{"id":"quiz","kind":"quiz","component":"Quiz","short":true,"cues":[{"id":"c26","start":176.533,"end":183.923,"marks":{},"text":"Time for a quick quiz. Which word's vector is probably closest to the vector for rain: storm, banana, or Tuesday?","words":[{"w":"Time","start":176.533},{"w":"for","start":176.853},{"w":"a","start":177.173},{"w":"quick","start":177.493},{"w":"quiz.","start":177.813},{"w":"Which","start":178.133},{"w":"word's","start":178.506},{"w":"vector","start":178.88},{"w":"is","start":179.253},{"w":"probably","start":179.413},{"w":"closest","start":179.933},{"w":"to","start":180.333},{"w":"the","start":180.546},{"w":"vector","start":180.76},{"w":"for","start":180.973},{"w":"rain:","start":181.173},{"w":"storm,","start":181.733},{"w":"banana,","start":182.373},{"w":"or","start":183.093},{"w":"Tuesday?","start":183.253}]},{"id":"c27","start":184.323,"end":185.843,"marks":{},"text":"Pause the video and choose.","words":[{"w":"Pause","start":184.323},{"w":"the","start":184.603},{"w":"video","start":184.863},{"w":"and","start":185.123},{"w":"choose.","start":185.323}]},{"id":"c28","start":189.243,"end":196.965,"marks":{},"text":"It's storm. Rain and storm appear near the same words, like wet, cloud and weather, so their vectors end up close together.","words":[{"w":"It's","start":189.243},{"w":"storm.","start":189.523},{"w":"Rain","start":190.123},{"w":"and","start":190.523},{"w":"storm","start":190.723},{"w":"appear","start":191.123},{"w":"near","start":191.443},{"w":"the","start":191.683},{"w":"same","start":191.883},{"w":"words,","start":192.203},{"w":"like","start":192.803},{"w":"wet,","start":193.123},{"w":"cloud","start":193.643},{"w":"and","start":194.123},{"w":"weather,","start":194.363},{"w":"so","start":194.763},{"w":"their","start":195.083},{"w":"vectors","start":195.403},{"w":"end","start":195.723},{"w":"up","start":195.963},{"w":"close","start":196.163},{"w":"together.","start":196.483}]}],"title":"Quick quiz","shortTitle":"Quick quiz: which word is closest to “rain”?","props":{"kicker":"Pause and predict","question":"Which word's vector is probably closest to “rain”?","options":["storm","banana","Tuesday"],"answer":0,"explain":"Rain and storm keep the same company: wet, cloud, weather."},"start":176.533,"end":196.965,"startFrame":5296,"durationInFrames":640},{"id":"recap","kind":"recap","component":"Recap","short":false,"cues":[{"id":"c29","start":197.867,"end":201.544,"marks":{},"text":"Let's recap. A word gets its meaning from the company it keeps.","words":[{"w":"Let's","start":197.867},{"w":"recap.","start":198.267},{"w":"A","start":198.827},{"w":"word","start":199.067},{"w":"gets","start":199.387},{"w":"its","start":199.707},{"w":"meaning","start":199.947},{"w":"from","start":200.267},{"w":"the","start":200.427},{"w":"company","start":200.507},{"w":"it","start":200.947},{"w":"keeps.","start":201.147}]},{"id":"c30","start":201.944,"end":206.36,"marks":{},"text":"A word vector is a list of numbers that places the word on a map of meaning.","words":[{"w":"A","start":201.944},{"w":"word","start":202.264},{"w":"vector","start":202.584},{"w":"is","start":202.904},{"w":"a","start":203.064},{"w":"list","start":203.184},{"w":"of","start":203.531},{"w":"numbers","start":203.877},{"w":"that","start":204.224},{"w":"places","start":204.424},{"w":"the","start":204.864},{"w":"word","start":205.024},{"w":"on","start":205.304},{"w":"a","start":205.424},{"w":"map","start":205.544},{"w":"of","start":205.784},{"w":"meaning.","start":205.944}]},{"id":"c31","start":206.76,"end":209.52,"marks":{},"text":"Words with close vectors have similar meanings.","words":[{"w":"Words","start":206.76},{"w":"with","start":207.16},{"w":"close","start":207.36},{"w":"vectors","start":207.8},{"w":"have","start":208.24},{"w":"similar","start":208.44},{"w":"meanings.","start":208.96}]},{"id":"c32","start":209.92,"end":215.067,"marks":{},"text":"And directions in that map carry meaning, so king minus man plus woman lands near queen.","words":[{"w":"And","start":209.92},{"w":"directions","start":210.04},{"w":"in","start":210.56},{"w":"that","start":210.72},{"w":"map","start":210.88},{"w":"carry","start":211.16},{"w":"meaning,","start":211.52},{"w":"so","start":212},{"w":"king","start":212.28},{"w":"minus","start":212.64},{"w":"man","start":213.16},{"w":"plus","start":213.36},{"w":"woman","start":213.76},{"w":"lands","start":214},{"w":"near","start":214.356},{"w":"queen.","start":214.711}]},{"id":"c33","start":215.467,"end":220.563,"marks":{},"text":"Next lesson: Word2Vec. How does a computer learn word vectors just by reading?","words":[{"w":"Next","start":215.967},{"w":"lesson:","start":216.467},{"w":"Word2Vec.","start":216.967},{"w":"How","start":217.467},{"w":"does","start":217.787},{"w":"a","start":217.987},{"w":"computer","start":218.107},{"w":"learn","start":218.547},{"w":"word","start":218.907},{"w":"vectors","start":219.267},{"w":"just","start":219.627},{"w":"by","start":219.867},{"w":"reading?","start":220.067}]}],"title":"Recap and next lesson","shortTitle":"Recap and next lesson","props":{"title":"Recap","points":["Words get meaning from the company they keep","A word vector places a word on a map of meaning","Close vectors mean similar words","Directions carry meaning: king − man + woman ≈ queen"],"next":{"title":"Word2Vec","question":"How does a computer learn word vectors just by reading?"}},"start":197.867,"end":220.563,"startFrame":5936,"durationInFrames":726}],"refs":{"c01":0.6,"c02":6.948,"c03":15.767,"c04":26.033,"c05":34.627,"c06":43.546,"c07":52.6,"c08":62.693,"c09":66.667,"c10":75.943,"c11":80.967,"c12":87.309,"c13":92.143,"c14":104.727,"c15":110.633,"c16":117.03,"c17":119.236,"c18":123.927,"c19":128.567,"c20":135.427,"c21":139.888,"c22":148.965,"c23":154.267,"c24":158.174,"c25":166.998,"c26":176.533,"c27":184.323,"c28":189.243,"c29":197.867,"c30":201.944,"c31":206.76,"c32":209.92,"c33":215.467},"audio":[{"file":".cache/proc/0ce1dc30b5903b9c.wav","start":0.6},{"file":".cache/proc/e07116a52744667c.wav","start":6.948},{"file":".cache/proc/c55ecc2e3d4ae053.wav","start":15.767},{"file":".cache/proc/068e2418d1adc2fa.wav","start":26.033},{"file":".cache/proc/92c3e60802f1b20c.wav","start":34.627},{"file":".cache/proc/16633ff3982a29ea.wav","start":43.546},{"file":".cache/proc/e2ac7d4b6c7a3afd.wav","start":52.6},{"file":".cache/proc/cf1c4cc6ee89d9f2.wav","start":62.693},{"file":".cache/proc/93f87a894f714fe0.wav","start":66.667},{"file":".cache/proc/d3a9e93ccc262750.wav","start":75.943},{"file":".cache/proc/8028098092eb1866.wav","start":80.967},{"file":".cache/proc/6fb48cd2b5c22b80.wav","start":87.309},{"file":".cache/proc/e5bc5ef01e013360.wav","start":92.143},{"file":".cache/proc/80be0b6a45c86f4b.wav","start":104.727},{"file":".cache/proc/42102dd107bf2432.wav","start":110.633},{"file":".cache/proc/c2d4b5ca61fd0317.wav"