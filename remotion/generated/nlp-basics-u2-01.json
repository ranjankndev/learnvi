{"key":"nlp-basics-u2-01","seriesId":"nlp-basics","episode":"u2-01","title":"Morphology: The Building Blocks Inside Words","fps":30,"duration":225.161,"durationInFrames":6755,"video":{"width":1920,"height":1080,"burnCaptions":true,"brand":"learnvi.in"},"badge":["UNIT 2 · LESSON 1","MORPHOLOGY"],"series":{"title":"NLP, Simply Explained","subtitle":"University NLP, one idea at a time, no heavy maths","runningPrompt":"","stops":[{"id":"u1-01","number":1,"name":"The Stages of NLP: From Letters to Meaning","stamp":"THE STAGES OF NLP: FROM LETTERS TO MEANING","topic":""},{"id":"u1-02","number":2,"name":"Tokenization: How Text Becomes Pieces","stamp":"TOKENIZATION: HOW TEXT BECOMES PIECES","topic":""},{"id":"u1-03","number":3,"name":"Text Classification: Teaching Computers to Sort Text","stamp":"TEXT CLASSIFICATION: TEACHING COMPUTERS TO SORT TEXT","topic":""},{"id":"u1-04","number":4,"name":"Language Models: Guessing the Next Word","stamp":"LANGUAGE MODELS: GUESSING THE NEXT WORD","topic":""},{"id":"u2-01","number":5,"name":"Morphology: The Building Blocks Inside Words","stamp":"MORPHOLOGY: THE BUILDING BLOCKS INSIDE WORDS","topic":""},{"id":"u2-02","number":6,"name":"Part-of-Speech Tagging: Is It a Noun or a Verb?","stamp":"PART-OF-SPEECH TAGGING: IS IT A NOUN OR A VERB?","topic":""},{"id":"u2-03","number":7,"name":"Chunking: Grouping Words into Phrases","stamp":"CHUNKING: GROUPING WORDS INTO PHRASES","topic":""},{"id":"u2-04","number":8,"name":"Generative vs Discriminative Models","stamp":"GENERATIVE VS DISCRIMINATIVE MODELS","topic":""},{"id":"u2-05","number":9,"name":"Hidden Markov Models, Intuitively","stamp":"HIDDEN MARKOV MODELS, INTUITIVELY","topic":""},{"id":"u2-06","number":10,"name":"Conditional Random Fields, Intuitively","stamp":"CONDITIONAL RANDOM FIELDS, INTUITIVELY","topic":""},{"id":"u3-01","number":11,"name":"Constituency Parsing: Sentences as Trees","stamp":"CONSTITUENCY PARSING: SENTENCES AS TREES","topic":""},{"id":"u3-02","number":12,"name":"Dependency Parsing: Who Did What to Whom","stamp":"DEPENDENCY PARSING: WHO DID WHAT TO WHOM","topic":""},{"id":"u3-03","number":13,"name":"Transition-Based Parsing: Building Trees Step by Step","stamp":"TRANSITION-BASED PARSING: BUILDING TREES STEP BY STEP","topic":""},{"id":"u4-01","number":14,"name":"Word Vectors: Giving Words a Place on a Map","stamp":"WORD VECTORS: GIVING WORDS A PLACE ON A MAP","topic":""},{"id":"u4-02","number":15,"name":"Word2Vec: Learning Word Vectors from Context","stamp":"WORD2VEC: LEARNING WORD VECTORS FROM CONTEXT","topic":""},{"id":"u4-03","number":16,"name":"Recurrent Neural Networks: Reading with Memory","stamp":"RECURRENT NEURAL NETWORKS: READING WITH MEMORY","topic":""},{"id":"u4-04","number":17,"name":"LSTMs: Remembering What Matters","stamp":"LSTMS: REMEMBERING WHAT MATTERS","topic":""},{"id":"u5-01","number":18,"name":"Contextual Embeddings and ELMo","stamp":"CONTEXTUAL EMBEDDINGS AND ELMO","topic":""},{"id":"u5-02","number":19,"name":"BERT: Reading in Both Directions","stamp":"BERT: READING IN BOTH DIRECTIONS","topic":""}]},"stop":{"number":5,"name":"Morphology: The Building Blocks Inside Words","stamp":"MORPHOLOGY: THE BUILDING BLOCKS INSIDE WORDS"},"shorts":{"width":1080,"height":1920,"maxSeconds":60,"cta":"Full lesson: NLP, Simply Explained · Unit 2"},"thumbnail":{"headline":"The hidden pieces inside words","big":"un · break · able"},"segments":[{"id":"intro","kind":"intro","component":"TitleCard","short":false,"cues":[{"id":"c01","start":0.6,"end":6.411,"marks":{},"text":"Welcome back to NLP, Simply Explained. This is unit 2, lesson 1: morphology.","words":[{"w":"Welcome","start":0.6},{"w":"back","start":1.08},{"w":"to","start":1.427},{"w":"NLP,","start":1.773},{"w":"Simply","start":2.12},{"w":"Explained.","start":2.68},{"w":"This","start":3.48},{"w":"is","start":3.76},{"w":"unit","start":3.96},{"w":"2,","start":4.36},{"w":"lesson","start":4.76},{"w":"1:","start":5.16},{"w":"morphology.","start":5.48}]},{"id":"c02","start":6.811,"end":12.651,"marks":{},"text":"So far we have cut text into words and tokens. Today we look inside the words themselves.","words":[{"w":"So","start":6.811},{"w":"far","start":7.051},{"w":"we","start":7.371},{"w":"have","start":7.531},{"w":"cut","start":7.731},{"w":"text","start":7.931},{"w":"into","start":8.371},{"w":"words","start":8.651},{"w":"and","start":9.011},{"w":"tokens.","start":9.211},{"w":"Today","start":9.891},{"w":"we","start":10.571},{"w":"look","start":10.811},{"w":"inside","start":10.971},{"w":"the","start":11.411},{"w":"words","start":11.611},{"w":"themselves.","start":12.011}]}],"title":"Welcome","shortTitle":"Welcome","props":{"kicker":"Unit 2 · Lesson 1","title":"Morphology","subtitle":"The building blocks inside words"},"start":0.6,"end":12.651,"startFrame":0,"durationInFrames":407},{"id":"idea","kind":"core","component":"BigIdea","short":false,"cues":[{"id":"c03","start":13.567,"end":19.999,"marks":{},"text":"Here is the idea for today. Words are built from smaller pieces, and each of those pieces carries meaning.","words":[{"w":"Here","start":13.567},{"w":"is","start":13.847},{"w":"the","start":14.007},{"w":"idea","start":14.167},{"w":"for","start":14.647},{"w":"today.","start":15.127},{"w":"Words","start":15.607},{"w":"are","start":16.047},{"w":"built","start":16.207},{"w":"from","start":16.527},{"w":"smaller","start":16.767},{"w":"pieces,","start":17.167},{"w":"and","start":17.727},{"w":"each","start":18.007},{"w":"of","start":18.247},{"w":"those","start":18.367},{"w":"pieces","start":18.687},{"w":"carries","start":19.087},{"w":"meaning.","start":19.567}]}],"title":"The big idea","shortTitle":"The big idea","props":{"kicker":"Key idea","text":"Words are built from smaller pieces, and each piece carries meaning.","highlight":["smaller pieces"]},"start":13.567,"end":19.999,"startFrame":407,"durationInFrames":220},{"id":"morpheme","kind":"core","component":"Definition","short":false,"cues":[{"id":"c04","start":20.9,"end":26.851,"marks":{},"text":"Those pieces are called morphemes. A morpheme is the smallest part of a word that still carries meaning.","words":[{"w":"Those","start":20.9},{"w":"pieces","start":21.22},{"w":"are","start":21.62},{"w":"called","start":21.82},{"w":"morphemes.","start":22.46},{"w":"A","start":23.1},{"w":"morpheme","start":23.3},{"w":"is","start":23.94},{"w":"the","start":24.06},{"w":"smallest","start":24.22},{"w":"part","start":24.7},{"w":"of","start":24.9},{"w":"a","start":25.02},{"w":"word","start":25.18},{"w":"that","start":25.46},{"w":"still","start":25.7},{"w":"carries","start":25.94},{"w":"meaning.","start":26.42}]},{"id":"c05","start":27.251,"end":34.076,"marks":{},"text":"Take the word \"unbreakable\". It is three morphemes: \"un\", meaning not; \"break\"; and \"able\", meaning it can be done.","words":[{"w":"Take","start":27.251},{"w":"the","start":27.491},{"w":"word","start":27.651},{"w":"\"unbreakable\".","start":27.891},{"w":"It","start":28.771},{"w":"is","start":29.011},{"w":"three","start":29.171},{"w":"morphemes:","start":29.491},{"w":"\"un\",","start":30.111},{"w":"meaning","start":30.731},{"w":"not;","start":31.171},{"w":"\"break\";","start":31.651},{"w":"and","start":32.211},{"w":"\"able\",","start":32.451},{"w":"meaning","start":32.931},{"w":"it","start":33.291},{"w":"can","start":33.451},{"w":"be","start":33.571},{"w":"done.","start":33.771}]},{"id":"c06","start":34.476,"end":40.699,"marks":{},"text":"Think of morphemes as LEGO bricks. A small set of bricks snaps together into thousands of different words.","words":[{"w":"Think","start":34.476},{"w":"of","start":34.636},{"w":"morphemes","start":34.796},{"w":"as","start":35.436},{"w":"LEGO","start":35.776},{"w":"bricks.","start":36.116},{"w":"A","start":36.716},{"w":"small","start":36.956},{"w":"set","start":37.276},{"w":"of","start":37.556},{"w":"bricks","start":37.676},{"w":"snaps","start":38.116},{"w":"together","start":38.556},{"w":"into","start":38.996},{"w":"thousands","start":39.236},{"w":"of","start":39.756},{"w":"different","start":39.876},{"w":"words.","start":40.356}]}],"title":"What is a morpheme?","shortTitle":"What is a morpheme?","props":{"kicker":"Definition","term":"Morpheme","definition":"The smallest part of a word that still carries meaning.","example":"un · break · able","analogy":"LEGO bricks that snap together to build words."},"start":20.9,"end":40.699,"startFrame":627,"durationInFrames":621},{"id":"kinds","kind":"core","component":"Compare","short":false,"cues":[{"id":"c07","start":41.6,"end":43.256,"marks":{},"text":"Morphemes come in two kinds.","words":[{"w":"Morphemes","start":41.9},{"w":"come","start":42.2},{"w":"in","start":42.4},{"w":"two","start":42.52},{"w":"kinds.","start":42.8}]},{"id":"c08","start":43.656,"end":48.824,"marks":{},"text":"Free morphemes can stand alone as words of their own, like \"break\", \"cat\" or \"happy\".","words":[{"w":"Free","start":43.656},{"w":"morphemes","start":43.936},{"w":"can","start":44.496},{"w":"stand","start":44.656},{"w":"alone","start":44.896},{"w":"as","start":45.256},{"w":"words","start":45.456},{"w":"of","start":45.776},{"w":"their","start":45.896},{"w":"own,","start":46.096},{"w":"like","start":46.456},{"w":"\"break\",","start":46.696},{"w":"\"cat\"","start":47.456},{"w":"or","start":47.976},{"w":"\"happy\".","start":48.256}]},{"id":"c09","start":49.224,"end":58.961,"marks":{"verdict":56.984},"text":"Bound morphemes can't stand alone. They have to attach to another piece, like \"un\", \"able\", or the \"s\" that makes a plural. Most words mix both kinds.","words":[{"w":"Bound","start":49.224},{"w":"morphemes","start":49.584},{"w":"can't","start":50.224},{"w":"stand","start":50.504},{"w":"alone.","start":50.904},{"w":"They","start":51.464},{"w":"have","start":51.704},{"w":"to","start":51.904},{"w":"attach","start":52.064},{"w":"to","start":52.504},{"w":"another","start":52.704},{"w":"piece,","start":53.064},{"w":"like","start":53.584},{"w":"\"un\",","start":53.944},{"w":"\"able\",","start":54.464},{"w":"or","start":54.984},{"w":"the","start":55.224},{"w":"\"s\"","start":55.504},{"w":"that","start":55.704},{"w":"makes","start":55.944},{"w":"a","start":56.184},{"w":"plural.","start":56.304},{"w":"Most","start":56.984},{"w":"words","start":57.424},{"w":"mix","start":57.784},{"w":"both","start":58.104},{"w":"kinds.","start":58.504}]}],"title":"Free and bound morphemes","shortTitle":"Free and bound morphemes","props":{"kicker":"Two kinds","title":"Free and bound morphemes","columns":[{"title":"Free","items":["can stand alone as a word","break · cat · happy"],"tone":"good"},{"title":"Bound","items":["must attach to another piece","un- · -able · -s · -ed"],"tone":"neutral"}],"verdict":{"text":"Most words mix both","at":"c09@verdict"}},"start":41.6,"end":58.961,"startFrame":1248,"durationInFrames":548},{"id":"affixes","kind":"core","component":"Table","short":false,"cues":[{"id":"c10","start":59.867,"end":66.172,"marks":{},"text":"Bound pieces that attach to the front or the back of a word are called affixes. Here are some you use every day.","words":[{"w":"Bound","start":59.867},{"w":"pieces","start":60.227},{"w":"that","start":60.667},{"w":"attach","start":60.947},{"w":"to","start":61.227},{"w":"the","start":61.347},{"w":"front","start":61.467},{"w":"or","start":61.867},{"w":"the","start":62.027},{"w":"back","start":62.187},{"w":"of","start":62.427},{"w":"a","start":62.547},{"w":"word","start":62.707},{"w":"are","start":63.027},{"w":"called","start":63.227},{"w":"affixes.","start":63.547},{"w":"Here","start":64.387},{"w":"are","start":64.747},{"w":"some","start":64.867},{"w":"you","start":65.067},{"w":"use","start":65.307},{"w":"every","start":65.547},{"w":"day.","start":65.867}]},{"id":"c11","start":66.572,"end":69.499,"marks":{},"text":"\"un\" goes at the front, so it's a prefix: unhappy.","words":[{"w":"\"un\"","start":66.745},{"w":"goes","start":66.919},{"w":"at","start":67.092},{"w":"the","start":67.212},{"w":"front,","start":67.292},{"w":"so","start":67.572},{"w":"it's","start":67.692},{"w":"a","start":67.892},{"w":"prefix:","start":68.012},{"w":"unhappy.","start":68.732}]},{"id":"c12","start":69.899,"end":72.927,"marks":{},"text":"\"re\" is a prefix too: rebuild means build again.","words":[{"w":"\"re\"","start":69.899},{"w":"is","start":70.179},{"w":"a","start":70.379},{"w":"prefix","start":70.459},{"w":"too:","start":70.899},{"w":"rebuild","start":71.339},{"w":"means","start":71.899},{"w":"build","start":72.219},{"w":"again.","start":72.579}]},{"id":"c13","start":73.327,"end":76.637,"marks":{},"text":"At the back, \"s\" is a suffix that makes a plural: cats.","words":[{"w":"At","start":73.327},{"w":"the","start":73.487},{"w":"back,","start":73.647},{"w":"\"s\"","start":74.007},{"w":"is","start":74.207},{"w":"a","start":74.367},{"w":"suffix","start":74.527},{"w":"that","start":74.967},{"w":"makes","start":75.087},{"w":"a","start":75.327},{"w":"plural:","start":75.647},{"w":"cats.","start":75.967}]},{"id":"c14","start":77.037,"end":81.16,"marks":{},"text":"\"ness\" turns an adjective into a noun: kind becomes kindness.","words":[{"w":"\"ness\"","start":77.077},{"w":"turns","start":77.517},{"w":"an","start":77.877},{"w":"adjective","start":78.037},{"w":"into","start":78.637},{"w":"a","start":78.837},{"w":"noun:","start":78.957},{"w":"kind","start":79.517},{"w":"becomes","start":79.957},{"w":"kindness.","start":80.517}]},{"id":"c15","start":81.56,"end":85.041,"marks":{},"text":"And \"e d\" puts a verb in the past: walk becomes walked.","words":[{"w":"And","start":81.56},{"w":"\"e","start":81.8},{"w":"d\"","start":82.04},{"w":"puts","start":82.2},{"w":"a","start":82.44},{"w":"verb","start":82.68},{"w":"in","start":82.92},{"w":"the","start":83.04},{"w":"past:","start":83.2},{"w":"walk","start":83.76},{"w":"becomes","start":84.08},{"w":"walked.","start":84.6}]}],"title":"Prefixes and suffixes","shortTitle":"Prefixes and suffixes","props":{"kicker":"Affixes","title":"Pieces that attach to words","columns":["Piece","Where","Example"],"rows":[["un-","prefix","unhappy"],["re-","prefix","rebuild"],["-s","suffix","cats"],["-ness","suffix","kindness"],["-ed","suffix","walked"]],"highlight":[]},"start":59.867,"end":85.041,"startFrame":1796,"durationInFrames":783},{"id":"inflect","kind":"core","component":"Compare","short":false,"cues":[{"id":"c16","start":85.967,"end":89.578,"marks":{},"text":"Affixes do one of two jobs, and it helps to keep them apart.","words":[{"w":"Affixes","start":86.267},{"w":"do","start":86.567},{"w":"one","start":86.727},{"w":"of","start":86.887},{"w":"two","start":87.007},{"w":"jobs,","start":87.287},{"w":"and","start":87.807},{"w":"it","start":88.007},{"w":"helps","start":88.127},{"w":"to","start":88.527},{"w":"keep","start":88.647},{"w":"them","start":88.887},{"w":"apart.","start":89.087}]},{"id":"c17","start":89.978,"end":98.991,"marks":{},"text":"Inflection gives the same word a new form. \"walk\" and \"walked\" are the same verb, just in the past. \"cat\" and \"cats\" are the same noun, just plural.","words":[{"w":"Inflection","start":89.978},{"w":"gives","start":90.618},{"w":"the","start":90.858},{"w":"same","start":91.018},{"w":"word","start":91.298},{"w":"a","start":91.538},{"w":"new","start":91.698},{"w":"form.","start":91.978},{"w":"\"walk\"","start":92.738},{"w":"and","start":93.138},{"w":"\"walked\"","start":93.458},{"w":"are","start":93.858},{"w":"the","start":93.978},{"w":"same","start":94.271},{"w":"verb,","start":94.565},{"w":"just","start":94.858},{"w":"in","start":95.098},{"w":"the","start":95.258},{"w":"past.","start":95.458},{"w":"\"cat\"","start":96.098},{"w":"and","start":96.538},{"w":"\"cats\"","start":96.778},{"w":"are","start":97.218},{"w":"the","start":97.378},{"w":"same","start":97.498},{"w":"noun,","start":97.818},{"w":"just","start":98.138},{"w":"plural.","start":98.418}]},{"id":"c18","start":99.391,"end":108.846,"marks":{},"text":"Derivation builds a different word. \"happy\" is an adjective, but \"happiness\" is a new word, a noun. \"teach\" becomes \"teacher\": a person, not an action.","words":[{"w":"Derivation","start":99.391},{"w":"builds","start":100.071},{"w":"a","start":100.431},{"w":"different","start":100.551},{"w":"word.","start":101.031},{"w":"\"happy\"","start":101.471},{"w":"is","start":101.911},{"w":"an","start":102.151},{"w":"adjective,","start":102.311},{"w":"but","start":102.911},{"w":"\"happiness\"","start":103.151},{"w":"is","start":103.711},{"w":"a","start":103.831},{"w":"new","start":103.991},{"w":"word,","start":104.271},{"w":"a","start":104.511},{"w":"noun.","start":104.671},{"w":"\"teach\"","start":105.311},{"w":"becomes","start":105.831},{"w":"\"teacher\":","start":106.431},{"w":"a","start":107.151},{"w":"person,","start":107.391},{"w":"not","start":107.871},{"w":"an","start":108.151},{"w":"action.","start":108.351}]},{"id":"c19","start":109.246,"end":114.761,"marks":{"verdict":111.086},"text":"So here's the short version. Inflection changes the form; derivation changes the word.","words":[{"w":"So","start":109.246},{"w":"here's","start":109.586},{"w":"the","start":109.926},{"w":"short","start":110.313},{"w":"version.","start":110.699},{"w":"Inflection","start":111.086},{"w":"changes","start":111.886},{"w":"the","start":112.366},{"w":"form;","start":112.566},{"w":"derivation","start":113.006},{"w":"changes","start":113.806},{"w":"the","start":114.246},{"w":"word.","start":114.446}]}],"title":"Inflection and derivation","shortTitle":"Inflection and derivation","props":{"kicker":"Two jobs","title":"Same word, or a new word?","columns":[{"title":"Inflection","items":["same word, new form","walk → walked","cat → cats"],"tone":"neutral","at":"c17"},{"title":"Derivation","items":["builds a new word","happy → happiness","teach → teacher"],"tone":"good","at":"c18"}],"verdict":{"text":"Inflection changes the form. Derivation changes the word.","at":"c19@verdict"}},"start":85.967,"end":114.761,"startFrame":2579,"durationInFrames":891},{"id":"stem","kind":"core","component":"Table","short":true,"cues":[{"id":"c20","start":115.667,"end":123.849,"marks":{},"text":"In NLP we often want to get back to the root of a word, so that \"studies\" and \"study\" count as the same thing. There are two ways to do it.","words":[{"w":"In","start":115.947},{"w":"NLP","start":116.227},{"w":"we","start":116.507},{"w":"often","start":116.787},{"w":"want","start":117.147},{"w":"to","start":117.347},{"w":"get","start":117.467},{"w":"back","start":117.667},{"w":"to","start":117.827},{"w":"the","start":117.947},{"w":"root","start":118.067},{"w":"of","start":118.307},{"w":"a","start":118.467},{"w":"word,","start":118.627},{"w":"so","start":118.987},{"w":"that","start":119.227},{"w":"\"studies\"","start":119.467},{"w":"and","start":120.067},{"w":"\"study\"","start":120.307},{"w":"count","start":120.867},{"w":"as","start":121.187},{"w":"the","start":121.387},{"w":"same","start":121.587},{"w":"thing.","start":121.907},{"w":"There","start":122.307},{"w":"are","start":122.547},{"w":"two","start":122.707},{"w":"ways","start":122.947},{"w":"to","start":123.267},{"w":"do","start":123.467},{"w":"it.","start":123.627}]},{"id":"c21","start":124.249,"end":135.388,"marks":{},"text":"Stemming simply chops endings off by rule. It's fast, but the result isn't always a real word. Lemmatization looks the word up, and returns its dictionary form, called the lemma.","words":[{"w":"Stemming","start":124.249},{"w":"simply","start":124.729},{"w":"chops","start":125.169},{"w":"endings","start":125.609},{"w":"off","start":126.129},{"w":"by","start":126.409},{"w":"rule.","start":126.609},{"w":"It's","start":127.049},{"w":"fast,","start":127.529},{"w":"but","start":127.929},{"w":"the","start":128.089},{"w":"result","start":128.289},{"w":"isn't","start":128.729},{"w":"always","start":129.089},{"w":"a","start":129.449},{"w":"real","start":129.609},{"w":"word.","start":130.089},{"w":"Lemmatization","start":130.769},{"w":"looks","start":131.649},{"w":"the","start":131.929},{"w":"word","start":132.089},{"w":"up,","start":132.329},{"w":"and","start":132.569},{"w":"returns","start":132.729},{"w":"its","start":133.249},{"w":"dictionary","start":133.449},{"w":"form,","start":134.089},{"w":"called","start":134.489},{"w":"the","start":134.849},{"w":"lemma.","start":134.969}]},{"id":"c22","start":135.788,"end":140.928,"marks":{},"text":"\"studies\": a common stemmer gives \"studi\", which isn't a word. Lemmatization gives \"study\".","words":[{"w":"\"studies\":","start":135.788},{"w":"a","start":136.428},{"w":"common","start":136.588},{"w":"stemmer","start":136.988},{"w":"gives","start":137.428},{"w":"\"studi\",","start":137.768},{"w":"which","start":138.108},{"w":"isn't","start":138.268},{"w":"a","start":138.588},{"w":"word.","start":138.748},{"w":"Lemmatization","start":139.268},{"w":"gives","start":140.148},{"w":"\"study\".","start":140.468}]},{"id":"c23","start":141.328,"end":142.919,"marks":{},"text":"\"running\": both give \"run\".","words":[{"w":"\"running\":","start":141.328},{"w":"both","start":141.808},{"w":"give","start":142.168},{"w":"\"run\".","start":142.448}]},{"id":"c24","start":143.319,"end":147.788,"marks":{},"text":"\"better\": stemming leaves it alone, but lemmatization knows it's a form of \"good\".","words":[{"w":"\"better\":","start":143.319},{"w":"stemming","start":143.879},{"w":"leaves","start":144.399},{"w":"it","start":144.679},{"w":"alone,","start":144.879},{"w":"but","start":145.359},{"w":"lemmatization","start":145.599},{"w":"knows","start":146.399},{"w":"it's","start":146.679},{"w":"a","start":146.919},{"w":"form","start":146.999},{"w":"of","start":147.279},{"w":"\"good\".","start":147.479}]},{"id":"c25","start":148.188,"end":153.055,"marks":{},"text":"And \"was\": stemming chops it to \"wa\", while lemmatization knows it's a form of \"be\".","words":[{"w":"And","start":148.188},{"w":"\"was\":","start":148.468},{"w":"stemming","start":148.988},{"w":"chops","start":149.548},{"w":"it","start":149.948},{"w":"to","start":150.068},{"w":"\"wa\",","start":150.268},{"w":"while","start":150.628},{"w":"lemmatization","start":150.908},{"w":"knows","start":151.708},{"w":"it's","start":151.988},{"w":"a","start":152.188},{"w":"form","start":152.268},{"w":"of","start":152.548},{"w":"\"be\".","start":152.802}]}],"title":"Stemming and lemmatization","shortTitle":"Stemming vs lemmatization in 40 seconds","props":{"kicker":"Back to the root","title":"Stemming vs lemmatization","columns":["Word","Stemming","Lemmatization"],"rows":[["studies","studi","study"],["running","run","run"],["better","better","good"],["was","wa","be"]],"highlight":[{"row":2,"col":2},{"row":3,"col":2}]},"start":115.667,"end":153.055,"startFrame":3470,"durationInFrames":1149},{"id":"why","kind":"core","component":"Bullets","short":false,"cues":[{"id":"c26","start":153.967,"end":157.611,"marks":{},"text":"So why does NLP care about word parts? Four reasons.","words":[{"w":"So","start":153.967},{"w":"why","start":154.127},{"w":"does","start":154.487},{"w":"NLP","start":154.847},{"w":"care","start":155.207},{"w":"about","start":155.527},{"w":"word","start":155.807},{"w":"parts?","start":156.087},{"w":"Four","start":156.507},{"w":"reasons.","start":156.927}]},{"id":"c27","start":158.011,"end":162.792,"marks":{},"text":"There are fewer things to learn. Walk, walks, walked and walking all share one root.","words":[{"w":"There","start":158.011},{"w":"are","start":158.171},{"w":"fewer","start":158.291},{"w":"things","start":158.611},{"w":"to","start":158.931},{"w":"learn.","start":159.131},{"w":"Walk,","start":159.691},{"w":"walks,","start":160.211},{"w":"walked","start":160.731},{"w":"and","start":161.091},{"w":"walking","start":161.291},{"w":"all","start":161.651},{"w":"share","start":161.851},{"w":"one","start":162.211},{"w":"root.","start":162.501}]},{"id":"c28","start":163.192,"end":167.834,"marks":{},"text":"Search gets better. Type \"running\", and you also find pages that say \"run\".","words":[{"w":"Search","start":163.192},{"w":"gets","start":163.672},{"w":"better.","start":163.992},{"w":"Type","start":164.472},{"w":"\"running\",","start":164.952},{"w":"and","start":165.432},{"w":"you","start":165.592},{"w":"also","start":165.832},{"w":"find","start":166.112},{"w":"pages","start":166.392},{"w":"that","start":166.872},{"w":"say","start":167.112},{"w":"\"run\".","start":167.352}]},{"id":"c29","start":168.234,"end":175.061,"marks":{},"text":"It helps with new words. Even if \"ungoogleable\" isn't in the dictionary, its pieces are: un, google, able.","words":[{"w":"It","start":168.234},{"w":"helps","start":168.354},{"w":"with","start":168.754},{"w":"new","start":168.914},{"w":"words.","start":169.194},{"w":"Even","start":169.794},{"w":"if","start":170.154},{"w":"\"ungoogleable\"","start":170.654},{"w":"isn't","start":171.154},{"w":"in","start":171.474},{"w":"the","start":171.554},{"w":"dictionary,","start":171.674},{"w":"its","start":172.314},{"w":"pieces","start":172.554},{"w":"are:","start":173.114},{"w":"un,","start":173.607},{"w":"google,","start":174.101},{"w":"able.","start":174.594}]},{"id":"c30","start":175.461,"end":183.158,"marks":{},"text":"And it matters even more in languages like Turkish or Finnish, where one long word can hold what English says in a whole sentence.","words":[{"w":"And","start":175.461},{"w":"it","start":175.581},{"w":"matters","start":175.741},{"w":"even","start":176.141},{"w":"more","start":176.461},{"w":"in","start":176.661},{"w":"languages","start":176.861},{"w":"like","start":177.501},{"w":"Turkish","start":177.701},{"w":"or","start":178.261},{"w":"Finnish,","start":178.501},{"w":"where","start":179.141},{"w":"one","start":179.461},{"w":"long","start":179.741},{"w":"word","start":180.101},{"w":"can","start":180.341},{"w":"hold","start":180.541},{"w":"what","start":180.821},{"w":"English","start":181.061},{"w":"says","start":181.541},{"w":"in","start":181.861},{"w":"a","start":182.061},{"w":"whole","start":182.221},{"w":"sentence.","start":182.501}]}],"title":"Why NLP cares","shortTitle":"Why NLP cares","props":{"kicker":"Why it matters","title":"Why NLP cares about word parts","items":[{"text":"Fewer things to learn: walk, walks, walked"},{"text":"Search for “running”, also find “run”"},{"text":"Make sense of new words: un + google + able"},{"text":"Vital for languages like Turkish and Finnish"}],"numbered":false},"start":153.967,"end":183.158,"startFrame":4619,"durationInFrames":903},{"id":"quiz","kind":"quiz","component":"Quiz","short":true,"cues":[{"id":"c31","start":184.067,"end":187.98,"marks":{},"text":"Time for a quick quiz. How many morphemes are in the word \"unbreakable\"?","words":[{"w":"Time","start":184.067},{"w":"for","start":184.387},{"w":"a","start":184.657},{"w":"quick","start":184.927},{"w":"quiz.","start":185.197},{"w":"How","start":185.467},{"w":"many","start":185.667},{"w":"morphemes","start":186.107},{"w":"are","start":186.547},{"w":"in","start":186.707},{"w":"the","start":186.787},{"w":"word","start":186.947},{"w":"\"unbreakable\"?","start":187.187}]},{"id":"c32","start":188.38,"end":190.486,"marks":{},"text":"Pause the video and count the pieces.","words":[{"w":"Pause","start":188.38},{"w":"the","start":188.7},{"w":"video","start":188.98},{"w":"and","start":189.26},{"w":"count","start":189.5},{"w":"the","start":189.74},{"w":"pieces.","start":189.9}]},{"id":"c33","start":193.886,"end":198.84,"marks":{},"text":"The answer is three: \"un\", \"break\", and \"able\". A prefix, a root, and a suffix.","words":[{"w":"The","start":193.886},{"w":"answer","start":194.046},{"w":"is","start":194.406},{"w":"three:","start":194.606},{"w":"\"un\",","start":195.046},{"w":"\"break\",","start":195.486},{"w":"and","start":195.926},{"w":"\"able\".","start":196.126},{"w":"A","start":196.686},{"w":"prefix,","start":196.886},{"w":"a","start":197.486},{"w":"root,","start":197.606},{"w":"and","start":197.926},{"w":"a","start":198.086},{"w":"suffix.","start":198.206}]}],"title":"Quick quiz","shortTitle":"Quick quiz: how many pieces in “unbreakable”?","props":{"kicker":"Pause and predict","question":"How many morphemes are in the word “unbreakable”?","options":["1","2","3","4"],"answer":2,"explain":"un + break + able: a prefix, a root and a suffix."},"start":184.067,"end":198.84,"startFrame":5522,"durationInFrames":471},{"id":"recap","kind":"recap","component":"Recap","short":false,"cues":[{"id":"c34","start":199.767,"end":204.219,"marks":{},"text":"Let's recap. A morpheme is the smallest piece of a word that carries meaning.","words":[{"w":"Let's","start":199.767},{"w":"recap.","start":200.127},{"w":"A","start":200.767},{"w":"morpheme","start":200.967},{"w":"is","start":201.607},{"w":"the","start":201.727},{"w":"smallest","start":201.887},{"w":"piece","start":202.367},{"w":"of","start":202.607},{"w":"a","start":202.727},{"w":"word","start":202.887},{"w":"that","start":203.127},{"w":"carries","start":203.327},{"w":"meaning.","start":203.767}]},{"id":"c35","start":204.619,"end":209.029,"marks":{},"text":"Free morphemes can stand alone; bound morphemes have to attach to something.","words":[{"w":"Free","start":204.619},{"w":"morphemes","start":205.059},{"w":"can","start":205.499},{"w":"stand","start":205.739},{"w":"alone;","start":206.059},{"w":"bound","start":206.699},{"w":"morphemes","start":207.179},{"w":"have","start":207.659},{"w":"to","start":207.819},{"w":"attach","start":207.939},{"w":"to","start":208.379},{"w":"something.","start":208.579}]},{"id":"c36","start":209.429,"end":213.23,"marks":{},"text":"Inflection changes a word's form; derivation builds a new word.","words":[{"w":"Inflection","start":209.429},{"w":"changes","start":210.069},{"w":"a","start":210.549},{"w":"word's","start":210.709},{"w":"form;","start":211.029},{"w":"derivation","start":211.469},{"w":"builds","start":212.189},{"w":"a","start":212.589},{"w":"new","start":212.709},{"w":"word.","start":212.989}]},{"id":"c37","start":213.63,"end":218.268,"marks":{},"text":"And stemming chops endings by rule, while lemmatization looks up the real root.","words":[{"w":"And","start":213.63},{"w":"stemming","start":213.79},{"w":"chops","start":214.27},{"w":"endings","start":214.75},{"w":"by","start":215.23},{"w":"rule,","start":215.47},{"w":"while","start":215.91},{"w":"lemmatization","start":216.15},{"w":"looks","start":216.99},{"w":"up","start":217.27},{"w":"the","start":217.43},{"w":"real","start":217.55},{"w":"root.","start":217.87}]},{"id":"c38","start":218.668,"end":223.661,"marks":{},"text":"Next lesson: POS Tagging. How does a computer tell 'book a flight' from 'read a book'?","words":[{"w":"Next","start":219.088},{"w":"lesson:","start":219.508},{"w":"POS","start":219.928},{"w":"Tagging.","start":220.348},{"w":"How","start":220.948},{"w":"does","start":221.188},{"w":"a","start":221.428},{"w":"computer","start":221.548},{"w":"tell","start":221.988},{"w":"'book","start":222.188},{"w":"a","start":222.388},{"w":"flight'","start":222.508},{"w":"from","start":222.788},{"w":"'read","start":222.988},{"w":"a","start":223.188},{"w":"book'?","start":223.348}]}],"title":"Recap and next lesson","shortTitle":"Recap and next lesson","props":{"title":"Recap","points":["A morpheme is the smallest piece of meaning","Free morphemes stand alone; bound ones attach","Inflection changes the form; derivation makes a new word","Stemming chops; lemmatization looks up the real root"],"next":{"title":"POS Tagging","question":"How does a computer tell 'book a flight' from 'read a book'?"}},"start":199.767,"end":223.661,"startFrame":5993,"durationInFrames":762}],"refs":{"c01":0.6,"c02":6.811,"c03":13.567,"c04":20.9,"c05":27.251,"c06":34.476,"c07":41.6,"c08":43.656,"c09":49.224,"c09@verdict":56.984,"c10":59.867,"c11":66.572,"c12":69.899,"c13":73.327,"c14":77.037,"c15":81.56,"c16":85.967,"c17":89.978,"c18":99.391,"c19":109.246,"c19@verdict":111.086,"c20":115.667,"c21":124.249,"c22":135.788,"c23":141.328,"c24":143.319,"c25":148.188,"c26":153.967,"c27":158.011,"c28":163.192,"c29":168.234,"c30":175.461,"c31":184.067,"c32":18