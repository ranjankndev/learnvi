at","start":21.567},{"w":"a","start":21.727},{"w":"time,","start":21.887},{"w":"each","start":22.287},{"w":"time","start":22.527},{"w":"guessing","start":22.767},{"w":"what","start":23.247},{"w":"should","start":23.447},{"w":"come","start":23.647},{"w":"next.","start":23.887},{"w":"That's","start":24.527},{"w":"it.","start":24.967},{"w":"That's","start":25.287},{"w":"the","start":25.647},{"w":"whole","start":25.807},{"w":"trick.","start":26.047}]}],"title":"One token at a time","shortTitle":"One token at a time","props":{"kicker":"Episode 6","text":"Every answer is written one token at a time, by guessing what comes next.","highlight":["one","token","guessing"]},"start":13.733,"end":26.46,"startFrame":412,"durationInFrames":409},{"id":"route","kind":"routeMap","component":"RouteMap","short":false,"cues":[{"id":"c05","start":27.367,"end":33.598,"marks":{"here":30.407},"text":"On the route map, we've left Attention Junction, and we're here, at Prediction Station, where the answer gets written.","words":[{"w":"On","start":27.367},{"w":"the","start":27.487},{"w":"route","start":27.647},{"w":"map,","start":27.967},{"w":"we've","start":28.327},{"w":"left","start":28.647},{"w":"Attention","start":28.887},{"w":"Junction,","start":29.447},{"w":"and","start":29.927},{"w":"we're","start":30.167},{"w":"here,","start":30.407},{"w":"at","start":30.727},{"w":"Prediction","start":30.887},{"w":"Station,","start":31.447},{"w":"where","start":32.087},{"w":"the","start":32.247},{"w":"answer","start":32.487},{"w":"gets","start":32.887},{"w":"written.","start":33.207}]}],"title":"Route map","shortTitle":"Route map","props":{"current":"ep06","highlightAt":"c05@here"},"start":27.367,"end":33.598,"startFrame":821,"durationInFrames":214},{"id":"guess","kind":"core","component":"Quiz","short":false,"cues":[{"id":"c06","start":34.5,"end":40.874,"marks":{},"text":"Let's warm up. Pause and predict: \"The cat sat on the...\" What word comes next? Mat, moon, or piano?","words":[{"w":"Let's","start