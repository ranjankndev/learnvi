":104.107},{"w":"of","start":104.587},{"w":"them.","start":104.747}]},{"id":"c16","start":105.381,"end":106.496,"marks":{},"text":"Pick: choose one.","words":[{"w":"Pick:","start":105.381},{"w":"choose","start":105.701},{"w":"one.","start":106.141}]},{"id":"c17","start":106.896,"end":115.416,"marks":{},"text":"Add it, and repeat, until the model picks a special stop token that means \"I'm done\". That's why answers stream onto your screen word by word.","words":[{"w":"Add","start":106.896},{"w":"it,","start":107.176},{"w":"and","start":107.376},{"w":"repeat,","start":107.576},{"w":"until","start":108.176},{"w":"the","start":108.496},{"w":"model","start":108.656},{"w":"picks","start":109.056},{"w":"a","start":109.296},{"w":"special","start":109.416},{"w":"stop","start":109.816},{"w":"token","start":110.136},{"w":"that","start":110.656},{"w":"means","start":110.896},{"w":"\"I'm","start":111.296},{"w":"done\".","start":111.696},{"w":"That's","start":112.256},{"w":"why","start":112.736},{"w":"answers","start":113.016},{"w":"stream","start":113.456},{"w":"onto","start":113.776},{"w":"your","start":114.016},{"w":"screen","start":114.136},{"w":"word","start":114.576},{"w":"by","start":114.856},{"w":"word.","start":115.096}]}],"title":"The writing loop","shortTitle":"The writing loop","props":{"kicker":"The loop","title":"The same four steps, for every single token","steps":[{"label":"Read","detail":"the prompt and the answer so far"},{"label":"Score","detail":"a chance for every token it knows"},{"label":"Pick","detail":"choose one token"},{"label":"Add & repeat","detail":"until it picks a stop token"}]},"start":93.367,"end":115.416,"startFrame":2801,"durationInFrames":689},{"id":"sampling","kind":"core","component":"Definition","short":false,"cues":[{"id":"c18","start":116.333,"end":127.256,"marks":{},"text":"Now, back to that thought. Why did it pick tap and not the favourite? Because of sampling: picking the next token at random, weighted by its chance, instead of always taking the top one.","words":[{"w":"Now,","start":116.333},{"w":"back","start":116.733},{"w":"to","start":117.053},{"w":"that","start":117.213},{"w":"thought.","start":117.493},{"w":"Why","start":117.933},{"w":"did","start":118.253},{"w":"it","start":118.413},{"w":"pick","start":118.573},{"w":"tap","start":118.813},{"w":"and","start":119.133},{"w":"not","start":119.293},{"w":"the","start":119.493},{"w":"favourite?","start":119.693},{"w":"Because","start":120.453},{"w":"of","start":120.773},{"w":"sampling:","start":120.973},{"w":"picking","start":121.773},{"w":"the","start":122.173},{"w":"next","start":122.333},{"w":"token","start":122.653},{"w":"at","start":123.053},{"w":"random,","start":123.213},{"w":"weighted","start":123.713},{"w":"by","start":124.213},{"w":"its","start":124.413},{"w":"chance,","start":124.653},{"w":"instead","start":125.133},{"w":"of","start":125.573},{"w":"always","start":125.733},{"w":"taking","start":126.093},{"w":"the","start":126.453},{"w":"top","start":126.613},{"w":"one.","start":126.933}]},{"id":"c19","start":127.656,"end":136.536,"marks":{},"text":"Drops had thirty-one percent and rain had twenty-four, so either one could be picked. The bigger the chance, the more often it wins, but not every time.","words":[{"w":"Drops","start":127.656},{"w":"had","start":128.096},{"w":"thirty-one","start":128.509},{"w":"percent","start":128.923},{"w":"and","start":129.336},{"w":"rain","start":129.496},{"w":"had","start":129.856},{"w":"twenty-four,","start":130.316},{"w":"so","start":130.776},{"w":"either","start":130.976},{"w":"one","start":131.376},{"w":"could","start":131.576},{"w":"be","start":131.736},{"w":"picked.","start":131.936},{"w":"The","start":132.456},{"w":"bigger","start":132.736},{"w":"the","start":133.176},{"w":"chance,","start":133.376},{"w":"the","start":133.816},{"w":"more","start":134.016},{"w":"often","start":134.256},{"w":"it","start":134.576},{"w":"wins,","start":134.776},{"w":"but","start":135.216},{"w":"not","start":135.456},{"w":"every","start":135.736},{"w":"time.","start":136.136}]},{"id":"c20","start":136.936,"end":147.44,"marks":{},"text":"Think of rolling a weighted die. The big faces come up most often, but not every time. That bit of randomness is why the same question can get a different answer each time.","words":[{"w":"Think","start":136.936},{"w":"of","start":137.136},{"w":"rolling","start":137.336},{"w":"a","start":137.816},{"w":"weighted","start":137.976},{"w":"die.","start":138.476},{"w":"The","start":138.976},{"w":"big","start":139.256},{"w":"faces","start":139.616},{"w":"come","start":140.056},{"w":"up","start":140.296},{"w":"most","start":140.496},{"w":"often,","start":140.736},{"w":"but","start":141.256},{"w":"not","start":141.536},{"w":"every","start":141.896},{"w":"time.","start":142.296},{"w":"That","start":142.776},{"w":"bit","start":143.096},{"w":"of","start":143.336},{"w":"randomness","start":143.716},{"w":"is","start":144.096},{"w":"why","start":144.296},{"w":"the","start":144.496},{"w":"same","start":144.803},{"w":"question","start":145.109},{"w":"can","start":145.416},{"w":"get","start":145.616},{"w":"a","start":145.776},{"w":"different","start":145.896},{"w":"answer","start":146.296},{"w":"each","start":146.696},{"w":"time.","start":147.096}]}],"title":"Sampling","shortTitle":"Sampling","props":{"kicker":"Why not always the top one?","term":"Sampling","definition":"Picking the next token at random, weighted by its chance, instead of always taking the top choice.","example":"“drops” 31%, “rain” 24%: either one could be picked","analogy":"Rolling a weighted die: the big faces come up most often, but not every time."},"start":116.333,"end":147.44,"startFrame":3490,"durationInFrames":961},{"id":"temperature","kind":"core","component":"Temperature","short":false,"cues":[{"id":"c21","start":148.367,"end":156.059,"marks":{},"text":"And there's a dial that controls how much randomness you get: temperature. At the normal setting, the chances are used as they are.","words":[{"w":"And","start":148.367},{"w":"there's","start":148.447},{"w":"a","start":148.687},{"w":"dial","start":148.847},{"w":"that","start":149.167},{"w":"controls","start":149.367},{"w":"how","start":149.967},{"w":"much","start":150.167},{"w":"randomness","start":150.607},{"w":"you","start":151.047},{"w":"get:","start":151.247},{"w":"temperature.","start":151.647},{"w":"At","start":152.687},{"w":"the","start":152.887},{"w":"normal","start":153.087},{"w":"setting,","start":153.567},{"w":"the","start":154.007},{"w":"chances","start":154.207},{"w":"are","start":154.767},{"w":"used","start":155.007},{"w":"as","start":155.327},{"w":"they","start":155.567},{"w":"are.","start":155.767}]},{"id":"c22","start":156.459,"end":165.94,"marks":{},"text":"Turn the temperature down, and the favourites get even stronger. On now wins almost every time. Answers become safe, focused, and a little predictable.","words":[{"w":"Turn","start":156.459},{"w":"the","start":156.699},{"w":"temperature","start":156.859},{"w":"down,","start":157.459},{"w":"and","start":157.739},{"w":"the","start":157.899},{"w":"favourites","start":158.059},{"w":"get","start":158.579},{"w":"even","start":158.819},{"w":"stronger.","start":159.139},{"w":"On","start":159.899},{"w":"now","start":160.219},{"w":"wins","start":160.539},{"w":"almost","start":160.979},{"w":"every","start":161.419},{"w":"time.","start":161.819},{"w":"Answers","start":162.459},{"w":"become","start":163.059},{"w":"safe,","start":163.539},{"w":"focused,","start":164.059},{"w":"and","start":164.659},{"w":"a","start":164.859},{"w":"little","start":164.939},{"w":"predictable.","start":165.219}]},{"id":"c23","start":166.34,"end":175.859,"marks":{},"text":"Turn it up, and the chances even out. Tap, of, even dance get a real shot. Answers become surprising and creative, and sometimes a bit strange.","words":[{"w":"Turn","start":166.34},{"w":"it","start":166.66},{"w":"up,","start":166.82},{"w":"and","start":167.02},{"w":"the","start":167.14},{"w":"chances","start":167.3},{"w":"even","start":167.86},{"w":"out.","start":168.22},{"w":"Tap,","start":168.7},{"w":"of,","start":169.22},{"w":"even","start":169.54},{"w":"dance","start":169.9},{"w":"get","start":170.34},{"w":"a","start":170.5},{"w":"real","start":170.62},{"w":"shot.","start":170.98},{"w":"Answers","start":171.7},{"w":"become","start":172.26},{"w":"surprising","start":172.66},{"w":"and","start":173.3},{"w":"creative,","start":173.5},{"w":"and","start":174.1},{"w":"sometimes","start":174.34},{"w":"a","start":174.86},{"w":"bit","start":175.02},{"w":"strange.","start":175.3}]},{"id":"c24","start":176.259,"end":179.452,"marks":{},"text":"Same model, same prompt. Only the dial changed.","words":[{"w":"Same","start":176.259},{"w":"model,","start":176.579},{"w":"same","start":177.059},{"w":"prompt.","start":177.339},{"w":"Only","start":177.939},{"w":"the","start":178.259},{"w":"dial","start":178.419},{"w":"changed.","start":178.899}]}],"title":"Temperature","shortTitle":"Temperature","props":{"kicker":"The creativity dial","title":"Temperature reshapes the chances","context":"Soft drops","options":[{"token":" on","p":0.28},{"token":" fall","p":0.22},{"token":" tap","p":0.17},{"token":" of","p":0.1},{"token":" dance","p":0.04}],"settings":[{"t":1,"label":"normal","at":"c21"},{"t":0.3,"label":"low: safe","at":"c22"},{"t":1.8,"label":"high: wild","at":"c23"}]},"start":148.367,"end":179.452,"startFrame":4451,"durationInFrames":960},{"id":"hallucinate","kind":"core","component":"Bullets","short":false,"cues":[{"id":"c25","start":180.367,"end":188.265,"marks":{},"text":"This also explains one of the most important facts about chatbots: why they sometimes make things up. People call it hallucination.","words":[{"w":"This","start":180.367},{"w":"also","start":180.607},{"w":"explains","start":180.927},{"w":"one","start":181.567},{"w":"of","start":181.727},{"w":"the","start":181.847},{"w":"most","start":181.967},{"w":"important","start":182.207},{"w":"facts","start":182.767},{"w":"about","start":183.167},{"w":"chatbots:","start":183.407},{"w":"why","start":184.247},{"w":"they","start":184.487},{"w":"sometimes","start":184.687},{"w":"make","start":185.327},{"w":"things","start":185.607},{"w":"up.","start":185.967},{"w":"People","start":186.367},{"w":"call","start":186.767},{"w":"it","start":187.007},{"w":"hallucination.","start":187.247}]},{"id":"c26","start":188.665,"end":192.369,"marks":{},"text":"Remember, the model is always predicting the next likely token.","words":[{"w":"Remember,","start":188.665},{"w":"the","start":189.225},{"w":"model","start":189.465},{"w":"is","start":189.905},{"w":"always","start":190.145},{"w":"predicting","start":190.505},{"w":"the","start":190.985},{"w":"next","start":191.145},{"w":"likely","start":191.465},{"w":"token.","start":191.825}]},{"id":"c27","start":192.769,"end":198.63,"marks":{},"text":"So it predicts what sounds right, not what is true. Usually those are the same. Sometimes, they aren't.","words":[{"w":"So","start":192.769},{"w":"it","start":192.889},{"w":"predicts","start":193.049},{"w":"what","start":193.489},{"w":"sounds","start":193.689},{"w":"right,","start":194.049},{"w":"not","start":194.329},{"w":"what","start":194.569},{"w":"is","start":194.729},{"w":"true.","start":194.929},{"w":"Usually","start":195.409},{"w":"those","start":196.009},{"w":"are","start":196.289},{"w":"the","start":196.449},{"w":"same.","start":196.649},{"w":"Sometimes,","start":197.169},{"w":"they","start":197.969},{"w":"aren't.","start":198.209}]},{"id":"c28","start":199.03,"end":207.775,"marks":{},"text":"It only says \"I don't know\" if it learned that saying it fits the moment. Otherwise, a confident guess is just another likely-sounding next token.","words":[{"w":"It","start":199.03},{"w":"only","start":199.27},{"w":"says","start":199.59},{"w":"\"I","start":199.91},{"w":"don't","start":200.11},{"w":"know\"","start":200.39},{"w":"if","start":200.63},{"w":"it","start":200.83},{"w":"learned","start":200.99},{"w":"that","start":201.31},{"w":"saying","start":201.51},{"w":"it","start":201.83},{"w":"fits","start":201.99},{"w":"the","start":202.35},{"w":"moment.","start":202.51},{"w":"Otherwise,","start":203.23},{"w":"a","start":204.11},{"w":"confident","start":204.31},{"w":"guess","start":204.99},{"w":"is","start":205.35},{"w":"just","start":205.55},{"w":"another","start":205.83},{"w":"likely-sounding","start":206.39},{"w":"next","start":206.95},{"w":"token.","start":207.27}]},{"id":"c29","start":208.175,"end":215.429,"marks":{},"text":"And rare facts get blurry. Exact dates, numbers, quotes, and citations are where made-up answers hide most often.","words":[{"w":"And","start":208.175},{"w":"rare","start":208.335},{"w":"facts","start":208.655},{"w":"get","start":209.055},{"w":"blurry.","start":209.255},{"w":"Exact","start":210.015},{"w":"dates,","start":210.515},{"w":"numbers,","start":211.015},{"w":"quotes,","start":211.515},{"w":"and","start":212.015},{"w":"citations","start":212.175},{"w":"are","start":213.055},{"w":"where","start":213.255},{"w":"made-up","start":213.595},{"w":"answers","start":213.935},{"w":"hide","start":214.415},{"w":"most","start":214.735},{"w":"often.","start":214.975}]}],"title":"Why it makes things up","shortTitle":"Why it makes things up","props":{"kicker":"Hallucinations","title":"Why it sometimes makes things up","items":[{"text":"It predicts what sounds right, not what is true"},{"text":"It only says “I don't know” if it learned to"},{"text":"Rare facts get blurry: dates, numbers, citations"}],"numbered":false},"start":180.367,"end":215.429,"startFrame":5411,"durationInFrames":1079},{"id":"safer","kind":"core","component":"Compare","short":false,"cues":[{"id":"c33","start":216.333,"end":219.142,"marks":{},"text":"So when should you double-check? Here's a simple guide.","words":[{"w":"So","start":216.333},{"w":"when","start":216.493},{"w":"should","start":216.693},{"w":"you","start":216.853},{"w":"double-check?","start":217.313},{"w":"Here's","start":217.773},{"w":"a","start":218.133},{"w":"simple","start":218.253},{"w":"guide.","start":218.653}]},{"id":"c34","start":219.542,"end":225.383,"marks":{},"text":"Riskier: exact dates and numbers, quotes and citations, and very recent or niche facts.","words":[{"w":"Riskier:","start":219.542},{"w":"exact","start":220.262},{"w":"dates","start":220.742},{"w":"and","start":221.142},{"w":"numbers,","start":221.542},{"w":"quotes","start":221.942},{"w":"and","start":222.342},{"w":"citations,","start":222.502},{"w":"and","start":223.342},{"w":"very","start":223.622},{"w":"recent","start":223.902},{"w":"or","start":224.222},{"w":"niche","start":224.542},{"w":"facts.","start":224.862}]},{"id":"c35","start":225.783,"end":232.735,"marks":{},"text":"Safer: give the model the source text yourself, ask it to quote from that source, or turn on web search so it can check.","words":[{"w":"Safer:","start":225.783},{"w":"give","start":226.343},{"w":"the","start":226.543},{"w":"model","start":226.703},{"w":"the","start":227.063},{"w":"source","start":227.223},{"w":"text","start":227.543},{"w":"yourself,","start":227.943},{"w":"ask","start":228.623},{"w":"it","start":228.943},{"w":"to","start":229.143},{"w":"quote","start":229.343},{"w":"from","start":229.543},{"w":"that","start":229.703},{"w":"source,","start":229.943},{"w":"or","start":230.463},{"w":"turn","start":230.743},{"w":"on","start":231.063},{"w":"web","start":231.263},{"w":"search","start":231.543},{"w":"so","start":231.863},{"w":"it","start":232.023},{"w":"can","start":232.183},{"w":"check.","start":232.343}]},{"id":"c36","start":233.135,"end":237.682,"marks":{},"text":"The golden rule: fluent is not the same as true. Check anything that matters.","words":[{"w":"The","start":233.135},{"w":"golden","start":233.255},{"w":"rule:","start":233.735},{"w":"fluent","start":234.095},{"w":"is","start":234.615},{"w":"not","start":234.775},{"w":"the","start":234.975},{"w":"same","start":235.095},{"w":"as","start":235.375},{"w":"true.","start":235.575},{"w":"Check","start":236.095},{"w":"anything","start":236.455},{"w":"that","start":236.855},{"w":"matters.","start":237.055}]}],"title":"When to double-check","shortTitle":"When to double-check","props":{"kicker":"Staying safe","title":"Where made-up answers hide","columns":[{"title":"Riskier","items":["exact dates and numbers","quotes and citations","very recent or niche facts"],"tone":"bad"},{"title":"Safer","items":["give it the source text","ask it to quote the source","turn on web search"],"tone":"good"}],"verdict":{"text":"Fluent is not the same as true: check anything that matters"}},"start":216.333,"end":237.682,"startFrame":6490,"durationInFrames":668},{"id":"tryIt","kind":"tryIt","component":"TryIt","short":false,"cues":[{"id":"c37","start":238.6,"end":247.993,"marks":{},"text":"Time for \"Try it yourself\": write the same poem at low and high creativity. Most chat apps hide the temperature dial, so we'll ask for it in words.","words":[{"w":"Time","start":238.6},{"w":"for","start":238.92},{"w":"\"Try","start":239.12},{"w":"it","start":239.44},{"w":"yourself\":","start":239.6},{"w":"write","start":240.32},{"w":"the","start":240.68},{"w":"same","start":240.84},{"w":"poem","start":241.12},{"w":"at","start":241.6},{"w":"low","start":241.8},{"w":"and","start":242.16},{"w":"high","start":242.36},{"w":"creativity.","start":242.68},{"w":"Most","start":243.84},{"w":"chat","start":244.24},{"w":"apps","start":244.56},{"w":"hide","start":244.88},{"w":"the","start":245.12},{"w":"temperature","start":245.24},{"w":"dial,","start":245.8},{"w":"so","start":246.2},{"w":"we'll","start":246.44},{"w":"ask","start":246.68},{"w":"for","start":246.96},{"w":"it","start":247.12},{"w":"in","start":247.32},{"w":"words.","start":247.56}]},{"id":"c38","start":248.393,"end":254.629,"marks":{},"text":"Ask for our rain poem three times, and add: \"be very predictable\". Notice how similar the poems are.","words":[{"w":"Ask","start":248.393},{"w":"for","start":248.71