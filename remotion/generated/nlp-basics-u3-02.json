{"key":"nlp-basics-u3-02","seriesId":"nlp-basics","episode":"u3-02","title":"Dependency Parsing: Who Did What to Whom","fps":30,"duration":203.878,"durationInFrames":6116,"video":{"width":1920,"height":1080,"burnCaptions":true,"brand":"learnvi.in"},"badge":["UNIT 3 · LESSON 2","DEPENDENCY PARSING"],"series":{"title":"NLP, Simply Explained","subtitle":"University NLP, one idea at a time, no heavy maths","runningPrompt":"","stops":[{"id":"u1-01","number":1,"name":"The Stages of NLP: From Letters to Meaning","stamp":"THE STAGES OF NLP: FROM LETTERS TO MEANING","topic":""},{"id":"u1-02","number":2,"name":"Tokenization: How Text Becomes Pieces","stamp":"TOKENIZATION: HOW TEXT BECOMES PIECES","topic":""},{"id":"u1-03","number":3,"name":"Text Classification: Teaching Computers to Sort Text","stamp":"TEXT CLASSIFICATION: TEACHING COMPUTERS TO SORT TEXT","topic":""},{"id":"u1-04","number":4,"name":"Language Models: Guessing the Next Word","stamp":"LANGUAGE MODELS: GUESSING THE NEXT WORD","topic":""},{"id":"u2-01","number":5,"name":"Morphology: The Building Blocks Inside Words","stamp":"MORPHOLOGY: THE BUILDING BLOCKS INSIDE WORDS","topic":""},{"id":"u2-02","number":6,"name":"Part-of-Speech Tagging: Is It a Noun or a Verb?","stamp":"PART-OF-SPEECH TAGGING: IS IT A NOUN OR A VERB?","topic":""},{"id":"u2-03","number":7,"name":"Chunking: Grouping Words into Phrases","stamp":"CHUNKING: GROUPING WORDS INTO PHRASES","topic":""},{"id":"u2-04","number":8,"name":"Generative vs Discriminative Models","stamp":"GENERATIVE VS DISCRIMINATIVE MODELS","topic":""},{"id":"u2-05","number":9,"name":"Hidden Markov Models, Intuitively","stamp":"HIDDEN MARKOV MODELS, INTUITIVELY","topic":""},{"id":"u2-06","number":10,"name":"Conditional Random Fields, Intuitively","stamp":"CONDITIONAL RANDOM FIELDS, INTUITIVELY","topic":""},{"id":"u3-01","number":11,"name":"Constituency Parsing: Sentences as Trees","stamp":"CONSTITUENCY PARSING: SENTENCES AS TREES","topic":""},{"id":"u3-02","number":12,"name":"Dependency Parsing: Who Did What to Whom","stamp":"DEPENDENCY PARSING: WHO DID WHAT TO WHOM","topic":""},{"id":"u3-03","number":13,"name":"Transition-Based Parsing: Building Trees Step by Step","stamp":"TRANSITION-BASED PARSING: BUILDING TREES STEP BY STEP","topic":""},{"id":"u4-01","number":14,"name":"Word Vectors: Giving Words a Place on a Map","stamp":"WORD VECTORS: GIVING WORDS A PLACE ON A MAP","topic":""},{"id":"u4-02","number":15,"name":"Word2Vec: Learning Word Vectors from Context","stamp":"WORD2VEC: LEARNING WORD VECTORS FROM CONTEXT","topic":""},{"id":"u4-03","number":16,"name":"Recurrent Neural Networks: Reading with Memory","stamp":"RECURRENT NEURAL NETWORKS: READING WITH MEMORY","topic":""},{"id":"u4-04","number":17,"name":"LSTMs: Remembering What Matters","stamp":"LSTMS: REMEMBERING WHAT MATTERS","topic":""},{"id":"u5-01","number":18,"name":"Contextual Embeddings and ELMo","stamp":"CONTEXTUAL EMBEDDINGS AND ELMO","topic":""},{"id":"u5-02","number":19,"name":"BERT: Reading in Both Directions","stamp":"BERT: READING IN BOTH DIRECTIONS","topic":""}]},"stop":{"number":12,"name":"Dependency Parsing: Who Did What to Whom","stamp":"DEPENDENCY PARSING: WHO DID WHAT TO WHOM"},"shorts":{"width":1080,"height":1920,"maxSeconds":60,"cta":"Full lesson: NLP, Simply Explained · Unit 3"},"thumbnail":{"headline":"Who did what to whom?","big":"Priya → ate → pizza"},"segments":[{"id":"intro","kind":"intro","component":"TitleCard","short":false,"cues":[{"id":"c01","start":0.6,"end":6.895,"marks":{},"text":"Welcome back to NLP, Simply Explained. This is unit 3, lesson 2: dependency parsing.","words":[{"w":"Welcome","start":0.6},{"w":"back","start":1.08},{"w":"to","start":1.427},{"w":"NLP,","start":1.773},{"w":"Simply","start":2.12},{"w":"Explained.","start":2.72},{"w":"This","start":3.52},{"w":"is","start":3.8},{"w":"unit","start":4.04},{"w":"3,","start":4.44},{"w":"lesson","start":4.84},{"w":"2:","start":5.24},{"w":"dependency","start":5.56},{"w":"parsing.","start":6.36}]},{"id":"c02","start":7.295,"end":14.072,"marks":{},"text":"Last time we drew sentences as trees of phrases. Today we draw them a different way: as links between words.","words":[{"w":"Last","start":7.295},{"w":"time","start":7.615},{"w":"we","start":7.855},{"w":"drew","start":8.015},{"w":"sentences","start":8.255},{"w":"as","start":8.895},{"w":"trees","start":9.095},{"w":"of","start":9.455},{"w":"phrases.","start":9.655},{"w":"Today","start":10.315},{"w":"we","start":10.975},{"w":"draw","start":11.215},{"w":"them","start":11.495},{"w":"a","start":11.655},{"w":"different","start":11.775},{"w":"way:","start":12.175},{"w":"as","start":12.495},{"w":"links","start":12.735},{"w":"between","start":13.255},{"w":"words.","start":13.615}]}],"title":"Welcome","shortTitle":"Welcome","props":{"kicker":"Unit 3 · Lesson 2","title":"Dependency Parsing","subtitle":"Who did what to whom"},"start":0.6,"end":14.072,"startFrame":0,"durationInFrames":450},{"id":"idea","kind":"core","component":"BigIdea","short":false,"cues":[{"id":"c03","start":15,"end":23.634,"marks":{},"text":"Here's the idea. In a dependency tree, every word hangs off exactly one other word, and the main verb usually sits at the very top.","words":[{"w":"Here's","start":15},{"w":"the","start":15.36},{"w":"idea.","start":15.56},{"w":"In","start":16.24},{"w":"a","start":16.48},{"w":"dependency","start":16.68},{"w":"tree,","start":17.52},{"w":"every","start":18},{"w":"word","start":18.36},{"w":"hangs","start":18.68},{"w":"off","start":19.12},{"w":"exactly","start":19.4},{"w":"one","start":20},{"w":"other","start":20.24},{"w":"word,","start":20.56},{"w":"and","start":20.88},{"w":"the","start":21.08},{"w":"main","start":21.373},{"w":"verb","start":21.667},{"w":"usually","start":21.96},{"w":"sits","start":22.36},{"w":"at","start":22.72},{"w":"the","start":22.84},{"w":"very","start":22.96},{"w":"top.","start":23.24}]}],"title":"The big idea","shortTitle":"The big idea","props":{"kicker":"Key idea","text":"Every word hangs off another word, and the main verb sits at the top.","highlight":["hangs","main verb"]},"start":15,"end":23.634,"startFrame":450,"durationInFrames":287},{"id":"dep","kind":"core","component":"Definition","short":false,"cues":[{"id":"c04","start":24.567,"end":31.08,"marks":{},"text":"A dependency is a link from a head word to a word that depends on it, with a label saying how they're related.","words":[{"w":"A","start":24.567},{"w":"dependency","start":24.727},{"w":"is","start":25.527},{"w":"a","start":25.727},{"w":"link","start":25.807},{"w":"from","start":26.167},{"w":"a","start":26.287},{"w":"head","start":26.54},{"w":"word","start":26.794},{"w":"to","start":27.047},{"w":"a","start":27.247},{"w":"word","start":27.447},{"w":"that","start":27.687},{"w":"depends","start":27.927},{"w":"on","start":28.407},{"w":"it,","start":28.567},{"w":"with","start":28.847},{"w":"a","start":29.007},{"w":"label","start":29.167},{"w":"saying","start":29.607},{"w":"how","start":30.007},{"w":"they're","start":30.267},{"w":"related.","start":30.527}]},{"id":"c05","start":31.48,"end":37.15,"marks":{},"text":"In \"Priya ate pizza\", the word \"pizza\" depends on \"ate\". It's the object: the thing that was eaten.","words":[{"w":"In","start":31.48},{"w":"\"Priya","start":31.733},{"w":"ate","start":31.987},{"w":"pizza\",","start":32.24},{"w":"the","start":32.76},{"w":"word","start":32.92},{"w":"\"pizza\"","start":33.2},{"w":"depends","start":33.68},{"w":"on","start":34.16},{"w":"\"ate\".","start":34.5},{"w":"It's","start":34.84},{"w":"the","start":35.16},{"w":"object:","start":35.36},{"w":"the","start":35.92},{"w":"thing","start":36.12},{"w":"that","start":36.36},{"w":"was","start":36.52},{"w":"eaten.","start":36.68}]},{"id":"c06","start":37.55,"end":43.648,"marks":{},"text":"Think of a family tree. Every word has exactly one parent, except the root at the top, which has none.","words":[{"w":"Think","start":37.55},{"w":"of","start":37.79},{"w":"a","start":37.91},{"w":"family","start":38.07},{"w":"tree.","start":38.59},{"w":"Every","start":39.15},{"w":"word","start":39.55},{"w":"has","start":39.91},{"w":"exactly","start":40.15},{"w":"one","start":40.75},{"w":"parent,","start":40.95},{"w":"except","start":41.43},{"w":"the","start":41.87},{"w":"root","start":42.03},{"w":"at","start":42.31},{"w":"the","start":42.43},{"w":"top,","start":42.55},{"w":"which","start":42.91},{"w":"has","start":43.11},{"w":"none.","start":43.31}]}],"title":"What is a dependency?","shortTitle":"What is a dependency?","props":{"kicker":"Definition","term":"Dependency","definition":"A link from a head word to a word that depends on it, labelled with how they're related.","example":"ate → pizza  (object)","analogy":"A family tree: every word has one parent, except the root at the top."},"start":24.567,"end":43.648,"startFrame":737,"durationInFrames":600},{"id":"example","kind":"core","component":"Table","short":true,"cues":[{"id":"c07","start":44.567,"end":54.853,"marks":{},"text":"Let's parse \"Priya ate cold pizza\". The labels in brackets are the short names used by Universal Dependencies, a standard used for over a hundred languages.","words":[{"w":"Let's","start":44.567},{"w":"parse","start":44.967},{"w":"\"Priya","start":45.354},{"w":"ate","start":45.74},{"w":"cold","start":46.127},{"w":"pizza\".","start":46.527},{"w":"The","start":47.287},{"w":"labels","start":47.567},{"w":"in","start":48.087},{"w":"brackets","start":48.247},{"w":"are","start":48.807},{"w":"the","start":48.967},{"w":"short","start":49.127},{"w":"names","start":49.487},{"w":"used","start":49.887},{"w":"by","start":50.167},{"w":"Universal","start":50.367},{"w":"Dependencies,","start":51.047},{"w":"a","start":52.087},{"w":"standard","start":52.327},{"w":"used","start":52.807},{"w":"for","start":53.127},{"w":"over","start":53.367},{"w":"a","start":53.607},{"w":"hundred","start":53.767},{"w":"languages.","start":54.087}]},{"id":"c08","start":55.253,"end":59.173,"marks":{},"text":"Priya depends on ate. She's the subject: the one doing the eating.","words":[{"w":"Priya","start":55.433},{"w":"depends","start":55.613},{"w":"on","start":56.053},{"w":"ate.","start":56.373},{"w":"She's","start":56.693},{"w":"the","start":57.093},{"w":"subject:","start":57.253},{"w":"the","start":57.813},{"w":"one","start":58.013},{"w":"doing","start":58.253},{"w":"the","start":58.533},{"w":"eating.","start":58.693}]},{"id":"c09","start":59.573,"end":62.982,"marks":{},"text":"Ate depends on nothing. It's the root of the whole sentence.","words":[{"w":"Ate","start":59.733},{"w":"depends","start":59.893},{"w":"on","start":60.293},{"w":"nothing.","start":60.493},{"w":"It's","start":60.933},{"w":"the","start":61.293},{"w":"root","start":61.453},{"w":"of","start":61.773},{"w":"the","start":61.853},{"w":"whole","start":62.053},{"w":"sentence.","start":62.293}]},{"id":"c10","start":63.382,"end":66.695,"marks":{},"text":"Cold depends on pizza, because it describes the pizza.","words":[{"w":"Cold","start":63.382},{"w":"depends","start":63.782},{"w":"on","start":64.222},{"w":"pizza,","start":64.422},{"w":"because","start":64.982},{"w":"it","start":65.262},{"w":"describes","start":65.422},{"w":"the","start":66.022},{"w":"pizza.","start":66.142}]},{"id":"c11","start":67.095,"end":71.082,"marks":{},"text":"And pizza depends on ate: it's the object, the thing that was eaten.","words":[{"w":"And","start":67.095},{"w":"pizza","start":67.255},{"w":"depends","start":67.695},{"w":"on","start":68.175},{"w":"ate:","start":68.435},{"w":"it's","start":68.695},{"w":"the","start":69.015},{"w":"object,","start":69.215},{"w":"the","start":69.775},{"w":"thing","start":69.975},{"w":"that","start":70.255},{"w":"was","start":70.415},{"w":"eaten.","start":70.615}]}],"title":"A dependency tree","shortTitle":"How AI finds who did what to whom","props":{"kicker":"Worked example","title":"“Priya ate cold pizza”","columns":["Word","Depends on","Relation"],"rows":[["Priya","ate","subject (nsubj)"],["ate","nothing","root"],["cold","pizza","describes it (amod)"],["pizza","ate","object (obj)"]],"highlight":[{"row":1}]},"start":44.567,"end":71.082,"startFrame":1337,"durationInFrames":823},{"id":"versus","kind":"core","component":"Compare","short":false,"cues":[{"id":"c12","start":72,"end":74.364,"marks":{},"text":"How does this compare with last lesson's trees?","words":[{"w":"How","start":72},{"w":"does","start":72.16},{"w":"this","start":72.36},{"w":"compare","start":72.56},{"w":"with","start":72.92},{"w":"last","start":73.24},{"w":"lesson's","start":73.56},{"w":"trees?","start":73.88}]},{"id":"c13","start":74.764,"end":83.341,"marks":{},"text":"A constituency tree nests phrases inside phrases, with labels like noun phrase and verb phrase. It shows the grammatical structure.","words":[{"w":"A","start":74.764},{"w":"constituency","start":74.884},{"w":"tree","start":75.684},{"w":"nests","start":75.964},{"w":"phrases","start":76.364},{"w":"inside","start":76.924},{"w":"phrases,","start":77.404},{"w":"with","start":78.204},{"w":"labels","start":78.444},{"w":"like","start":79.004},{"w":"noun","start":79.244},{"w":"phrase","start":79.564},{"w":"and","start":79.911},{"w":"verb","start":80.257},{"w":"phrase.","start":80.604},{"w":"It","start":81.204},{"w":"shows","start":81.484},{"w":"the","start":81.844},{"w":"grammatical","start":82.004},{"w":"structure.","start":82.764}]},{"id":"c14","start":83.741,"end":93.092,"marks":{},"text":"A dependency tree links words directly, with labels like subject and object. It shows who did what to whom. They're two views of the same sentence.","words":[{"w":"A","start":83.741},{"w":"dependency","start":83.901},{"w":"tree","start":84.621},{"w":"links","start":84.941},{"w":"words","start":85.381},{"w":"directly,","start":85.741},{"w":"with","start":86.421},{"w":"labels","start":86.621},{"w":"like","start":87.181},{"w":"subject","start":87.421},{"w":"and","start":88.021},{"w":"object.","start":88.221},{"w":"It","start":88.941},{"w":"shows","start":89.181},{"w":"who","start":89.661},{"w":"did","start":89.861},{"w":"what","start":90.061},{"w":"to","start":90.261},{"w":"whom.","start":90.461},{"w":"They're","start":90.861},{"w":"two","start":91.141},{"w":"views","start":91.421},{"w":"of","start":91.821},{"w":"the","start":91.941},{"w":"same","start":92.101},{"w":"sentence.","start":92.421}]}],"title":"Two kinds of tree","shortTitle":"Two kinds of tree","props":{"kicker":"Two views","title":"Constituency versus dependency","columns":[{"title":"Constituency","items":["phrases inside phrases","labels like NP, VP, S","shows grammatical structure"],"tone":"neutral"},{"title":"Dependency","items":["links between words","labels like subject, object","shows who did what to whom"],"tone":"neutral"}],"verdict":{"text":"Two views of the same sentence"}},"start":72,"end":93.092,"startFrame":2160,"durationInFrames":660},{"id":"read","kind":"core","component":"Bullets","short":false,"cues":[{"id":"c15","start":94,"end":98.728,"marks":{},"text":"This makes dependency trees very handy for reading off meaning. Start at the top.","words":[{"w":"This","start":94},{"w":"makes","start":94.2},{"w":"dependency","start":94.48},{"w":"trees","start":95.2},{"w":"very","start":95.64},{"w":"handy","start":95.92},{"w":"for","start":96.24},{"w":"reading","start":96.4},{"w":"off","start":96.76},{"w":"meaning.","start":97.04},{"w":"Start","start":97.6},{"w":"at","start":98.08},{"w":"the","start":98.2},{"w":"top.","start":98.32}]},{"id":"c16","start":99.128,"end":101.239,"marks":{},"text":"The root tells you what happened: ate.","words":[{"w":"The","start":99.128},{"w":"root","start":99.208},{"w":"tells","start":99.528},{"w":"you","start":99.808},{"w":"what","start":99.968},{"w":"happened:","start":100.168},{"w":"ate.","start":100.704}]},{"id":"c17","start":101.639,"end":103.914,"marks":{},"text":"The subject tells you who did it: Priya.","words":[{"w":"The","start":101.639},{"w":"subject","start":101.759},{"w":"tells","start":102.279},{"w":"you","start":102.519},{"w":"who","start":102.719},{"w":"did","start":102.879},{"w":"it:","start":103.079},{"w":"Priya.","start":103.496}]},{"id":"c18","start":104.314,"end":107.079,"marks":{},"text":"The object tells you what it was done to: pizza.","words":[{"w":"The","start":104.314},{"w":"object","start":104.434},{"w":"tells","start":104.914},{"w":"you","start":105.154},{"w":"what","start":105.314},{"w":"it","start":105.474},{"w":"was","start":105.594},{"w":"done","start":105.754},{"w":"to:","start":106.034},{"w":"pizza.","start":106.394}]},{"id":"c19","start":107.479,"end":111.081,"marks":{},"text":"And modifiers add extra detail: the pizza was cold.","words":[{"w":"And","start":107.479},{"w":"modifiers","start":107.639},{"w":"add","start":108.359},{"w":"extra","start":108.639},{"w":"detail:","start":108.999},{"w":"the","start":109.599},{"w":"pizza","start":109.799},{"w":"was","start":110.319},{"w":"cold.","start":110.559}]}],"title":"Reading the tree","shortTitle":"Reading the tree","props":{"kicker":"Reading it","title":"Who did what to whom?","items":[{"text":"The root: what happened (ate)"},{"text":"The subject: who did it (Priya)"},{"text":"The object: what it was done to (pizza)"},{"text":"Modifiers: extra detail (cold)"}],"numbered":false},"start":94,"end":111.081,"startFrame":2820,"durationInFrames":540},{"id":"projective","kind":"core","component":"Definition","short":false,"cues":[{"id":"c20","start":112,"end":122.322,"marks":{},"text":"One more idea from your syllabus: projectivity. A dependency tree is projective if you can draw all its links as arcs above the sentence, without any of them crossing.","words":[{"w":"One","start":112},{"w":"more","start":112.28},{"w":"idea","start":112.56},{"w":"from","start":113.08},{"w":"your","start":113.24},{"w":"syllabus:","start":113.4},{"w":"projectivity.","start":114.16},{"w":"A","start":115.36},{"w":"dependency","start":115.64},{"w":"tree","start":116.44},{"w":"is","start":116.84},{"w":"projective","start":117.04},{"w":"if","start":117.68},{"w":"you","start":117.88},{"w":"can","start":118.04},{"w":"draw","start":118.24},{"w":"all","start":118.56},{"w":"its","start":118.72},{"w":"links","start":119},{"w":"as","start":119.28},{"w":"arcs","start":119.48},{"w":"above","start":119.8},{"w":"the","start":120.12},{"w":"sentence,","start":120.24},{"w":"without","start":120.84},{"w":"any","start":121.12},{"w":"of","start":121.36},{"w":"them","start":121.52},{"w":"crossing.","start":121.72}]},{"id":"c21","start":122.722,"end":135.125,"marks":{},"text":"Most English sentences are projective. Some sentences, and languages with freer word order, like Czech or Dutch, have links that cross. Those are called non-projective, and some parsers can't build them.","words":[{"w":"Most","start":122.722},{"w":"English","start":122.962},{"w":"sentences","start":123.402},{"w":"are","start":124.042},{"w":"projective.","start":124.242},{"w":"Some","start":125.122},{"w":"sentences,","start":125.522},{"w":"and","start":126.282},{"w":"languages","start":126.482},{"w":"with","start":127.082},{"w":"freer","start":127.282},{"w":"word","start":127.642},{"w":"order,","start":127.922},{"w":"like","start":128.362},{"w":"Czech","start":128.682},{"w":"or","start":129.002},{"w":"Dutch,","start":129.282},{"w":"have","start":129.802},{"w":"links","start":130.162},{"w":"that","start":130.522},{"w":"cross.","start":130.762},{"w":"Those","start":131.442},{"w":"are","start":131.802},{"w":"called","start":132.042},{"w":"non-projective,","start":132.642},{"w":"and","start":133.282},{"w":"some","start":133.482},{"w":"parsers","start":133.862},{"w":"can't","start":134.242},{"w":"build","start":134.562},{"w":"them.","start":134.882}]},{"id":"c22","start":135.525,"end":142.459,"marks":{},"text":"Picture beads on a necklace, with strings tied between some of them. If none of the strings cross, the tree is projective.","words":[{"w":"Picture","start":135.525},{"w":"beads","start":135.925},{"w":"on","start":136.325},{"w":"a","start":136.445},{"w":"necklace,","start":136.565},{"w":"with","start":137.125},{"w":"strings","start":137.365},{"w":"tied","start":137.885},{"w":"between","start":138.325},{"w":"some","start":138.685},{"w":"of","start":138.885},{"w":"them.","start":139.085},{"w":"If","start":139.405},{"w":"none","start":139.685},{"w":"of","start":139.925},{"w":"the","start":140.005},{"w":"strings","start":140.165},{"w":"cross,","start":140.565},{"w":"the","start":141.005},{"w":"tree","start":141.205},{"w":"is","start":141.525},{"w":"projective.","start":141.725}]}],"title":"Projectivity","shortTitle":"Projectivity","props":{"kicker":"Projectivity","term":"Projective tree","definition":"A dependency tree whose links can all be drawn above the sentence without any lines crossing.","example":"most English sentences: no crossings","analogy":"Strings tied between beads on a necklace: projective if none of the strings cross."},"start":112,"end":142.459,"startFrame":3360,"durationInFrames":941},{"id":"why","kind":"core","component":"Bullets","short":false,"cues":[{"id":"c23","start":143.367,"end":148.121,"marks":{},"text":"Dependency parsing has become the most widely used kind. Three reasons.","words":[{"w":"Dependency","start":143.367},{"w":"parsing","start":144.087},{"w":"has","start":144.607},{"w":"become","start":144.807},{"w":"the","start":145.167},{"w":"most","start":145.327},{"w":"widely","start":145.567},{"w":"used","start":146.047},{"w":"kind.","start":146.447},{"w":"Three","start":147.047},{"w":"reasons.","start":147.407}]},{"id":"c24","start":148.521,"end":152.641,"marks":{},"text":"It works well across many languages, including ones with free word order.","words":[{"w":"It","start":148.521},{"w":"works","start":148.681},{"w":"well","start":149.001},{"w":"across","start":149.201},{"w":"many","start":149.601},{"w":"languages,","start":149.881},{"w":"including","start":150.601},{"w":"ones","start":151.241},{"w":"with","start":151.521},{"w":"free","start":151.721},{"w":"word","start":152.001},{"w":"order.","start":152.241}]},{"id":"c25","start":153.041,"end":158.306,"marks":{},"text":"It directly shows relations, which are easy to turn into facts: Priya, ate, pizza.","words":[{"w":"It","start":153.041},{"w":"directly","start":153.201},{"w":"shows","start":153.681},{"w":"relations,","start":154.001},{"w":"which","start":154.681},{"w":"are","start":154.841},{"w":"easy","start":155.041},{"w":"to","start":155.361},{"w":"turn","start":155.561},{"w":"into","start":155.841},{"w":"facts:","start":156.081},{"w":"Priya,","start":156.614},{"w":"ate,","start":157.148},{"w":"pizza.","start":157.681}]},{"id":"c26","start":158.706,"end":164.145,"marks":{},"text":"And fast parsers can build the tree step by step, one move at a time. That's next lesson.","words":[{"w":"And","start":158.706},{"w":"fast","start":158.866},{"w":"parsers","start":159.266},{"w":"can","start":159.706},{"w":"build","start":159.906},{"w":"the","start":160.146},{"w":"tree","start":160.266},{"w":"step","start":160.506},{"w":"by","start":160.826},{"w":"step,","start":160.986},{"w":"one","start":161.426},{"w":"move","start":161.706},{"w":"at","start":162.026},{"w":"a","start":162.186},{"w":"time.","start":162.386},{"w":"That's","start":162.866},{"w":"next","start":163.292},{"w":"lesson.","start":163.719}]}],"title":"Why dependency parsing?","shortTitle":"Why dependency parsing?","props":{"kicker":"Why it's popular","title":"Why dependency parsing is so widely used","items":[{"text":"Works across many languages"},{"text":"Shows relations you can turn into facts"},{"text":"Fast parsers can build it step by step"}],"numbered":false},"start":143.367,"end":164.145,"startFrame":4301,"durationInFrames":651},{"id":"quiz","kind":"quiz","component":"Quiz","short":true,"cues":[{"id":"c27","start":165.067,"end":169.503,"marks":{},"text":"Quick quiz. In \"Priya ate cold pizza\", which word does \"cold\" depend on?","words":[{"w":"Quick","start":165.32},{"w":"quiz.","start":165.574},{"w":"In","start":165.827},{"w":"\"Priya","start":166.08},{"w":"ate","start":166.334},{"w":"cold","start":166.587},{"w":"pizza\",","start":167.027},{"w":"which","start":167.467},{"w":"word","start":167.787},{"w":"does","start":168.027},{"w":"\"cold\"","start":168.347},{"w":"depend","start":168.787},{"w":"on?","start":169.227}]},{"id":"c28","start":169.903,"end":171.423,"marks":{},"text":"Pause the video and choose.","words":[{"w":"Pause","start":169.903},{"w":"the","start":170.183},{"w":"video","start":170.443},{"w":"and","start":170.703},{"w":"choose.","start":170.903}]},{"id":"c29","start":174.823,"end":178.84,"marks":{},"text":"It's pizza. Cold describes the pizza, so pizza is its head.","words":[{"w":"It's","start":174.823},{"w":"pizza.","start":175.063},{"w":"Cold","start":175.743},{"w":"describes","start":176.183},{"w":"the","start":176.743},{"w":"pizza,","start":176.863},{"w":"so","start":177.383},{"w":"pizza","start":177.743},{"w":"is","start":178.103},{"w":"its","start":178.263},{"w":"head.","start":178.543}]}],"title":"Quick quiz","shortTitle":"Quick quiz: what does “cold” hang on?","props":{"kicker":"Pause and predict","question":"In “Priya ate cold pizza”, which word does “cold” depend on?","options":["Priya","ate","pizza"],"answer":2,"explain":"“Cold” describes the pizza, so its head is “pizza”."},"start":165.067,"end":178.84,"startFrame":4952,"durationInFrames":441},{"id":"recap","kind":"recap","component":"Recap","short":false,"cues":[{"id":"c30","start":179.767,"end":184.293,"marks":{},"text":"Let's recap. In a dependency tree, every word hangs off one head word.","words":[{"w":"Let's","start":179.767},{"w":"recap.","start":180.127},{"w":"In","start":180.727},{"w":"a","start":180.967},{"w":"dependency","start":181.127},{"w":"tree,","start":181.847},{"w":"every","start":182.287},{"w":"word","start":182.567},{"w":"hangs","start":182.887},{"w":"off","start":183.247},{"w":"one","start":183.527},{"w":"head","start":183.782},{"w":"word.","start":184.038}]},{"id":"c31","start":184.693,"end":187.37,"marks":{},"text":"The main verb is usually the root at the top.","words":[{"w":"The","start":184.693},{"w":"main","start":184.986},{"w":"verb","start":185.28},{"w":"is","start":185.573},{"w":"usually","start":185.813},{"w":"the","start":186.213},{"w":"root","start":186.373},{"w":"at","start":186.693},{"w":"the","start":186.853},{"w":"top.","start":186.973}]},{"id":"c32","start":187.77,"end":192.571,"marks":{},"text":"Each link has a label, like subject or object, saying how the words relate.","words":[{"w":"Each","start":187.77},{"w":"link","start":188.01},{"w":"has","start":188.37},{"w":"a","start":188.49},{"w":"label,","start":188.65},{"w":"like","start":189.13},{"w":"subject","start":189.37},{"w":"or","start":189.97},{"w":"object,","start":190.21},{"w":"saying","start":190.89},{"w":"how","start":191.29},{"w":"the","start":191.49},{"w":"words","start":191.69},{"w":"relate.","start":192.05}]},{"id":"c33","start":192.971,"end":196.762,"marks":{},"text":"And a tree is projective if its links can be drawn without crossing.","words":[{"w":"And","start":192.971},{"w":"a","start":193.131},{"w":"tree","start":193.251},{"w":"is","start":193.571},{"w":"projective","start":193.771},{"w":"if","start":194.491},{"w":"its","start":194.651},{"w":"links","start":194.931},{"w":"can","start":195.291},{"w":"be","start":195.451},{"w":"drawn","start":195.571},{"w":"without","start":195.931},{"w":"crossing.","start":196.171}]},{"id":"c34","start":197.162,"end":202.378,"marks":{},"text":"Next lesson: Transition Parsing. How can a parser build a tree one move at a time?","words":[{"w":"Next","start":197.482},{"w":"lesson:","start":197.802},{"w":"Transition","start":198.122},{"w":"Parsing.","start":198.962},{"w":"How","start":199.682},{"w":"can","start":199.882},{"w":"a","start":200.082},{"w":"parser","start":200.202},{"w":"build","start":200.602},{"w":"a","start":200.842},{"w":"tree","start":200.962},{"w":"one","start":201.202},{"w":"move","start":201.442},{"w":"at","start":201.722},{"w":"a","start":201.882},{"w":"time?","start":202.042}]}],"title":"Recap and next lesson","shortTitle":"Recap and next lesson","props":{"title":"Recap","points":["Every word hangs off one head word","The main verb is the root","Labels say how words relate: subject, object…","Projective: links drawn without crossing"],"next":{"title":"Transition Parsing","question":"How can a parser build a tree one move at a time?"}},"start":179.767,"end":202.378,"startFrame":5393,"durationInFrames":723}],"refs":{"c01":0.6,"c02":7.295,"c03":15,"c04":24.567,"c05":31.48,"c06":37.55,"c07":44.567,"c08":55.253,"c09":59.573,"c10":63.382,"c11":67.095,"c12":72,"c13":74.764,"c14":83.741,"c15":94,"c16":99.128,"c17":101.639,"c18":104.314,"c19":107.479,"c20":112,"c21":122.722,"c22":135.525,"c23":143.367,"c24":148.521,"c25":153.041,"c26":158.706,"c27":165.067,"c28":169.903,"c29":174.823,"c30":179.767,"c31":184.693,"c32":187.77,"c33":192.971,"c34":197.162},"audio":[{"file":".cache/proc/8563b648b8f6d420.wav","start":0.6},{"file":".cache/proc/c8253e3f118b66d5.wav","start":7.295},{"file":".cache/proc/2d5a4668ac47a09c.wav","start":15},{"file":".cache/proc/6cd1fd901e94acc0.wav","start":24.567},{"file":".cache/proc/6ceb928dea003431.wav","start":31.48},{"file":".cache/proc/99aaa2c1a411e4dc.wav","start":37.55},{"file":".cache/proc/50acf0eb85f8103b.wav","start":44.567},{"file":".cache/proc/c0ae8ede7fa5fa8d.wav","start":55.253},{"file":".cache/proc/0f061f360320888e.wav","start":59.573},{"file":".cache/proc/dbe6ab900a25e815.wav","start":63.382},{"file":".cache/proc/2ad389b62e43a923.wav","start":67.095},{"file":".cache/proc/58cc32c64019ddd2.wav","start":72},{"file":".cache/proc/6333710e9e425996.wav","start":74.764},{"file":".cache/proc/a213cafa14726e5d.wav","start":83.741},{"file":".cache/proc/65fcc68f0c8e8a54.wav","start":94},{"file":".cache/proc/2b92abaec4d00b64.wav","start":99.128},{"file":".cache/proc/d66000e8d5dd5ad5.wav","start":101.639},{"file":".cache/proc/ef6e03f6a755fcb7.wav","start":104.314},{"file":".cache/pro